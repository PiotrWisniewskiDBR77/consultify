/**
 * useProactiveNudges Hook
 *
 * Manages proactive AI nudges - fetching, displaying, and tracking user interactions.
 */

import { useCallback, useEffect, useRef, useState } from 'react';

import api from '../services/api';

export interface Nudge {
    id: string;
    nudgeId: string;
    userId: string;
    message: string;
    capability: string;
    priority: number;
    metadata?: Record<string, any>;
    createdAt: number;
    expiresAt: number;
}

interface UseProactiveNudgesOptions {
    enabled?: boolean;
    pollingInterval?: number;
    maxNudges?: number;
}

interface UseProactiveNudgesReturn {
    currentNudge: Nudge | null;
    pendingCount: number;
    loading: boolean;
    error: string | null;
    dismissNudge: (nudgeId: string) => Promise<void>;
    actOnNudge: (nudgeId: string, action: string) => Promise<void>;
    trackActivity: (activityType: string, metadata?: Record<string, any>) => Promise<void>;
    clearNudge: () => void;
}

export function useProactiveNudges(options: UseProactiveNudgesOptions = {}): UseProactiveNudgesReturn {
    const { enabled = true, pollingInterval = 30000, maxNudges = 1 } = options;

    const [nudges, setNudges] = useState<Nudge[]>([]);
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState<string | null>(null);
    const pollingRef = useRef<NodeJS.Timeout | null>(null);
    const lastActivityRef = useRef<number>(Date.now());

    const fetchPendingNudges = useCallback(async () => {
        if (!enabled) return;

        try {
            setLoading(true);
            const response = await api.get('/ai/nudges/pending');

            if (response.data.success && response.data.data) {
                const validNudges = response.data.data.filter((n: Nudge) => n.expiresAt > Date.now());
                setNudges(validNudges.slice(0, maxNudges));
            }
        } catch (err: any) {
            // Silently fail - nudges are non-critical
            console.debug('[Nudges] Fetch failed:', err.message);
        } finally {
            setLoading(false);
        }
    }, [enabled, maxNudges]);

    const dismissNudge = useCallback(async (nudgeId: string) => {
        try {
            await api.post('/ai/nudges/dismiss', { nudgeId });
            setNudges((prev) => prev.filter((n) => n.nudgeId !== nudgeId));
        } catch (err: any) {
            console.debug('[Nudges] Dismiss failed:', err.message);
        }
    }, []);

    const actOnNudge = useCallback(async (nudgeId: string, action: string) => {
        try {
            await api.post('/ai/nudges/acted', { nudgeId, action });
            setNudges((prev) => prev.filter((n) => n.nudgeId !== nudgeId));
        } catch (err: any) {
            console.debug('[Nudges] Act failed:', err.message);
        }
    }, []);

    const trackActivity = useCallback(
        async (activityType: string, metadata?: Record<string, any>) => {
            lastActivityRef.current = Date.now();

            try {
                const response = await api.post('/ai/nudges/track', {
                    activityType,
                    metadata,
                });

                // If tracking returns new nudges, add them
                if (response.data.nudges && response.data.nudges.length > 0) {
                    setNudges((prev) => {
                        const newNudges = [...prev, ...response.data.nudges];
                        return newNudges.sort((a, b) => b.priority - a.priority).slice(0, maxNudges);
                    });
                }
            } catch (err: any) {
                // Silently fail
                console.debug('[Nudges] Track failed:', err.message);
            }
        },
        [maxNudges],
    );

    const clearNudge = useCallback(() => {
        setNudges((prev) => prev.slice(1));
    }, []);

    // Start polling
    useEffect(() => {
        if (!enabled) return;

        // Initial fetch
        fetchPendingNudges();

        // Set up polling
        pollingRef.current = setInterval(() => {
            // Only fetch if user has been active recently (within 5 minutes)
            if (Date.now() - lastActivityRef.current < 5 * 60 * 1000) {
                fetchPendingNudges();
            }
        }, pollingInterval);

        return () => {
            if (pollingRef.current) {
                clearInterval(pollingRef.current);
            }
        };
    }, [enabled, pollingInterval, fetchPendingNudges]);

    // Track user activity on window events
    useEffect(() => {
        const handleActivity = () => {
            lastActivityRef.current = Date.now();
        };

        window.addEventListener('mousemove', handleActivity);
        window.addEventListener('keydown', handleActivity);
        window.addEventListener('click', handleActivity);

        return () => {
            window.removeEventListener('mousemove', handleActivity);
            window.removeEventListener('keydown', handleActivity);
            window.removeEventListener('click', handleActivity);
        };
    }, []);

    return {
        currentNudge: nudges[0] || null,
        pendingCount: nudges.length,
        loading,
        error,
        dismissNudge,
        actOnNudge,
        trackActivity,
        clearNudge,
    };
}

export default useProactiveNudges;




