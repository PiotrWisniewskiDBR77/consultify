# ===========================================
# CONSULTIFY PRODUCTION ENVIRONMENT TEMPLATE
# ===========================================
# Copy this file to .env.production and fill in real values
# NEVER commit .env.production to version control!

# Server Configuration
NODE_ENV=production
PORT=3005
FRONTEND_URL=https://your-domain.com
VITE_API_URL=https://api.your-domain.com/api

# Deck collaboration (P3.3): per-user invites + live presence WS on the
# Collaborate tab. Fail-open to solo if the WS gateway / collaborators table
# is unavailable. Vite inlines this at BUILD time — it MUST be set as a
# Railway BUILD-time environment variable on the frontend service (not just
# runtime/deploy vars, and not just in this file, which is never read at
# Docker build time — see Dockerfile.frontend `RUN npm run build`).
VITE_ENABLE_DECK_COLLABORATE=true

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# AI Provider
GEMINI_API_KEY=your_production_gemini_api_key

# Stripe (Configure when ready)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# OAUTH CONFIGURATION
# ===========================================
# Google OAuth (https://console.cloud.google.com/)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# Asana OAuth (https://app.asana.com/0/my-apps)
# ASANA_CLIENT_ID=your_asana_client_id
# ASANA_CLIENT_SECRET=your_asana_client_secret

# LinkedIn OAuth (https://www.linkedin.com/developers/)
# LINKEDIN_CLIENT_ID=your_linkedin_client_id
# LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# LINKEDIN_CALLBACK_URL=https://your-domain.com/api/auth/linkedin/callback

# Slack OAuth (https://api.slack.com/apps)
# SLACK_CLIENT_ID=your_slack_client_id
# SLACK_CLIENT_SECRET=your_slack_client_secret

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Option 1: SQLite (default, no configuration needed)
# The database file will be at server/consultify.db

# Option 2: PostgreSQL (recommended for production)
# Uncomment and set DATABASE_URL to switch to PostgreSQL
# DATABASE_URL=postgres://user:password@host:5432/consultify

# PostgreSQL Pool Settings (optional)
# DB_POOL_SIZE=10
# DB_DEBUG=false

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# ===========================================
# AI SYSTEM CONFIGURATION
# ===========================================

# Database Type (sqlite or postgres)
DB_TYPE=postgres

# PostgreSQL with pgvector (for production)
# Always use the external production Postgres connection string here.
DATABASE_URL=postgres://USER:PASSWORD@external-db-host:5432/consultify
# Optional for local maintenance from a laptop outside Railway
DATABASE_PUBLIC_URL=postgres://USER:PASSWORD@public-external-db-host:5432/consultify

# Production demo tenant for the Atelier Toys showcase.
# Non-default branded demo orgs require explicit approval flags.
# DEMO_ORG_ID=atelier
# DEMO_ORG_NAME=Atelier Toys
# ALLOW_NONDEFAULT_DEMO_ORG=1
# ALLOW_BRANDED_DEMO_ORG=1
# ALLOW_ATELIER_AS_DEMO_ORG=1

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379

# LLM Providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-your-anthropic-key
# DEEPSEEK_API_KEY=your-deepseek-key
# OLLAMA_ENDPOINT=http://localhost:11434

# Observability - Langfuse (https://langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-your-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Alerting - Slack Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
AI_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Alerting - WhatsApp (Twilio)
WHATSAPP_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_TOKEN=your-twilio-token
WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+48123456789

# AI Budget Controls
AI_BUDGET_MONTHLY_USD=1000
AI_BUDGET_ALERT_THRESHOLD=0.8

# ===========================================
# Organization Context Engine
# Source of truth: consultify/docs/product/ORGANIZATION_CONTEXT_ENGINE_SOURCE_OF_TRUTH.md
# ===========================================

# Worker scheduler: required for production. Enables in-process cron tick (every 30s).
# Off by default to keep deploys explicit. Set to true after validating worker capacity.
ORG_CONTEXT_WORKER_SCHEDULER_ENABLED=true
ORG_CONTEXT_WORKER_LIMIT=10

# Partner self-connect: keep CLOSED on production until the partner onboarding
# process (tiers + approval) is defined. != 'true' blocks new-partner org creation
# (403 PARTNER_SELF_CONNECT_DISABLED). See Harvard/DECYZJE_BRIEFY.md #4.
PARTNER_SELF_CONNECT_ENABLED=false

# Upload processing mode. After Stage 7 readiness, switch to async_worker.
# Cutover requires all three flags below set to async/true.
ORG_CONTEXT_UPLOAD_PROCESSING_MODE=inline
ORG_CONTEXT_UPLOAD_ASYNC_CUTOVER_ENABLED=false

# Queue backend. db_ledger is fine until throughput requires external broker.
# external requires deployment of broker service (Redis/SQS/RabbitMQ HTTP adapter).
ORG_CONTEXT_QUEUE_BACKEND=db_ledger

# External queue (only when ORG_CONTEXT_QUEUE_BACKEND=external).
ORG_CONTEXT_EXTERNAL_QUEUE_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_PULL_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_ACK_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_BACKOFF_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_NAME=organization-context
ORG_CONTEXT_EXTERNAL_QUEUE_TOKEN=

# External worker deployment verification (Release Gate marker).
ORG_CONTEXT_EXTERNAL_WORKER_HEALTH_URL=
ORG_CONTEXT_EXTERNAL_WORKER_DEPLOYMENT_VERIFIED=false
ORG_CONTEXT_EXTERNAL_WORKER_HEALTH_PROBE_ENABLED=false

# Image OCR provider. tesseract = OSS in-process, openai_vision = paid API.
# Default: disabled = images marked unreadable with honest UI hint.
ORG_CONTEXT_IMAGE_OCR_PROVIDER=disabled
ORG_CONTEXT_IMAGE_OCR_LANGUAGES=eng+pol

# Audio transcription provider. openai_whisper requires OPENAI_API_KEY.
ORG_CONTEXT_AUDIO_TRANSCRIPTION_PROVIDER=disabled
ORG_CONTEXT_AUDIO_MINUTES_PER_ORG_PER_MONTH=0

# Retention TTL: 0 = no TTL. When > 0, nightly purge soft-deletes documents older than TTL,
# hard-deletes after grace period. Lineage events preserved with source_deleted flag.
ORG_CONTEXT_RETENTION_TTL_DAYS=0
ORG_CONTEXT_RETENTION_HARD_DELETE_GRACE_DAYS=14
# Results VNext canonical cutover (RES-001). Default is ON; set one value to
# false only for an explicit per-domain rollback and rebuild.
VITE_RESULTS_VNEXT_KPI_ENABLED=true
VITE_RESULTS_VNEXT_ROI_ENABLED=true
VITE_RESULTS_VNEXT_OKR_ENABLED=true
