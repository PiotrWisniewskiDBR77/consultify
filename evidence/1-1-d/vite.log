1167|   * KOLOR = c-focus (niebieski), NIE akcent (decyzja Piotra 2026-07-04: focus
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1168|   * nigdy crimson). To rysowało czerwoną obwódkę na composerze/edytorze u kont
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1169|   * z włączonym focus-highlight w ustawieniach dostępności. */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1170|  html.focus-highlight :focus-visible {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1171|    outline: 2px solid var(--c-focus-solid, #2563eb);
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1172|    outline-offset: 2px;
   |  ^^^^^^^^^^^^^^^^^^^^^^
1173|  }
   |  ^
1174|  /* Edytory tekstu (composer, canvas/TipTap): obwódka fokusa wyłączona w całości
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1175|   * (polecenie Piotra: „ramka do pisania jest zupełnie niepotrzebna"). */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1176|  html.focus-highlight textarea:focus-visible,
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1177|  html.focus-highlight [contenteditable='true']:focus-visible,
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1178|  html.focus-highlight .ProseMirror:focus-visible {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1179|    outline: none;
   |  ^^^^^^^^^^^^^^^^
1180|  }
   |  ^
1181|  
   |  ^
1182|  /* Piotr's frozen editor decision: typing canvases/composers do not receive the
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1183|   * outer frame.  This remains narrower than the keyboard baseline above: normal
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1184|   * inputs, buttons, selects and focusable application controls stay visible. */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1185|  :root textarea:focus-visible,
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1186|  :root [contenteditable='true']:focus-visible,
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1187|  :root .ProseMirror:focus-visible {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1188|    outline: none !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^
1189|  }
   |  ^
1190|  html.focus-style-high-contrast :focus-visible {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1191|    outline: 3px solid #000000 !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1192|    outline-offset: 2px;
   |  ^^^^^^^^^^^^^^^^^^^^^^
1193|    box-shadow: 0 0 0 5px #ffffff !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1194|  }
   |  ^
1195|  html.dark.focus-style-high-contrast :focus-visible {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1196|    outline: 3px solid #ffffff !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1197|    box-shadow: 0 0 0 5px #000000 !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1198|  }
   |  ^
1199|  html.focus-style-animated :focus-visible {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1200|    outline: 2px solid var(--c-focus-solid, #2563eb);
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1201|    outline-offset: 2px;
   |  ^^^^^^^^^^^^^^^^^^^^^^
1202|    animation: focus-pulse 1.2s ease-in-out infinite;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1203|  }
   |  ^
1204|  @keyframes focus-pulse {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^
1205|    0%,
   |  ^^^^^
1206|    100% {
   |  ^^^^^^^^
1207|      outline-offset: 2px;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^
1208|    }
   |  ^^^
1209|    50% {
   |  ^^^^^^^
1210|      outline-offset: 5px;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^
1211|    }
   |  ^^^
1212|  }
   |  ^
1213|  /* reduce-motion wins over animated focus */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1214|  html.reduce-motion.focus-style-animated :focus-visible {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1215|    animation: none;
   |  ^^^^^^^^^^^^^^^^^^
1216|  }
   |  ^
1217|  
   |  ^
1218|  /* ============================================================================
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1219|   * Chat streaming frame — ARTIFACT_ANATOMY_STANDARD §16 SPEC-K.
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1220|   * "Ramka akcentu wokół CAŁEGO czatu (nie pola) — puls c.accent 1.5s"
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1221|   * (Piotr: the accent frame must wrap the whole conversation, not the input).
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1222|   * Applied to the message stream container while an AI turn is streaming.
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1223|   * ==========================================================================*/
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1224|  .chat-streaming-frame {
   |  ^^^^^^^^^^^^^^^^^^^^^^^
1225|    position: relative;
   |  ^^^^^^^^^^^^^^^^^^^^^
1226|  }
   |  ^
1227|  .chat-streaming-frame::after {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1228|    content: '';
   |  ^^^^^^^^^^^^^^
1229|    position: absolute;
   |  ^^^^^^^^^^^^^^^^^^^^^
1230|    inset: 0;
   |  ^^^^^^^^^^^
1231|    pointer-events: none;
   |  ^^^^^^^^^^^^^^^^^^^^^^^
1232|    border-radius: 0.75rem;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^
1233|    border: 1.5px solid var(--c-accent, #85182f);
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1234|    box-shadow: 0 0 0 1px var(--c-accent-soft, rgba(133, 24, 47, 0.14));
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1235|    animation: chat-stream-pulse 1.5s ease-in-out infinite;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1236|    z-index: 5;
   |  ^^^^^^^^^^^^^
1237|  }
   |  ^
1238|  @keyframes chat-stream-pulse {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1239|    0%,
   |  ^^^^^
1240|    100% {
   |  ^^^^^^^^
1241|      opacity: 0.35;
   |  ^^^^^^^^^^^^^^^^^^
1242|    }
   |  ^^^
1243|    50% {
   |  ^^^^^^^
1244|      opacity: 0.9;
   |  ^^^^^^^^^^^^^^^^^
1245|    }
   |  ^^^
1246|  }
   |  ^
1247|  
   |  ^
1248|  /* CHAT-OWN-012 — restrained idle affordance around the Teresa composer.
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1249|     It is mounted only while the input is empty, enabled, unfocused and neither
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1250|     sending nor recording, so it never impersonates an operation state.
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1251|  
   |  ^
1252|     NAPRAWA 2026-08-30 (defekt zmierzony na zrzutach 01-czat-kanwy): orbita NIE
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1253|     MOŻE być robiona przez `transform: rotate()` na ::before. Pseudo-element to
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1254|     prostokąt (zmierzone 343x125), a maska `xor` maluje ring PO JEGO KRAWĘDZI.
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1255|     Obrót kręci więc całym prostokątem — ring ODKLEJA się od ramki composera
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1256|     i tnie cienką crimsonową kreską przez placeholder i listę wiadomości
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1257|     (przy 90° kreska biegła 110 px WEWNĄTRZ pola, pionowo przez tekst).
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1258|     Poprawnie: pseudo-element stoi nieruchomo, animujemy SAM kąt startowy
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1259|     gradientu — ring zawsze pokrywa się z ramką, a akcent po niej wędruje. */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1260|  @property --chat-orbit-angle {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1261|    syntax: '<angle>';
   |  ^^^^^^^^^^^^^^^^^^^^
1262|    inherits: false;
   |  ^^^^^^^^^^^^^^^^^^
1263|    initial-value: 0deg;
   |  ^^^^^^^^^^^^^^^^^^^^^^
1264|  }
   |  ^
1265|  .chat-composer-idle-pulse::before {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1266|    position: absolute;
   |  ^^^^^^^^^^^^^^^^^^^^^
1267|    inset: -1px;
   |  ^^^^^^^^^^^^^^
1268|    z-index: 1;
   |  ^^^^^^^^^^^^^
1269|    border-radius: inherit;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^
1270|    padding: 1px;
   |  ^^^^^^^^^^^^^^^
1271|    pointer-events: none;
   |  ^^^^^^^^^^^^^^^^^^^^^^^
1272|    content: '';
   |  ^^^^^^^^^^^^^^
1273|    background: conic-gradient(
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1274|      from var(--chat-orbit-angle),
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1275|      transparent 0deg 260deg,
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1276|      rgb(133 24 47 / 0.08) 285deg,
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1277|      rgb(133 24 47 / 0.55) 330deg,
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1278|      transparent 360deg
   |  ^^^^^^^^^^^^^^^^^^^^^^
1279|    );
   |  ^^^^
1280|    -webkit-mask:
   |  ^^^^^^^^^^^^^^^
1281|      linear-gradient(#fff 0 0) content-box,
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1282|      linear-gradient(#fff 0 0);
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1283|    -webkit-mask-composite: xor;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1284|    mask-composite: exclude;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^
1285|    animation: chat-composer-idle-orbit 12s linear infinite;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1286|  }
   |  ^
1287|  
   |  ^
1288|  @keyframes chat-composer-idle-orbit {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1289|    to {
   |  ^^^^^^
1290|      --chat-orbit-angle: 360deg;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1291|    }
   |  ^^^
1292|  }
   |  ^
1293|  
   |  ^
1294|  @media (prefers-reduced-motion: reduce) {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1295|    .chat-composer-idle-pulse::before {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1296|      animation: none;
   |  ^^^^^^^^^^^^^^^^^^^^
1297|      opacity: 0.18;
   |  ^^^^^^^^^^^^^^^^^^
1298|    }
   |  ^^^
1299|  }
   |  ^
1300|  html.reduce-motion .chat-composer-idle-pulse::before {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1301|    animation: none;
   |  ^^^^^^^^^^^^^^^^^^
1302|    opacity: 0.18;
   |  ^^^^^^^^^^^^^^^^
1303|  }
   |  ^
1304|  /* reduce-motion: keep a static accent frame, drop the pulse */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1305|  html.reduce-motion .chat-streaming-frame::after {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1306|    animation: none;
   |  ^^^^^^^^^^^^^^^^^^
1307|    opacity: 0.6;
   |  ^^^^^^^^^^^^^^^
1308|  }
   |  ^
1309|  
