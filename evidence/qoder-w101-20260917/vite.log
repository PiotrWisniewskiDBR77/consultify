   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1329|    .chat-composer-idle-pulse::before {
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
1330|      animation: none;
   |  ^^^^^^^^^^^^^^^^^^^^
1331|      opacity: 0.18;
   |  ^^^^^^^^^^^^^^^^^^
1332|    }
   |  ^^^
1333|  }
   |  ^
1334|  html.reduce-motion .chat-composer-idle-pulse::before {
