   |  ^
756|    /* Reset backgrounds */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^
757|    body {
   |  ^^^^^^^^
758|      background: white !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
759|      color: black !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
760|      -webkit-print-color-adjust: exact;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
761|      print-color-adjust: exact;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
762|    }
   |  ^^^
