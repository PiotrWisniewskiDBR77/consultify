746|  /* ==========================================
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
747|   * PRINT STYLES — Public Report View
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
748|   * ========================================== */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
749|  
   |  ^
750|  @media print {
   |  ^^^^^^^^^^^^^^
751|    /* Hide non-printable elements */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
752|    .print\:hidden {
   |  ^^^^^^^^^^^^^^^^^^
753|      display: none !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
754|    }
   |  ^^^
755|  
   |  ^
756|    /* Reset backgrounds */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^
757|    body {
   |  ^^^^^^^^
758|      background: white !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
759|      color: black !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
760|      -webkit-print-color-adjust: exact;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
761|      print-color-adjust: exact;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
762|    }
   |  ^^^
763|  
   |  ^
764|    /* Force white backgrounds for cards */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
765|    .bg-white,
   |  ^^^^^^^^^^^^
766|    .dark\:bg-gray-800 {
   |  ^^^^^^^^^^^^^^^^^^^^^^
767|      background-color: white !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
768|    }
   |  ^^^
769|  
   |  ^
770|    /* Remove shadows for print */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
771|    .shadow-sm,
   |  ^^^^^^^^^^^^^
772|    .shadow-md,
   |  ^^^^^^^^^^^^^
773|    .shadow-lg,
   |  ^^^^^^^^^^^^^
774|    .shadow-xl,
   |  ^^^^^^^^^^^^^
775|    .shadow-2xl {
   |  ^^^^^^^^^^^^^^^
776|      box-shadow: none !important;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
777|    }
   |  ^^^
778|  
   |  ^
779|    /* Ensure section breaks */
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
780|    [id^='section-'] {
   |  ^^^^^^^^^^^^^^^^^^^^
781|      page-break-inside: avoid;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
782|      break-inside: avoid;
   |  ^^^^^^^^^^^^^^^^^^^^^^^^
783|    }
   |  ^^^
784|  
