{
    "entryPoints": [
        "src/index.ts",
        "server/src/index.ts"
    ],
    "out": "docs/api",
    "theme": "default",
    "name": "Consultify Platform API",
    "exclude": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "node_modules"
    ],
    "externalPattern": [
        "node_modules/**"
    ],
    "excludeExternals": true,
    "excludePrivate": true,
    "excludeProtected": true
}