/**
 * DemoModeBanner Component
 *
 * Displays a prominent banner when demo mode is active.
 * Shows demo organization info and provides quick exit action.
 * Can be minimized to a compact indicator.
 */
import React, { useState } from 'react';
import {
  X,
  Building2,
  FlaskConical,
  ChevronDown,
  ChevronUp,
  Eye,
  AlertTriangle,
  Lightbulb,
  HelpCircle,
  Mail,
  Handshake,
  Minimize2,
  Maximize2,
} from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';

import { useDemo } from '../../hooks/useDemo';
import { useAppStore } from '../../store/useAppStore';
import { AppView } from '../../types';

interface DemoModeBannerProps {
  className?: string;
}

// Consistent button style for all action buttons
const buttonBaseClass =
  'h-8 px-3 text-xs font-medium rounded-md transition-all duration-200 flex items-center justify-center gap-1.5 whitespace-nowrap';
const buttonPrimaryClass = `${buttonBaseClass} bg-white/20 hover:bg-white/30 border border-white/20`;
const buttonSecondaryClass = `${buttonBaseClass} bg-white/10 hover:bg-white/20 border border-white/10`;

export const DemoModeBanner: React.FC<DemoModeBannerProps> = ({ className = '' }) => {
  const { currentUser, setCurrentView, isDemoBannerMinimized, setDemoBannerMinimized } =
    useAppStore();
  const { isDemoMode, demoOrganization, demoStats, isDemoLoading, exitDemoMode } = useDemo();

  const [isExpanded, setIsExpanded] = useState(false);

  // Don't show demo banner for SuperAdmin - they have access to all orgs including demo
  const isSuperAdmin = currentUser?.role?.toUpperCase() === 'SUPERADMIN';

  if (!isDemoMode || isSuperAdmin) return null;

  const handleContactDBR77 = () => {
    window.open('mailto:kontakt@dbr77.com?subject=Zapytanie%20-%20Consultify%20Demo', '_blank');
  };

  const handlePartnerPortal = () => {
    setCurrentView(AppView.PARTNER_LANDING);
  };

  // Minimized state - just a small floating indicator
  if (isDemoBannerMinimized) {
    return (
      <motion.div
        initial={{ opacity: 0, scale: 0.8 }}
        animate={{ opacity: 1, scale: 1 }}
        className="fixed top-0 left-1/2 -translate-x-1/2 z-50"
      >
        <button
          onClick={() => setDemoBannerMinimized(false)}
          className="flex items-center gap-2 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white px-3 py-1.5 rounded-b-lg shadow-lg hover:shadow-xl transition-all"
          title="Rozwiń pasek demo"
        >
          <FlaskConical className="w-4 h-4" />
          <span className="text-xs font-semibold">DEMO</span>
          <Maximize2 className="w-3 h-3" />
        </button>
      </motion.div>
    );
  }

  return (
    <AnimatePresence>
      <motion.div
        initial={{ y: -100, opacity: 0 }}
        animate={{ y: 0, opacity: 1 }}
        exit={{ y: -100, opacity: 0 }}
        transition={{ type: 'spring', damping: 20, stiffness: 300 }}
        className={`bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white shadow-lg ${className}`}
      >
        {/* Main Banner Row */}
        <div className="px-4 py-2">
          <div className="max-w-7xl mx-auto flex items-center justify-between gap-4">
            {/* Left: Demo indicator & info */}
            <div className="flex items-center gap-3 min-w-0">
              <div className="flex items-center gap-2 bg-white/20 rounded-full px-3 py-1 shrink-0">
                <FlaskConical className="w-4 h-4" />
                <span className="text-sm font-semibold">TRYB DEMO</span>
              </div>

              <div className="hidden sm:flex items-center gap-2 min-w-0">
                <Building2 className="w-4 h-4 shrink-0" />
                <span className="font-medium truncate">
                  {demoOrganization?.name || 'Legolex Manufacturing'}
                </span>
              </div>

              {/* Stats badges */}
              {demoStats && (
                <div className="hidden lg:flex items-center gap-2 text-xs shrink-0">
                  <span className="bg-white/15 rounded px-2 py-0.5">
                    {demoStats.projects} projektów
                  </span>
                  <span className="bg-white/15 rounded px-2 py-0.5">
                    {demoStats.initiatives} inicjatyw
                  </span>
                </div>
              )}
            </div>

            {/* Right: Actions - all buttons same size */}
            <div className="flex items-center gap-2 shrink-0">
              {/* Hints toggle */}
              <button
                onClick={() => setIsExpanded(!isExpanded)}
                className={buttonSecondaryClass}
                title="Pokaż wskazówki"
              >
                <Lightbulb className="w-4 h-4" />
                <span className="hidden sm:inline">Wskazówki</span>
                {isExpanded ? (
                  <ChevronUp className="w-3 h-3" />
                ) : (
                  <ChevronDown className="w-3 h-3" />
                )}
              </button>

              {/* Minimize button */}
              <button
                onClick={() => setDemoBannerMinimized(true)}
                className={buttonSecondaryClass}
                title="Zwiń pasek"
              >
                <Minimize2 className="w-4 h-4" />
              </button>

              {/* Exit demo button */}
              <button
                onClick={exitDemoMode}
                disabled={isDemoLoading}
                className={`${buttonPrimaryClass} bg-red-500/30 hover:bg-red-500/50 border-red-400/30`}
                title="Zakończ tryb demo"
              >
                {isDemoLoading ? (
                  <div className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin" />
                ) : (
                  <X className="w-4 h-4" />
                )}
                <span className="hidden sm:inline">Zakończ demo</span>
              </button>
            </div>
          </div>
        </div>

        {/* Expanded hints section */}
        <AnimatePresence>
          {isExpanded && (
            <motion.div
              initial={{ height: 0, opacity: 0 }}
              animate={{ height: 'auto', opacity: 1 }}
              exit={{ height: 0, opacity: 0 }}
              transition={{ duration: 0.2 }}
              className="overflow-hidden"
            >
              <div className="px-4 py-4 bg-black/20 border-t border-white/10">
                <div className="max-w-7xl mx-auto">
                  {/* Info Cards Grid */}
                  <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
                    {/* Read-only warning */}
                    <div className="bg-white/10 backdrop-blur-sm rounded-lg p-3 border border-white/10">
                      <div className="flex items-center gap-2 mb-1">
                        <AlertTriangle className="w-4 h-4 text-amber-300" />
                        <span className="font-semibold text-amber-300 text-sm">Tryb podglądu</span>
                      </div>
                      <p className="text-white/70 text-xs leading-relaxed">
                        Wszystkie dane są przykładowe i służą celom demonstracyjnym.
                      </p>
                    </div>

                    {/* Explore features */}
                    <div className="bg-white/10 backdrop-blur-sm rounded-lg p-3 border border-white/10">
                      <div className="flex items-center gap-2 mb-1">
                        <Eye className="w-4 h-4 text-blue-300" />
                        <span className="font-semibold text-blue-300 text-sm">Eksploruj</span>
                      </div>
                      <p className="text-white/70 text-xs leading-relaxed">
                        Przeglądaj wszystkie moduły i funkcje systemu bez ograniczeń.
                      </p>
                    </div>

                    {/* Help encouragement */}
                    <div className="bg-white/10 backdrop-blur-sm rounded-lg p-3 border border-white/10">
                      <div className="flex items-center gap-2 mb-1">
                        <HelpCircle className="w-4 h-4 text-green-300" />
                        <span className="font-semibold text-green-300 text-sm">Potrzebujesz pomocy?</span>
                      </div>
                      <p className="text-white/70 text-xs leading-relaxed">
                        Kliknij przycisk <span className="text-green-300 font-medium">Help</span> po prawej stronie ekranu.
                      </p>
                    </div>

                    {/* Tips */}
                    <div className="bg-white/10 backdrop-blur-sm rounded-lg p-3 border border-white/10">
                      <div className="flex items-center gap-2 mb-1">
                        <Lightbulb className="w-4 h-4 text-purple-300" />
                        <span className="font-semibold text-purple-300 text-sm">Wskazówka</span>
                      </div>
                      <p className="text-white/70 text-xs leading-relaxed">
                        Rozpocznij od przeglądu inicjatyw i projektów w menu bocznym.
                      </p>
                    </div>
                  </div>

                  {/* Action buttons row */}
                  <div className="flex flex-wrap items-center justify-center gap-3 pt-2 border-t border-white/10">
                    <button
                      onClick={handleContactDBR77}
                      className="h-9 px-4 bg-white/20 hover:bg-white/30 rounded-lg text-sm font-medium flex items-center gap-2 transition-all border border-white/20"
                    >
                      <Mail className="w-4 h-4" />
                      <span>Skontaktuj się z DBR77</span>
                    </button>

                    <button
                      onClick={handlePartnerPortal}
                      className="h-9 px-4 bg-gradient-to-r from-amber-500/30 to-orange-500/30 hover:from-amber-500/50 hover:to-orange-500/50 rounded-lg text-sm font-medium flex items-center gap-2 transition-all border border-amber-400/30"
                    >
                      <Handshake className="w-4 h-4" />
                      <span>Zostań Partnerem</span>
                    </button>
                  </div>
                </div>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </motion.div>
    </AnimatePresence>
  );
};

export default DemoModeBanner;
