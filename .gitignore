# Export artifacts
server/exports/
# Generated operator reports/manifests. `server/exports/` alone was not enough:
# exportsDir() resolves 'server/exports' against process.cwd(), so running a
# script from inside server/ wrote to server/server/exports/ and slipped past
# the ignore. The path bug is fixed too; this line is the belt to that braces.
**/server/exports/
# FIN-005 operator holds. Without STORAGE_DIR these land in the CWD, and a
# leftover hold legitimately BLOCKS the next seed run (that is the point).
# They must never be committed, and never be mistaken for source.
fin005-operator-holds/
/exports/

# Local generated reports (one-off runtime/route reports)
/reports/

# Local backups
_backup/
/backups/
/data/
# USPOJNIENIE F3 (H6.6) — ignoruj tylko LUŹNE pliki bezpośrednio w tests/,
# ale ZAWSZE dopuszczaj podkatalogi z testami. Wcześniejszy allowlist
# (`/tests/*` + re-include tylko initiatives/uspojnienie) po cichu zjadał
# `git add` KAŻDEGO nowego testu w tests/unit/backend, tests/components,
# tests/integration, tests/hooks, tests/store, tests/security itd.
# — dokładnie te katalogi, które zbiera vitest.config.ts i uruchamia CI.
# Pliki już-śledzone i tak są nietykalne; ta zmiana odblokowuje NOWE testy
# bez `git add -f` (finding_tests_dir_gitignored_force_add).
# Śmieci (logi/raporty) łapią osobne reguły: unit_tests_report.txt, tests_*.log.
/tests/*
!/tests/*/
# dist/ already ignored above

