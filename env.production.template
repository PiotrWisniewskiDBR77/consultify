# Production Environment Variables Template
# Copy this file to .env.production and fill in your values
# NEVER commit .env.production to version control!

# ============================================
# CORE CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3005

# ============================================
# SECURITY
# ============================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# JWT expiration (optional, defaults to 7d)
JWT_EXPIRES_IN=7d

# ============================================
# DATABASE
# ============================================
# PostgreSQL (recommended for production)
# Format: postgres://user:password@host:port/database
# Railway/Render will provide this automatically
DATABASE_URL=postgres://user:password@host:5432/consultify

# OR SQLite (not recommended for production)
# SQLITE_PATH=/app/server/consultify.db

# Database connection pool size (optional)
DB_POOL_SIZE=10

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Your frontend URL (update after deployment)
FRONTEND_URL=https://your-app.up.railway.app

# ============================================
# AI SERVICES
# ============================================
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, if using OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# STRIPE BILLING (if using billing features)
# ============================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# OPTIONAL CONFIGURATION
# ============================================
# Token cleanup interval (milliseconds, default: 3600000 = 1 hour)
TOKEN_CLEANUP_INTERVAL=3600000

# Database debug mode (set to 'true' for verbose SQL logging)
DB_DEBUG=false
DB_LOG_QUERIES=false

# CORS - Railway/Render will handle this, but you can override
# CORS_ORIGIN=https://your-domain.com

# ============================================
# NOTES
# ============================================
# 1. On Railway/Render: DATABASE_URL is automatically provided
# 2. Generate JWT_SECRET using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Update FRONTEND_URL after getting your deployment URL
# 4. Never commit this file with real secrets!




