#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Commit message validation using commitlint
# Falls back to basic validation if commitlint is not installed

if command -v npx >/dev/null 2>&1 && npx --no -- commitlint --version >/dev/null 2>&1; then
    # Use commitlint if available
    npx --no -- commitlint --edit "$1"
else
    # Fallback to basic validation
    commit_msg=$(cat "$1")

    # Skip validation for merge commits and WIP commits
    if echo "$commit_msg" | grep -qE "^(Merge|Revert|WIP|wip)" ; then
        exit 0
    fi

    # Check for conventional commit format
    if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|chore|security|build|ci)(\(.+\))?: .{3,}" ; then
        echo "❌ Invalid commit message format!"
        echo ""
        echo "Commit message must follow conventional commit format:"
        echo "  type(scope): subject"
        echo ""
        echo "Types: feat, fix, docs, style, refactor, perf, test, chore, security, build, ci"
        echo ""
        echo "Examples:"
        echo "  feat(auth): add JWT token rotation"
        echo "  fix(security): prevent IDOR in user endpoints"
        echo "  docs: update API documentation"
        echo ""
        exit 1
    fi

    # Check minimum length
    if [ ${#commit_msg} -lt 10 ]; then
        echo "❌ Commit message too short (minimum 10 characters)"
        exit 1
    fi
fi

