#!/usr/bin/env sh
# Guardy włączone po regresjach wizualnych. Wąskie i szybkie.
# Ciężkie checki (lint/typecheck/tests) pozostają wyłączone jak prosiłeś.

# 1) Regresja 2026-07-12 (własne tabele zamiast StandardTable) — odpala się
#    tylko gdy commit dotyka komponentów .tsx poza src/components/standard/.
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '^src/components/.*\.tsx$' | grep -v '^src/components/standard/')
if [ -n "$STAGED" ]; then
  if ! bash scripts/check-list-canon.sh $STAGED; then
    echo "" >&2
    echo "  ⛔ Commit zablokowany: ekran listowy nie używa StandardTable (kanon TRIADA, reguła #1)." >&2
    echo "     To ta sama klasa błędu co 2026-07-12. Osadź <StandardTable> i commituj ponownie." >&2
    exit 1
  fi
fi

# 2) Crimson w powłoce artefaktów (SPEC-A, CLAUDE.md UI pkt 6) — ratchet na
#    stałym, małym zakresie plików (NModeLayout/ExecutiveModuleShell/
#    ArtifactRightPanel/IdeaMapWorkspace), więc odpala się zawsze i tanio.
if ! bash scripts/check-artefakt.sh; then
  echo "" >&2
  echo "  ⛔ Commit zablokowany: nowe użycie primary-*/c-accent (crimson) w powłoce artefaktu." >&2
  echo "     Powłoka SPEC-A ma być crimson-neutralna (CLAUDE.md UI pkt 6). Napraw albo oznacz" >&2
  echo "     świadomie jako /* crimson-ok */, i commituj ponownie." >&2
  exit 1
fi

# 3) Crimson w kanonie TRIADY list (docs/ui-standards/TRIADA_KANON.md część C) —
#    przeniesione z .claude/hooks/check-triada.sh (2026-07-19, było lokalne-tylko).
STAGED_TRIADA=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '^src/(components|views)/.*\.(ts|tsx)$')
if [ -n "$STAGED_TRIADA" ]; then
  if ! bash scripts/check-triada.sh $STAGED_TRIADA; then
    echo "" >&2
    echo "  ⛔ Commit zablokowany: nowe primary-*/c-accent (crimson) w ekranie listowym (kanon TRIADA)." >&2
    echo "     SSOT: docs/ui-standards/TRIADA_KANON.md część C. Napraw albo dopisz świadomy wyjątek" >&2
    echo "     do scripts/triada-allowlist.txt, i commituj ponownie." >&2
    exit 1
  fi
fi

# 4) Doktryna gęstości (docs/ui-standards/DOKTRYNA_GESTOSCI.md §3/§1) —
#    przeniesione z .claude/hooks/check-gestosc.sh (2026-07-19, było lokalne-tylko).
STAGED_ALL_TSX=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '\.(ts|tsx)$')
if [ -n "$STAGED_ALL_TSX" ]; then
  if ! bash scripts/check-gestosc.sh $STAGED_ALL_TSX; then
    echo "" >&2
    echo "  ⛔ Commit zablokowany: regresja mechaniczna doktryny gęstości (plik-duplikat / komponent" >&2
    echo "     bez callera / zdublowana akcja pasek+kebab). SSOT: docs/ui-standards/DOKTRYNA_GESTOSCI.md." >&2
    exit 1
  fi
fi

# 5) Klasa .sql.sql (backlog E-SQL-01) — migracje z podwójnym rozszerzeniem
#    nigdy się nie odpalają (patrz server/migrations/never-ran/README.md);
#    zero-tolerance na nowe pliki tej klasy poza never-ran/. Odpala się tylko
#    gdy commit dotyka server/migrations/.
STAGED_MIGRATIONS=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '^server/migrations/')
if [ -n "$STAGED_MIGRATIONS" ]; then
  if ! bash scripts/check-sqlsql.sh $STAGED_MIGRATIONS; then
    echo "" >&2
    echo "  ⛔ Commit zablokowany: nowy plik *.sql.sql w server/migrations/ (poza never-ran/)." >&2
    echo "     Ta klasa jest martwa z zasady (backlog E-SQL-01, DECYZJA CTO-4). Pojedyncze" >&2
    echo "     rozszerzenie .sql dla realnej migracji, albo never-ran/ dla świadomie martwej." >&2
    exit 1
  fi
fi

# 6) Martwe ścieżki SSOT w CLAUDE.md (klasa błędu J7: dokument przeniesiony/
#    usunięty, referencja w CLAUDE.md nie poprawiona) — odpala się tylko gdy
#    commit dotyka CLAUDE.md, więc tanio i zawsze aktualne.
STAGED_CLAUDEMD=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '^CLAUDE\.md$')
if [ -n "$STAGED_CLAUDEMD" ]; then
  if ! bash scripts/check-ssot-paths.sh; then
    echo "" >&2
    echo "  ⛔ Commit zablokowany: CLAUDE.md wskazuje na ścieżkę SSOT, która nie istnieje." >&2
    echo "     Popraw wskazanie (plik przeniesiony/usunięty) i commituj ponownie." >&2
    exit 1
  fi
fi

# 7) Rejestr akcji Idei (docs/standards/idea-workspace/02_REJESTR_AKCJI.md, Z3) —
#    akcja zadeklarowana bez odbiornika w hooku swojej reprezentacji = martwe
#    kliknięcie u klienta. Dokładnie ta klasa dała ~40 martwych pozycji na
#    reprezentację (naprawione 2026-07-23 punktowo; ten guard jest po to, żeby
#    nie wróciło). Odpala się gdy commit dotyka rejestru, hooka akcji, ALBO
#    (2026-08-10, E02 DoD R10) dowolnej powierzchni src/components/MyWork/ —
#    to jest dokładnie zakres, w którym R10 wykrywa akcjopodobne onClick/
#    onSelect spoza rejestru (scripts/check-action-coverage.sh).
STAGED_AKCJE=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '^src/actions/ideaActionRegistry\.ts$|use(MindMap|Whiteboard|ProcessFlow|Table)QuickActions\.ts$|^src/components/MyWork/.*\.tsx$')
if [ -n "$STAGED_AKCJE" ]; then
  if ! bash scripts/check-actions.sh; then
    echo "" >&2
    echo "  ⛔ Commit zablokowany: rejestr akcji narusza kontrakt Z3 (zero martwych kliknięć)." >&2
    echo "     Akcja bez odbiornika / bez handlera / bez cofnięcia przy mutacji nie ma prawa wejść." >&2
    echo "     SSOT: docs/standards/idea-workspace/02_REJESTR_AKCJI.md" >&2
    exit 1
  fi
fi

# 8) Fokus crimson (CLAUDE.md "Pułapka nr 1": `primary` w tailwind = crimson
#    #85182F, fokus MUSI iść przez `c-focus`; SSOT docs/ui-standards/TRIADA_KANON.md:167).
#    Dług mierzy scripts/check-focus-canon.sh, ratchet względem
#    docs/ui-standards/.focus-baseline.json — blokuje TYLKO wzrost długu
#    ponad baseline, nigdy stan zastany. Do 2026-08-02 skrypt istniał, ale
#    nie był wpięty NIGDZIE (panel adwersaryjny, finding K-23) — czysty
#    teatr zgodności. Odpala się tylko gdy commit dotyka .ts/.tsx w src/.
STAGED_FOCUS=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '^src/.*\.(ts|tsx)$')
if [ -n "$STAGED_FOCUS" ]; then
  if ! bash scripts/check-focus-canon.sh --ci; then
    echo "" >&2
    echo "  ⛔ Commit zablokowany: dlug fokusa crimson (ring-primary-*) wzrosl ponad baseline," >&2
    echo "     albo naruszenie siedzi w pliku nieśledzonym (git add go, gdy naprawisz)." >&2
    echo "     SSOT: CLAUDE.md UI pkt 1, docs/ui-standards/TRIADA_KANON.md:167. Zamien na" >&2
    echo "     ring-c-focus/outline-c-focus, albo swiadomie zaktualizuj baseline:" >&2
    echo "     bash scripts/check-focus-canon.sh --update-baseline" >&2
    exit 1
  fi
fi

exit 0
