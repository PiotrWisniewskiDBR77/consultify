#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-push validation..."

# Run linting
echo "📝 Checking code style..."
npm run lint || {
    echo "❌ Lint failed. Please fix errors before pushing."
    exit 1
}

# Run type checking
echo "🔷 Checking TypeScript types..."
npm run type-check || {
    echo "❌ Type check failed. Please fix type errors before pushing."
    exit 1
}

# Run unit tests (fast)
echo "🧪 Running unit tests..."
npm run test:unit || {
    echo "❌ Unit tests failed. Please fix tests before pushing."
    exit 1
}

echo "✅ Pre-push validation passed!"
echo "💡 Tip: Run 'npm run verify' for full validation including security tests"



