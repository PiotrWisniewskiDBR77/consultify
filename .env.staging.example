# Staging Environment Configuration
# Copy this file to .env.staging and fill in the values

NODE_ENV=staging

# Frontend URL (staging domain)
FRONTEND_URL=https://staging.consultify.app
VITE_API_URL=https://api.staging.consultify.app/api

# Database (separate staging database)
DATABASE_URL=postgresql://user:password@staging-db-host:5432/consultify_staging
# Optional for local development outside Railway
DATABASE_PUBLIC_URL=postgresql://user:password@public-staging-db-host:5432/consultify_staging

# Keep the branded Atelier Toys demo on staging too.
# Non-default branded demo orgs require explicit approval flags.
# DEMO_ORG_ID=atelier
# DEMO_ORG_NAME=Atelier Toys
# ALLOW_NONDEFAULT_DEMO_ORG=1
# ALLOW_BRANDED_DEMO_ORG=1
# ALLOW_ATELIER_AS_DEMO_ORG=1

# JWT Configuration (use different secret than production!)
JWT_SECRET=staging-jwt-secret-change-this
JWT_EXPIRES_IN=1h

# MFA Encryption (use different key than production!)
MFA_ENCRYPTION_KEY=staging-mfa-key-32-bytes-hex-here

# AI Provider Keys (can use same as production or separate)
GOOGLE_AI_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe (use TEST mode keys!)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email (can use same as production or a test service like Mailtrap)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@staging.consultify.app

# Redis (optional, for rate limiting and queues)
REDIS_URL=redis://localhost:6379

# Sentry (separate DSN for staging)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Feature Flags (staging-specific)
ENABLE_DEBUG_LOGGING=true
DISABLE_RATE_LIMIT=false
ENABLE_RATE_LIMIT=false
# Deck collaboration (P3.3): per-user invites + live presence WS. Fail-open to solo
# if the WS gateway / collaborators table is unavailable. Must be set as a BUILD env
# var on Railway (Vite inlines it at build time) — not just runtime.
VITE_ENABLE_DECK_COLLABORATE=true
# Partner self-connect. Staging may set true to exercise the onboarding flow;
# production stays false until the partner process is defined (DECYZJE_BRIEFY.md #4).
PARTNER_SELF_CONNECT_ENABLED=false

# AI QA mode: use mock providers for deterministic runtime acceptance tests.
# Set AI_PROVIDER_MODE=live for the small final Provider Gate.
QA_AI_MODE=true
AI_PROVIDER_MODE=mock

# Railway-specific (if deploying to Railway)
RAILWAY_ENVIRONMENT=staging

# ============================================================
# Organization Context Engine
# Source of truth: consultify/docs/product/ORGANIZATION_CONTEXT_ENGINE_SOURCE_OF_TRUTH.md
# ============================================================

# Worker scheduler: enables in-process cron tick (every 30s) for processing context documents.
# Default: false. Required for async upload cutover and external queue consumer.
ORG_CONTEXT_WORKER_SCHEDULER_ENABLED=false

# Worker limit per tick (1-25). Higher = more throughput, more memory.
ORG_CONTEXT_WORKER_LIMIT=5

# Upload processing mode: inline_worker_boundary_v1 (default, sync) or async_worker_enqueued_v1.
# Required cutover steps: ORG_CONTEXT_UPLOAD_PROCESSING_MODE=async_worker AND
# ORG_CONTEXT_UPLOAD_ASYNC_CUTOVER_ENABLED=true AND ORG_CONTEXT_WORKER_SCHEDULER_ENABLED=true.
ORG_CONTEXT_UPLOAD_PROCESSING_MODE=inline
ORG_CONTEXT_UPLOAD_ASYNC_CUTOVER_ENABLED=false

# Queue backend: db_ledger (default, in-DB queue) or external (HTTP broker).
ORG_CONTEXT_QUEUE_BACKEND=db_ledger

# External queue contract (only required when ORG_CONTEXT_QUEUE_BACKEND=external).
# All four endpoints + token must be deployed for broker_deployment_ready.
ORG_CONTEXT_EXTERNAL_QUEUE_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_PULL_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_ACK_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_BACKOFF_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_NAME=organization-context
ORG_CONTEXT_EXTERNAL_QUEUE_TOKEN=

# External worker deployment verification (Release Gate marker).
# Health probe is opt-in to avoid silent network calls.
ORG_CONTEXT_EXTERNAL_WORKER_HEALTH_URL=
ORG_CONTEXT_EXTERNAL_WORKER_DEPLOYMENT_VERIFIED=false
ORG_CONTEXT_EXTERNAL_WORKER_HEALTH_PROBE_ENABLED=false

# Image OCR pipeline (Stage 4). Set to "tesseract" to enable in-process OCR via tesseract.js.
# Set to "openai_vision" to use OpenAI vision (requires OPENAI_API_KEY).
# Default: disabled = images marked as unreadable with honest degraded UI.
ORG_CONTEXT_IMAGE_OCR_PROVIDER=disabled
ORG_CONTEXT_IMAGE_OCR_LANGUAGES=eng+pol

# Audio transcription pipeline (Stage 5). Set to "openai_whisper" to enable.
# Default: disabled = audio uploads rejected with policy_blocked.
ORG_CONTEXT_AUDIO_TRANSCRIPTION_PROVIDER=disabled

# Audio quota in minutes per organization per month. 0 = no quota enforced.
ORG_CONTEXT_AUDIO_MINUTES_PER_ORG_PER_MONTH=0

# Retention TTL in days. 0 = no TTL (documents kept indefinitely).
# When set, documents older than TTL are soft-deleted nightly, hard-deleted after grace period.
ORG_CONTEXT_RETENTION_TTL_DAYS=0
ORG_CONTEXT_RETENTION_HARD_DELETE_GRACE_DAYS=14
# Results VNext canonical cutover (RES-001).
VITE_RESULTS_VNEXT_KPI_ENABLED=true
VITE_RESULTS_VNEXT_ROI_ENABLED=true
VITE_RESULTS_VNEXT_OKR_ENABLED=true
