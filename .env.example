# Consultify Environment Variables (Example)
# Copy to `.env.local` for local app runtime against the external database.
#
# IMPORTANT:
# - Do NOT commit real secrets (API keys, DATABASE_URL with passwords).
# - `.env`, `.env.local` are gitignored in this repo.

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ======================
# Database configuration (PostgreSQL only)
# ======================

DB_TYPE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# External DB only:
# DATABASE_URL=postgresql://USER:PASSWORD@external-db-host:5432/DATABASE

# If needed for Railway proxy TLS:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# WP-A04 production database guard (server/src/config/databaseTargetResolver.ts):
# The server refuses to start (fail-closed) if DATABASE_URL/DB_HOST resolves to the
# known production Postgres host and this process cannot prove (via Railway's own
# RAILWAY_SERVICE_ID + RAILWAY_ENVIRONMENT_NAME=production) that it IS the production
# service. Never point a local/staging DATABASE_URL at production.
# - PRODUCTION_DB_HOST_DENYLIST_EXTRA=alias1,alias2   # extra host fingerprints to block (additive)
# - PRODUCTION_DB_OVERRIDE_ACK=i-understand-this-is-production  # narrow, explicit one-off override

# ======================
# Redis
# ======================
MOCK_REDIS=false
REDIS_URL=redis://localhost:6379

# ======================
# Security
# ======================
JWT_SECRET=change_me

# ======================
# AI Providers
# ======================
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# ==========================================
# AUTHENTICATION (JWT)
# ==========================================
# Secret key for signing tokens. MUST be at least 32 chars in production.
# In development, you can use the default or any string.
JWT_SECRET=supersecretkey_change_this_in_production_to_something_secure_and_long

# Token expiration times
JWT_EXPIRES_IN=365d
REFRESH_TOKEN_EXPIRES_IN=30d
TOKEN_CLEANUP_INTERVAL=3600000

# ==========================================
# SECRETS ENCRYPTION AT REST (STRONGLY RECOMMENDED)
# ==========================================
# AES-256-GCM key for encrypting integration secrets stored in the DB:
# SSO SAML certificate / OIDC clientSecret (tp_sso_configs), OAuth access &
# refresh tokens (integrationOAuthEngine), MCP connector headers, webhook HMAC
# secrets. WITHOUT this key these secrets are written as PLAINTEXT at rest
# (encryptSecret() degrades to a no-op and logs a one-time warning).
# Must be a 64-char hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# After setting it, run the backfill to encrypt any pre-existing plaintext rows:
#   npx tsx server/scripts/backfill-encrypt-sso-secrets.ts --write
INTEGRATION_ENCRYPT_KEY=

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3005
NODE_ENV=development
# Allowed values: development, production, test, staging

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
# URL of the frontend application (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL only)
# ==========================================
DB_TYPE=postgres

# Connection String (required)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Or individual fields:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=consultify
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_POOL_SIZE=10
# DB_CONNECTION_TIMEOUT=30000
# DB_STATEMENT_TIMEOUT=60000

# ==========================================
# REDIS CONFIGURATION (Optional)
# ==========================================
# Redis is used for caching and session storage.
# If not provided, in-memory fallbacks will be used (not for production).
REDIS_URL=redis://localhost:6379

# ==========================================
# OAUTH CONFIGURATION (Optional)
# ==========================================
# If enabled, ALL fields for the provider must be set.

# Google
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3005/api/auth/google/callback

# Asana
# ASANA_CLIENT_ID=your-client-id
# ASANA_CLIENT_SECRET=your-client-secret

# LinkedIn
# LINKEDIN_CLIENT_ID=your-client-id
# LINKEDIN_CLIENT_SECRET=your-client-secret
# LINKEDIN_CALLBACK_URL=http://localhost:3005/api/auth/linkedin/callback

# Microsoft
# MICROSOFT_CLIENT_ID=your-client-id
# MICROSOFT_CLIENT_SECRET=your-client-secret
# MICROSOFT_CALLBACK_URL=http://localhost:3005/api/auth/microsoft/callback

# Slack
# SLACK_CLIENT_ID=your-client-id
# SLACK_CLIENT_SECRET=your-client-secret
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SLACK_REGISTRATION_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# Optional per-environment override for the registration channel:
# SLACK_REGISTRATION_WEBHOOK_URL_STAGING=https://hooks.slack.com/services/xxx/yyy/zzz
# SLACK_REGISTRATION_WEBHOOK_URL_PRODUCTION=https://hooks.slack.com/services/xxx/yyy/zzz
# AI_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# WhatsApp (Twilio)
# WHATSAPP_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_TOKEN=your-twilio-token
# WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_TO=whatsapp:+48123456789

# ==========================================
# AI PROVIDERS
# ==========================================
# At least one AI provider key is required for Anna public assistant and in-app AI.
GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key

# ==========================================
# ANNA PUBLIC ASSISTANT (Voice)
# ==========================================
# Gemini API key exposed to the browser for Anna live voice (Gemini Live API).
# If not set, Anna voice will use the server-side GEMINI_API_KEY via /voice-config.
# NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# ==========================================
# KNOWLEDGE BASE SITE KEY
# ==========================================
# Controls which DBR77 product the landing page / Anna defaults to.
# Valid values: consultify, iot, iris, dt, marketplace, vector
# VITE_KB_SITE_KEY=consultify

# ==========================================
# WEB SEARCH (Tavily)
# ==========================================
# Enables AI chat to search the internet for current information.
# Get your API key at: https://tavily.com (free tier: 1000 searches/month)
# When set, the AI will automatically search the web when it detects
# questions about current events, statistics, comparisons, etc.
TAVILY_API_KEY=tvly-your-tavily-api-key

# ==========================================
# E2E Test Support (Playwright) — local dev only, NEVER in production
# ==========================================
# Set both to enable the /api/test-support/bootstrap endpoint used by Playwright
# global-setup to create real (non-demo) test users.  Without these, global-setup
# falls back to /api/auth/register-demo which creates demo users and causes tests
# in modules that check for non-demo UI to fail.
ENABLE_TEST_SUPPORT=true
TEST_SUPPORT_KEY=local-test-support-key-change-me

# ==========================================
# V8 Feature Flags
# ==========================================
ENABLE_V8_GLOBAL=true
# ENABLE_V8_SHADOW_MODE=false

# ==========================================
# Partner Portal
# ==========================================
# Self-service partner org creation (POST /api/partners/connect). When unset or
# != 'true', new-partner self-connect is BLOCKED (403 PARTNER_SELF_CONNECT_DISABLED)
# and the portal hides the create-org form. Keep CLOSED until the partner
# onboarding process (tiers + approval) is defined — see Harvard/DECYZJE_BRIEFY.md #4.
PARTNER_SELF_CONNECT_ENABLED=false

# ==========================================
# Internal Tools / AI OS Control Plane
# ==========================================
# Production should stay false. Enable only for local development and Railway staging.
INTERNAL_TOOLS_ENABLED=false
INTERNAL_TOOLS_ALLOWED_EMAIL_DOMAINS=dbr77.com
INTERNAL_TOOLS_ALLOWED_ROLES=SUPERADMIN,ADMIN,OWNER
# Optional hard org allowlist. Leave empty to rely on DBR77 email + role.
# INTERNAL_TOOLS_ALLOWED_ORG_IDS=org-dbr77-system

# Browser-side mirror for hiding navigation and route UI only.
# Server-side INTERNAL_TOOLS_* remains the security boundary.
VITE_INTERNAL_TOOLS_ENABLED=false
VITE_INTERNAL_TOOLS_ALLOWED_EMAIL_DOMAINS=dbr77.com
VITE_INTERNAL_TOOLS_ALLOWED_ORG_NAMES=DBR77
VITE_INTERNAL_TOOLS_ALLOWED_ROLES=SUPERADMIN,ADMIN,OWNER
# VITE_INTERNAL_TOOLS_ALLOWED_ORG_IDS=org-dbr77-system

# ==========================================
# DEMO & TRIAL
# ==========================================
DEMO_ORG_ID=demo-org
DEMO_ORG_NAME=Atelier ToolToys
DEMO_ORG_SLUG=demo-org
DEMO_ORG_DESCRIPTION=Demo organization - Atelier ToolToys

# Optional: override limits
# DEMO_AI_CALLS_PER_DAY=10
# DEMO_MAX_TOKENS=10000
# DEMO_MAX_STORAGE_MB=10

# Trial (7 days)
TRIAL_DURATION_DAYS=7

# ==========================================
# Organization Context Engine
# Source of truth: consultify/docs/product/ORGANIZATION_CONTEXT_ENGINE_SOURCE_OF_TRUTH.md
# ==========================================
ORG_CONTEXT_WORKER_SCHEDULER_ENABLED=false
ORG_CONTEXT_WORKER_LIMIT=5
ORG_CONTEXT_UPLOAD_PROCESSING_MODE=inline
ORG_CONTEXT_UPLOAD_ASYNC_CUTOVER_ENABLED=false
ORG_CONTEXT_QUEUE_BACKEND=db_ledger
ORG_CONTEXT_EXTERNAL_QUEUE_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_PULL_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_ACK_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_BACKOFF_URL=
ORG_CONTEXT_EXTERNAL_QUEUE_NAME=organization-context
ORG_CONTEXT_EXTERNAL_QUEUE_TOKEN=
ORG_CONTEXT_EXTERNAL_WORKER_HEALTH_URL=
ORG_CONTEXT_EXTERNAL_WORKER_DEPLOYMENT_VERIFIED=false
ORG_CONTEXT_EXTERNAL_WORKER_HEALTH_PROBE_ENABLED=false
ORG_CONTEXT_IMAGE_OCR_PROVIDER=disabled
ORG_CONTEXT_IMAGE_OCR_LANGUAGES=eng+pol
ORG_CONTEXT_AUDIO_TRANSCRIPTION_PROVIDER=disabled
ORG_CONTEXT_AUDIO_MINUTES_PER_ORG_PER_MONTH=0
ORG_CONTEXT_RETENTION_TTL_DAYS=0
ORG_CONTEXT_RETENTION_HARD_DELETE_GRACE_DAYS=14

# ---------------------------------------------------------------------------
# Billing / Stripe (Module 08 — Finanse)
# ---------------------------------------------------------------------------
# DECISION D8: live Stripe self-serve payments are DEFERRED. Billing currently
# runs on MANUAL invoices + admin plan/limit assignment. Leave the Stripe keys
# BLANK in normal operation — when blank, the server's /billing/setup-intent
# endpoint reports "not configured" and the in-app card form shows an honest
# "billing is handled manually" state (it NEVER submits a fake payment method).
#
# To enable real self-serve card payments later, an OWNER must:
#   1. Set STRIPE_SECRET_KEY (server) and STRIPE_PUBLISHABLE_KEY (client/VITE_).
#   2. Flip the frontend kill-switch ON: VITE_BILLING_SELF_SERVE=true
#      (also unhides the MRR/churn/recognition/forecast analytics surfaces).
#   3. Wire client-side Stripe Elements (@stripe/react-stripe-js) in AddCardModal.
#
# Stripe secret key (server-side). Blank = manual billing, no live payments.
STRIPE_SECRET_KEY=
# Stripe publishable key (client-side card tokenization). Blank = no Elements.
STRIPE_PUBLISHABLE_KEY=
# Frontend self-serve billing kill-switch (default OFF). Set to true ONLY once
# real Stripe keys above are configured and self-serve checkout is verified.
VITE_BILLING_SELF_SERVE=false
# Local-dev sandbox billing toggle for QA flows (guarded by billingSandboxGuard).
# Leave false outside of explicit local QA. Never set true in production.
MOCK_BILLING=false
