# ==========================================
# AUTHENTICATION (JWT)
# ==========================================
# Secret key for signing tokens. MUST be at least 32 chars in production.
# In development, you can use the default or any string.
JWT_SECRET=supersecretkey_change_this_in_production_to_something_secure_and_long

# Token expiration times
JWT_EXPIRES_IN=365d
REFRESH_TOKEN_EXPIRES_IN=30d
TOKEN_CLEANUP_INTERVAL=3600000

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3005
NODE_ENV=development
# Allowed values: development, production, test, staging

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
# URL of the frontend application (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Database type: sqlite or postgres
DB_TYPE=sqlite

# SQLite Configuration (if DB_TYPE=sqlite)
SQLITE_PATH=./consultify.db

# PostgreSQL Configuration (if DB_TYPE=postgres)
# Option 1: Connection String (Preferred for production)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Option 2: Individual Fields
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=consultify
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_POOL_SIZE=10
# DB_CONNECTION_TIMEOUT=30000
# DB_STATEMENT_TIMEOUT=60000

# ==========================================
# REDIS CONFIGURATION (Optional)
# ==========================================
# Redis is used for caching and session storage.
# If not provided, in-memory fallbacks will be used (not for production).
REDIS_URL=redis://localhost:6379

# ==========================================
# OAUTH CONFIGURATION (Optional)
# ==========================================
# If enabled, ALL fields for the provider must be set.

# Google
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3005/api/auth/google/callback

# LinkedIn
# LINKEDIN_CLIENT_ID=your-client-id
# LINKEDIN_CLIENT_SECRET=your-client-secret
# LINKEDIN_CALLBACK_URL=http://localhost:3005/api/auth/linkedin/callback

# Microsoft
# MICROSOFT_CLIENT_ID=your-client-id
# MICROSOFT_CLIENT_SECRET=your-client-secret
# MICROSOFT_CALLBACK_URL=http://localhost:3005/api/auth/microsoft/callback

# ==========================================
# AI PROVIDERS
# ==========================================
# At least one AI provider key is required
GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ==========================================
# WEB SEARCH (Tavily)
# ==========================================
# Enables AI chat to search the internet for current information.
# Get your API key at: https://tavily.com (free tier: 1000 searches/month)
# When set, the AI will automatically search the web when it detects
# questions about current events, statistics, comparisons, etc.
TAVILY_API_KEY=tvly-your-tavily-api-key
