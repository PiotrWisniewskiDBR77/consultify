# ==============================================================================
# CONSULTIFY - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control!
# ==============================================================================

# ==============================================================================
# LLM PROVIDERS - API Keys
# ==============================================================================
# Configure at least ONE provider for AI features to work
# The system will automatically fall back to other providers if primary fails

# --- OPENAI ---
# Get key at: https://platform.openai.com/api-keys
# Format: sk-proj-...
OPENAI_API_KEY=

# --- GOOGLE GEMINI (Recommended as default - free tier available) ---
# Get key at: https://aistudio.google.com/app/apikey
# Format: AIza...
# Note: This is the canonical name. Legacy aliases (GEMINI_API_KEY, etc.) still work
GOOGLE_API_KEY=

# --- DEEPSEEK (Budget option - very low cost) ---
# Get key at: https://platform.deepseek.com/
# Format: sk-...
DEEPSEEK_API_KEY=

# --- ANTHROPIC CLAUDE ---
# Get key at: https://console.anthropic.com/
# Format: sk-ant-...
ANTHROPIC_API_KEY=

# --- NVIDIA NIM ---
# Get key at: https://build.nvidia.com/
# Format: nvapi-...
NVIDIA_API_KEY=

# --- COHERE ---
# Get key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- ALIBABA QWEN ---
# Get key at: https://dashscope.console.aliyun.com/
# Note: Legacy alias QWEN_API_KEY still works
ALIBABA_API_KEY=

# --- ZHIPU AI (z.ai) ---
# Get key at: https://open.bigmodel.cn/
# Format: id.secret (dot-separated)
ZAI_API_KEY=

# --- OLLAMA (Local LLM) ---
# Only needed if running Ollama locally
# OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# ADDITIONAL GOOGLE APIs (Optional)
# ==============================================================================

# Google Custom Search API (for web research features)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ==============================================================================
# DATABASE
# ==============================================================================

# SQLite (default for development)
SQLITE_PATH=./server/consultify.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@host:5432/consultify

# ==============================================================================
# SERVER
# ==============================================================================

PORT=3000
NODE_ENV=development

# Session secret (generate with: openssl rand -base64 32)
JWT_SECRET=change-this-to-a-random-string

# ==============================================================================
# AI SYSTEM CONFIGURATION (Optional)
# ==============================================================================

# Enable strict mode for AI gateway (blocks suspicious prompts)
# AI_STRICT_MODE=false

# Emergency stop - disables all AI calls
# AI_EMERGENCY_STOP=false

# Default LLM provider (overrides database default)
# DEFAULT_LLM_PROVIDER=google

# ==============================================================================
# EXTERNAL SERVICES (Optional)
# ==============================================================================

# Stripe (for billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Tavily (for web research)
# TAVILY_API_KEY=

# Perplexity (for web research)
# PERPLEXITY_API_KEY=

# Redis (for caching/rate limiting in production)
# REDIS_URL=redis://localhost:6379

# ==============================================================================
# DEVELOPMENT/DEBUG (Optional)
# ==============================================================================

# Enable debug logging
# DEBUG=consultify:*

# Disable AI cost tracking (for testing)
# DISABLE_AI_BILLING=true
