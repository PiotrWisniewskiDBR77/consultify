/**
 * k6 Load Testing Script - 1000+ Concurrent Users
 * Enterprise SaaS Architecture - High-Scale Performance Testing
 * 
 * Usage:
 *   k6 run tests/performance/load-test-1000.js
 *   k6 run --vus 1000 --duration 5m tests/performance/load-test-1000.js
 * 
 * Environment Variables:
 *   K6_VUS - Number of virtual users (default: 1000)
 *   K6_DURATION - Test duration (default: 5m)
 *   BASE_URL - API base URL (default: http://localhost:3005)
 */

import http from 'k6/http';
import { check, sleep, group } from 'k6';
import { Rate, Trend, Counter } from 'k6/metrics';

// Custom metrics
const errorRate = new Rate('errors');
const healthCheckDuration = new Trend('health_check_duration');
const authDuration = new Trend('auth_duration');
const apiDuration = new Trend('api_duration');
const aiDuration = new Trend('ai_duration');
const billingDuration = new Trend('billing_duration');
const dbQueryDuration = new Trend('db_query_duration');
const requestCounter = new Counter('total_requests');

// Test configuration for 1000+ users
export const options = {
  stages: [
    { duration: '30s', target: 100 },    // Ramp up to 100 users
    { duration: '1m', target: 500 },     // Ramp up to 500 users
    { duration: '2m', target: 1000 },    // Ramp up to 1000 users
    { duration: '5m', target: 1000 },    // Stay at 1000 users (sustained load)
    { duration: '1m', target: 1500 },    // Spike to 1500 users
    { duration: '2m', target: 1500 },   // Hold spike
    { duration: '1m', target: 1000 },   // Back to 1000
    { duration: '2m', target: 1000 },   // Hold at 1000
    { duration: '1m', target: 500 },    // Ramp down to 500
    { duration: '30s', target: 0 },      // Ramp down to 0
  ],
  thresholds: {
    // 95% of requests should be below 1s (relaxed for high load)
    http_req_duration: ['p(95)<1000', 'p(99)<2000'],
    // Error rate should be below 2% (allows for some failures under extreme load)
    errors: ['rate<0.02'],
    // Health check should be under 200ms
    health_check_duration: ['p(95)<200'],
    // Auth endpoints under 2s
    auth_duration: ['p(95)<2000'],
    // API endpoints under 1s
    api_duration: ['p(95)<1000'],
    // AI endpoints under 5s (LLM calls are slower)
    ai_duration: ['p(95)<5000'],
    // Billing endpoints under 1s
    billing_duration: ['p(95)<1000'],
  },
};

const BASE_URL = __ENV.BASE_URL || 'http://localhost:3005';

// Test users for authentication (rotating pool)
const TEST_USERS = Array.from({ length: 50 }, (_, i) => ({
  email: `test${i}@example.com`,
  password: 'TestPassword123!',
}));

// Shared tokens cache (per VU)
let authToken = null;
let tokenExpiry = 0;

/**
 * Get or refresh auth token
 */
function getAuthToken() {
  const now = Date.now();
  if (authToken && tokenExpiry > now) {
    return authToken;
  }

  const user = TEST_USERS[Math.floor(Math.random() * TEST_USERS.length)];
  const loginRes = http.post(
    `${BASE_URL}/api/auth/login`,
    JSON.stringify({
      email: user.email,
      password: user.password,
    }),
    {
      headers: { 'Content-Type': 'application/json' },
      tags: { name: 'Auth-Login' },
    }
  );

  if (loginRes.status === 200) {
    try {
      const body = JSON.parse(loginRes.body);
      authToken = body.token || body.accessToken;
      tokenExpiry = now + 3600000; // 1 hour
      return authToken;
    } catch {
      return null;
    }
  }

  return null;
}

export default function () {
  requestCounter.add(1);

  // ==========================================
  // Health Check Tests (High Frequency)
  // ==========================================
  group('Health Checks', function () {
    const healthRes = http.get(`${BASE_URL}/api/health`, {
      tags: { name: 'Health-Check' },
    });
    healthCheckDuration.add(healthRes.timings.duration);

    check(healthRes, {
      'health check status is 200': (r) => r.status === 200,
      'health check has status ok': (r) => {
        try {
          return JSON.parse(r.body).status === 'ok';
        } catch {
          return false;
        }
      },
    });

    errorRate.add(healthRes.status !== 200);
  });

  sleep(0.1);

  // ==========================================
  // Authentication Load Test
  // ==========================================
  group('Authentication', function () {
    const token = getAuthToken();
    if (token) {
      // Test authenticated endpoint
      const profileRes = http.get(`${BASE_URL}/api/user/profile`, {
        headers: { Authorization: `Bearer ${token}` },
        tags: { name: 'User-Profile' },
      });

      authDuration.add(profileRes.timings.duration);
      apiDuration.add(profileRes.timings.duration);

      check(profileRes, {
        'profile responds': (r) => r.status !== 500,
        'profile response time ok': (r) => r.timings.duration < 3000,
      });

      errorRate.add(profileRes.status >= 500);
    }
  });

  sleep(0.2);

  // ==========================================
  // API Endpoints Load Test
  // ==========================================
  group('API Endpoints', function () {
    const token = getAuthToken();
    if (!token) return;

    // Test multiple endpoints
    const endpoints = [
      { path: '/api/projects', name: 'Projects' },
      { path: '/api/tasks', name: 'Tasks' },
      { path: '/api/initiatives', name: 'Initiatives' },
    ];

    endpoints.forEach((endpoint) => {
      const res = http.get(`${BASE_URL}${endpoint.path}`, {
        headers: { Authorization: `Bearer ${token}` },
        tags: { name: endpoint.name },
      });

      apiDuration.add(res.timings.duration);
      errorRate.add(res.status >= 500);
    });
  });

  sleep(0.3);

  // ==========================================
  // AI Endpoints Load Test (Lower Frequency)
  // ==========================================
  if (Math.random() < 0.1) {
    // Only 10% of VUs hit AI endpoints (they're expensive)
    group('AI Endpoints', function () {
      const token = getAuthToken();
      if (!token) return;

      const aiRes = http.post(
        `${BASE_URL}/api/ai/chat`,
        JSON.stringify({
          message: 'Test message',
          context: 'test',
        }),
        {
          headers: {
            Authorization: `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          tags: { name: 'AI-Chat' },
          timeout: '30s',
        }
      );

      aiDuration.add(aiRes.timings.duration);
      errorRate.add(aiRes.status >= 500);

      check(aiRes, {
        'ai endpoint responds': (r) => r.status !== 500,
        'ai response time acceptable': (r) => r.timings.duration < 10000,
      });
    });
  }

  sleep(0.5);

  // ==========================================
  // Billing Endpoints Load Test
  // ==========================================
  if (Math.random() < 0.05) {
    // Only 5% of VUs hit billing endpoints
    group('Billing Endpoints', function () {
      const token = getAuthToken();
      if (!token) return;

      const billingRes = http.get(`${BASE_URL}/api/billing/usage`, {
        headers: { Authorization: `Bearer ${token}` },
        tags: { name: 'Billing-Usage' },
      });

      billingDuration.add(billingRes.timings.duration);
      errorRate.add(billingRes.status >= 500);
    });
  }

  sleep(0.5);

  // ==========================================
  // Rate Limiting Stress Test
  // ==========================================
  if (Math.random() < 0.2) {
    // 20% of VUs perform burst requests
    group('Rate Limiting', function () {
      const responses = [];
      for (let i = 0; i < 10; i++) {
        responses.push(
          http.get(`${BASE_URL}/api/health`, {
            tags: { name: 'Burst-Request' },
          })
        );
      }

      const successCount = responses.filter((r) => r.status === 200).length;
      const rateLimitedCount = responses.filter((r) => r.status === 429).length;

      check(null, {
        'burst requests handled': () => successCount >= 1,
        'rate limiting active': () => rateLimitedCount >= 0, // May or may not trigger
      });
    });
  }

  sleep(1);
}

// ==========================================
// Setup - Run once before tests
// ==========================================
export function setup() {
  // Verify server is running
  const healthRes = http.get(`${BASE_URL}/api/health`);

  if (healthRes.status !== 200) {
    throw new Error(`Server not healthy: ${healthRes.status}`);
  }

  console.log('Server is healthy, starting 1000+ user load test...');
  console.log(`Target: ${__ENV.K6_VUS || 1000} virtual users`);

  return {
    baseUrl: BASE_URL,
    startTime: new Date().toISOString(),
    targetVUs: __ENV.K6_VUS || 1000,
  };
}

// ==========================================
// Teardown - Run once after tests
// ==========================================
export function teardown(data) {
  console.log(`Load test completed. Started at: ${data.startTime}`);
  console.log(`Target VUs: ${data.targetVUs}`);
}

// ==========================================
// Handle Summary - Generate report
// ==========================================
export function handleSummary(data) {
  const summary = {
    timestamp: new Date().toISOString(),
    duration: data.state.testRunDurationMs,
    vus: {
      max: data.metrics.vus_max?.values?.value || 0,
      avg: data.metrics.vus?.values?.value || 0,
    },
    requests: {
      total: data.metrics.http_reqs?.values?.count || 0,
      rate: data.metrics.http_reqs?.values?.rate || 0,
    },
    errors: {
      rate: data.metrics.errors?.values?.rate || 0,
      count: data.metrics.http_req_failed?.values?.count || 0,
    },
    latency: {
      avg: data.metrics.http_req_duration?.values?.avg || 0,
      p50: data.metrics.http_req_duration?.values['p(50)'] || 0,
      p95: data.metrics.http_req_duration?.values['p(95)'] || 0,
      p99: data.metrics.http_req_duration?.values['p(99)'] || 0,
      max: data.metrics.http_req_duration?.values?.max || 0,
    },
    endpoints: {
      health: {
        p95: data.metrics.health_check_duration?.values['p(95)'] || 0,
        p99: data.metrics.health_check_duration?.values['p(99)'] || 0,
      },
      auth: {
        p95: data.metrics.auth_duration?.values['p(95)'] || 0,
        p99: data.metrics.auth_duration?.values['p(99)'] || 0,
      },
      api: {
        p95: data.metrics.api_duration?.values['p(95)'] || 0,
        p99: data.metrics.api_duration?.values['p(99)'] || 0,
      },
      ai: {
        p95: data.metrics.ai_duration?.values['p(95)'] || 0,
        p99: data.metrics.ai_duration?.values['p(99)'] || 0,
      },
      billing: {
        p95: data.metrics.billing_duration?.values['p(95)'] || 0,
        p99: data.metrics.billing_duration?.values['p(99)'] || 0,
      },
    },
    thresholds: {
      passed: Object.entries(data.thresholds || {})
        .filter(([_, v]) => v.ok)
        .map(([k]) => k),
      failed: Object.entries(data.thresholds || {})
        .filter(([_, v]) => !v.ok)
        .map(([k]) => k),
    },
  };

  return {
    stdout: textSummary(data, { indent: ' ', enableColors: true }),
    'tests/performance/results/load-test-1000-summary.json': JSON.stringify(summary, null, 2),
  };
}

// Simple text summary
function textSummary(data) {
  const lines = [
    '='.repeat(60),
    'LOAD TEST SUMMARY - 1000+ USERS',
    '='.repeat(60),
    '',
    `Duration: ${Math.round(data.state.testRunDurationMs / 1000)}s`,
    `Max VUs: ${data.metrics.vus_max?.values?.value || 0}`,
    `Total Requests: ${data.metrics.http_reqs?.values?.count || 0}`,
    `Request Rate: ${(data.metrics.http_reqs?.values?.rate || 0).toFixed(2)} req/s`,
    '',
    'LATENCY (All Endpoints):',
    `  Average: ${(data.metrics.http_req_duration?.values?.avg || 0).toFixed(2)}ms`,
    `  p50: ${(data.metrics.http_req_duration?.values['p(50)'] || 0).toFixed(2)}ms`,
    `  p95: ${(data.metrics.http_req_duration?.values['p(95)'] || 0).toFixed(2)}ms`,
    `  p99: ${(data.metrics.http_req_duration?.values['p(99)'] || 0).toFixed(2)}ms`,
    `  Max: ${(data.metrics.http_req_duration?.values?.max || 0).toFixed(2)}ms`,
    '',
    'ENDPOINT LATENCY:',
    `  Health Check p95: ${(data.metrics.health_check_duration?.values['p(95)'] || 0).toFixed(2)}ms`,
    `  Auth p95: ${(data.metrics.auth_duration?.values['p(95)'] || 0).toFixed(2)}ms`,
    `  API p95: ${(data.metrics.api_duration?.values['p(95)'] || 0).toFixed(2)}ms`,
    `  AI p95: ${(data.metrics.ai_duration?.values['p(95)'] || 0).toFixed(2)}ms`,
    `  Billing p95: ${(data.metrics.billing_duration?.values['p(95)'] || 0).toFixed(2)}ms`,
    '',
    'ERRORS:',
    `  Rate: ${((data.metrics.errors?.values?.rate || 0) * 100).toFixed(2)}%`,
    `  Count: ${data.metrics.http_req_failed?.values?.count || 0}`,
    '',
    'THRESHOLDS:',
    `  Passed: ${Object.entries(data.thresholds || {}).filter(([_, v]) => v.ok).length}`,
    `  Failed: ${Object.entries(data.thresholds || {}).filter(([_, v]) => !v.ok).length}`,
    '',
    '='.repeat(60),
  ];

  return lines.join('\n');
}






