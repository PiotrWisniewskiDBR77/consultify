/**
 * Economics Service Unit Tests
 * 
 * Tests for the core business logic of the Economics module
 */

const EconomicsService = require('../../server/services/economicsService');

// Mock dependencies
jest.mock('../../server/database', () => ({
    run: jest.fn(),
    get: jest.fn(),
    all: jest.fn(),
}));

const db = require('../../server/database');

describe('EconomicsService', () => {
    beforeEach(() => {
        jest.clearAllMocks();
    });

    describe('createAnalysis', () => {
        it('should create a new analysis with valid data', async () => {
            const mockAnalysis = {
                id: 'test-uuid-123',
                name: 'Test Analysis',
                description: 'Test description',
                status: 'draft',
                organization_id: 'org-123',
                created_by: 'user-123',
            };

            db.run.mockResolvedValue({ lastID: 1 });
            db.get.mockResolvedValue(mockAnalysis);

            const result = await EconomicsService.createAnalysis(
                { name: 'Test Analysis', description: 'Test description' },
                'org-123',
                'user-123'
            );

            expect(db.run).toHaveBeenCalled();
            expect(result).toBeDefined();
            expect(result.name).toBe('Test Analysis');
        });

        it('should throw error when name is missing', async () => {
            await expect(
                EconomicsService.createAnalysis(
                    { description: 'Test' },
                    'org-123',
                    'user-123'
                )
            ).rejects.toThrow();
        });

        it('should set default status to draft', async () => {
            db.run.mockResolvedValue({ lastID: 1 });
            db.get.mockResolvedValue({
                id: 'test-123',
                status: 'draft',
            });

            const result = await EconomicsService.createAnalysis(
                { name: 'Test' },
                'org-123',
                'user-123'
            );

            expect(result.status).toBe('draft');
        });
    });

    describe('getAnalyses', () => {
        it('should return paginated list of analyses', async () => {
            const mockAnalyses = [
                { id: '1', name: 'Analysis 1' },
                { id: '2', name: 'Analysis 2' },
            ];

            db.all.mockResolvedValue(mockAnalyses);
            db.get.mockResolvedValue({ count: 2 });

            const result = await EconomicsService.getAnalyses('org-123', {
                page: 1,
                pageSize: 20,
            });

            expect(result.analyses).toHaveLength(2);
            expect(result.total).toBe(2);
        });

        it('should filter by status', async () => {
            db.all.mockResolvedValue([{ id: '1', status: 'completed' }]);
            db.get.mockResolvedValue({ count: 1 });

            await EconomicsService.getAnalyses('org-123', { status: 'completed' });

            expect(db.all).toHaveBeenCalledWith(
                expect.stringContaining('status = ?'),
                expect.arrayContaining(['completed'])
            );
        });

        it('should filter by search term', async () => {
            db.all.mockResolvedValue([]);
            db.get.mockResolvedValue({ count: 0 });

            await EconomicsService.getAnalyses('org-123', { search: 'test' });

            expect(db.all).toHaveBeenCalledWith(
                expect.stringContaining('LIKE'),
                expect.anything()
            );
        });
    });

    describe('getAnalysisById', () => {
        it('should return analysis with calculated scores', async () => {
            const mockAnalysis = {
                id: 'test-123',
                name: 'Test',
                axis_scores: JSON.stringify({
                    'axis-1': { currentScore: 3.5, targetScore: 5 },
                }),
            };

            db.get.mockResolvedValue(mockAnalysis);
            db.all.mockResolvedValue([]);

            const result = await EconomicsService.getAnalysisById('test-123', 'org-123');

            expect(result).toBeDefined();
            expect(result.id).toBe('test-123');
            expect(result.axisScores).toBeDefined();
        });

        it('should return null for non-existent analysis', async () => {
            db.get.mockResolvedValue(null);

            const result = await EconomicsService.getAnalysisById('non-existent', 'org-123');

            expect(result).toBeNull();
        });
    });

    describe('updateAnalysis', () => {
        it('should update analysis fields', async () => {
            db.get.mockResolvedValue({ id: 'test-123', name: 'Original' });
            db.run.mockResolvedValue({ changes: 1 });

            await EconomicsService.updateAnalysis(
                'test-123',
                { name: 'Updated Name' },
                'org-123'
            );

            expect(db.run).toHaveBeenCalledWith(
                expect.stringContaining('UPDATE'),
                expect.arrayContaining(['Updated Name'])
            );
        });

        it('should throw error if analysis not found', async () => {
            db.get.mockResolvedValue(null);

            await expect(
                EconomicsService.updateAnalysis('non-existent', { name: 'Test' }, 'org-123')
            ).rejects.toThrow('Analysis not found');
        });
    });

    describe('deleteAnalysis', () => {
        it('should delete analysis and related data', async () => {
            db.get.mockResolvedValue({ id: 'test-123' });
            db.run.mockResolvedValue({ changes: 1 });

            const result = await EconomicsService.deleteAnalysis('test-123', 'org-123');

            expect(result).toBe(true);
            expect(db.run).toHaveBeenCalledWith(
                expect.stringContaining('DELETE'),
                expect.anything()
            );
        });

        it('should return false if analysis not found', async () => {
            db.get.mockResolvedValue(null);

            const result = await EconomicsService.deleteAnalysis('non-existent', 'org-123');

            expect(result).toBe(false);
        });
    });

    describe('bulkUpdateScores', () => {
        it('should update multiple scores', async () => {
            db.get.mockResolvedValue({ id: 'test-123' });
            db.run.mockResolvedValue({ changes: 1 });

            const scores = [
                { axisId: 'axis-1', areaId: 'area-1', currentLevel: 3, targetLevel: 5 },
                { axisId: 'axis-1', areaId: 'area-2', currentLevel: 2, targetLevel: 4 },
            ];

            await EconomicsService.bulkUpdateScores('test-123', scores, 'org-123', 'user-123');

            expect(db.run).toHaveBeenCalledTimes(expect.any(Number));
        });

        it('should recalculate analysis scores after update', async () => {
            db.get.mockResolvedValue({ id: 'test-123' });
            db.run.mockResolvedValue({ changes: 1 });
            db.all.mockResolvedValue([]);

            const scores = [
                { axisId: 'axis-1', areaId: 'area-1', currentLevel: 3, targetLevel: 5 },
            ];

            await EconomicsService.bulkUpdateScores('test-123', scores, 'org-123', 'user-123');

            // Verify recalculation was triggered
            expect(db.run).toHaveBeenCalledWith(
                expect.stringContaining('UPDATE digitization_analyses'),
                expect.anything()
            );
        });
    });

    describe('duplicateAnalysis', () => {
        it('should create a copy of analysis with new name', async () => {
            const mockOriginal = {
                id: 'original-123',
                name: 'Original',
                description: 'Test',
                organization_id: 'org-123',
            };

            db.get.mockResolvedValueOnce(mockOriginal);
            db.get.mockResolvedValueOnce({ id: 'new-123', name: 'Copy' });
            db.run.mockResolvedValue({ lastID: 1 });
            db.all.mockResolvedValue([]);

            const result = await EconomicsService.duplicateAnalysis(
                'original-123',
                'Copy',
                'org-123',
                'user-123'
            );

            expect(result.name).toBe('Copy');
            expect(result.id).not.toBe('original-123');
        });

        it('should throw error if original not found', async () => {
            db.get.mockResolvedValue(null);

            await expect(
                EconomicsService.duplicateAnalysis('non-existent', 'Copy', 'org-123', 'user-123')
            ).rejects.toThrow('Original analysis not found');
        });
    });

    describe('getCatalogStats', () => {
        it('should return aggregated statistics', async () => {
            db.get.mockResolvedValue({
                total: 10,
                completed: 5,
                inProgress: 3,
                draft: 2,
                avgScore: 4.5,
            });

            const result = await EconomicsService.getCatalogStats('org-123');

            expect(result.total).toBe(10);
            expect(result.completed).toBe(5);
            expect(result.avgScore).toBe(4.5);
        });
    });

    describe('recalculateScores', () => {
        it('should calculate overall score from axis scores', async () => {
            db.all.mockResolvedValue([
                { axis_id: 'axis-1', current_level: 3, target_level: 5 },
                { axis_id: 'axis-1', current_level: 4, target_level: 6 },
                { axis_id: 'axis-2', current_level: 2, target_level: 4 },
            ]);
            db.run.mockResolvedValue({ changes: 1 });

            await EconomicsService.recalculateScores('test-123', 'org-123');

            expect(db.run).toHaveBeenCalledWith(
                expect.stringContaining('overall_score'),
                expect.anything()
            );
        });

        it('should calculate completion percentage', async () => {
            db.all.mockResolvedValue([
                { axis_id: 'axis-1', current_level: 3, target_level: 5 },
                { axis_id: 'axis-1', current_level: 0, target_level: 5 },
            ]);
            db.run.mockResolvedValue({ changes: 1 });

            await EconomicsService.recalculateScores('test-123', 'org-123');

            // 50% completed (1 of 2 areas scored)
            expect(db.run).toHaveBeenCalledWith(
                expect.stringContaining('completion_percent'),
                expect.anything()
            );
        });
    });
});















