/**
 * Economics Module Component Tests
 * 
 * React component tests for the Economics module
 */

import React from 'react';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import '@testing-library/jest-dom';

// Mock API
jest.mock('../../services/api', () => ({
    Api: {
        getDigitizationAnalyses: jest.fn(),
        createDigitizationAnalysis: jest.fn(),
        getDigitizationAnalysis: jest.fn(),
        updateDigitizationScores: jest.fn(),
        getDigitizationStats: jest.fn(),
        deleteDigitizationAnalysis: jest.fn(),
        duplicateDigitizationAnalysis: jest.fn(),
        exportDigitizationAnalysis: jest.fn(),
        getDigitizationVersions: jest.fn(),
        getDigitizationEvidence: jest.fn(),
    },
}));

// Mock toast
jest.mock('react-hot-toast', () => ({
    toast: {
        success: jest.fn(),
        error: jest.fn(),
        loading: jest.fn(),
        dismiss: jest.fn(),
    },
}));

import { Api } from '../../services/api';
import { AnalysisCatalog } from '../../components/Economics/AnalysisCatalog';
import { AnalysisCreateModal } from '../../components/Economics/AnalysisCreateModal';
import { DigitizationToolTab } from '../../components/Economics/DigitizationToolTab';
import { AnalysisResultsPanel } from '../../components/Economics/AnalysisResultsPanel';
import { RadarChart } from '../../components/Charts/RadarChart';

const mockAnalysis = {
    id: 'test-123',
    name: 'Test Analysis',
    description: 'Test description',
    status: 'in_progress',
    overallScore: 4.5,
    completionPercent: 60,
    createdAt: '2024-01-01T00:00:00Z',
    axisScores: {
        'digital_processes': {
            axisId: 'digital_processes',
            currentScore: 4,
            targetScore: 6,
            gap: 2,
            completedAreas: 3,
            totalAreas: 5,
        },
    },
    detailedScores: [],
};

describe('AnalysisCatalog', () => {
    beforeEach(() => {
        jest.clearAllMocks();
        (Api.getDigitizationAnalyses as jest.Mock).mockResolvedValue({
            analyses: [mockAnalysis],
            total: 1,
        });
        (Api.getDigitizationStats as jest.Mock).mockResolvedValue({
            total: 10,
            completed: 5,
            inProgress: 3,
            avgScore: 4.5,
        });
    });

    it('renders analysis catalog with stats', async () => {
        render(
            <AnalysisCatalog
                onSelect={jest.fn()}
                onCreateNew={jest.fn()}
                onImport={jest.fn()}
            />
        );

        await waitFor(() => {
            expect(screen.getByText('Test Analysis')).toBeInTheDocument();
        });

        expect(screen.getByText('Wszystkie analizy')).toBeInTheDocument();
    });

    it('toggles between grid and table view', async () => {
        render(
            <AnalysisCatalog
                onSelect={jest.fn()}
                onCreateNew={jest.fn()}
                onImport={jest.fn()}
            />
        );

        await waitFor(() => {
            expect(screen.getByText('Test Analysis')).toBeInTheDocument();
        });

        // Find and click the table view button
        const tableButton = screen.getAllByRole('button').find(
            btn => btn.querySelector('svg')?.classList.contains('lucide-list')
        );
        
        if (tableButton) {
            fireEvent.click(tableButton);
            // Verify table view is rendered
            expect(document.querySelector('table')).toBeInTheDocument();
        }
    });

    it('filters analyses by status', async () => {
        render(
            <AnalysisCatalog
                onSelect={jest.fn()}
                onCreateNew={jest.fn()}
                onImport={jest.fn()}
            />
        );

        await waitFor(() => {
            expect(screen.getByText('Test Analysis')).toBeInTheDocument();
        });

        const statusSelect = screen.getByRole('combobox');
        fireEvent.change(statusSelect, { target: { value: 'completed' } });

        expect(Api.getDigitizationAnalyses).toHaveBeenCalledWith(
            expect.objectContaining({ status: 'completed' })
        );
    });

    it('searches analyses', async () => {
        const user = userEvent.setup();

        render(
            <AnalysisCatalog
                onSelect={jest.fn()}
                onCreateNew={jest.fn()}
                onImport={jest.fn()}
            />
        );

        await waitFor(() => {
            expect(screen.getByText('Test Analysis')).toBeInTheDocument();
        });

        const searchInput = screen.getByPlaceholderText(/szukaj/i);
        await user.type(searchInput, 'test');

        await waitFor(() => {
            expect(Api.getDigitizationAnalyses).toHaveBeenCalledWith(
                expect.objectContaining({ search: 'test' })
            );
        });
    });

    it('selects analysis on click', async () => {
        const onSelect = jest.fn();

        render(
            <AnalysisCatalog
                onSelect={onSelect}
                onCreateNew={jest.fn()}
                onImport={jest.fn()}
            />
        );

        await waitFor(() => {
            expect(screen.getByText('Test Analysis')).toBeInTheDocument();
        });

        fireEvent.click(screen.getByText('Test Analysis'));

        expect(onSelect).toHaveBeenCalledWith(mockAnalysis);
    });

    it('shows bulk action toolbar when items selected', async () => {
        render(
            <AnalysisCatalog
                onSelect={jest.fn()}
                onCreateNew={jest.fn()}
                onImport={jest.fn()}
            />
        );

        await waitFor(() => {
            expect(screen.getByText('Test Analysis')).toBeInTheDocument();
        });

        const checkbox = screen.getByRole('checkbox');
        fireEvent.click(checkbox);

        expect(screen.getByText(/wybrana/)).toBeInTheDocument();
    });
});

describe('AnalysisCreateModal', () => {
    it('renders create modal', () => {
        render(
            <AnalysisCreateModal
                onClose={jest.fn()}
                onCreate={jest.fn()}
            />
        );

        expect(screen.getByText(/nowa analiza/i)).toBeInTheDocument();
        expect(screen.getByPlaceholderText(/nazwa analizy/i)).toBeInTheDocument();
    });

    it('validates required fields', async () => {
        const onCreate = jest.fn();
        const user = userEvent.setup();

        render(
            <AnalysisCreateModal
                onClose={jest.fn()}
                onCreate={onCreate}
            />
        );

        const submitButton = screen.getByRole('button', { name: /utwórz/i });
        await user.click(submitButton);

        // Should not call onCreate with empty name
        expect(onCreate).not.toHaveBeenCalled();
    });

    it('submits form with valid data', async () => {
        const onCreate = jest.fn().mockResolvedValue({});
        const user = userEvent.setup();

        render(
            <AnalysisCreateModal
                onClose={jest.fn()}
                onCreate={onCreate}
            />
        );

        const nameInput = screen.getByPlaceholderText(/nazwa analizy/i);
        await user.type(nameInput, 'New Analysis');

        const submitButton = screen.getByRole('button', { name: /utwórz/i });
        await user.click(submitButton);

        expect(onCreate).toHaveBeenCalledWith(
            expect.objectContaining({ name: 'New Analysis' })
        );
    });

    it('closes on cancel', async () => {
        const onClose = jest.fn();
        const user = userEvent.setup();

        render(
            <AnalysisCreateModal
                onClose={onClose}
                onCreate={jest.fn()}
            />
        );

        const cancelButton = screen.getByRole('button', { name: /anuluj/i });
        await user.click(cancelButton);

        expect(onClose).toHaveBeenCalled();
    });
});

describe('DigitizationToolTab', () => {
    it('renders axis sidebar', () => {
        render(
            <DigitizationToolTab
                analysis={mockAnalysis}
                onUpdate={jest.fn()}
            />
        );

        expect(screen.getByText('Osie oceny')).toBeInTheDocument();
        expect(screen.getByText('Procesy cyfrowe')).toBeInTheDocument();
    });

    it('selects axis on click', async () => {
        render(
            <DigitizationToolTab
                analysis={mockAnalysis}
                onUpdate={jest.fn()}
            />
        );

        const axisButton = screen.getByText('Big Data i analityka');
        fireEvent.click(axisButton);

        // Verify axis is selected (has active styling)
        expect(axisButton.closest('button')).toHaveClass('bg-emerald-500/10');
    });

    it('expands area on click', async () => {
        render(
            <DigitizationToolTab
                analysis={mockAnalysis}
                onUpdate={jest.fn()}
            />
        );

        // Find and click an area
        const areaHeaders = screen.getAllByRole('button');
        const areaHeader = areaHeaders.find(btn => 
            btn.textContent?.includes('Poziom aktualny')
        );

        if (areaHeader) {
            fireEvent.click(areaHeader);
            // Level selector should be visible
            expect(screen.getAllByText('0')).toHaveLength(expect.any(Number));
        }
    });

    it('shows save button when changes are pending', async () => {
        render(
            <DigitizationToolTab
                analysis={mockAnalysis}
                onUpdate={jest.fn()}
            />
        );

        // Initially no save button
        expect(screen.queryByText(/zapisz/i)).not.toBeInTheDocument();

        // Make a change - this would require expanding an area and clicking a level
        // This is a simplified test - in reality you'd need to simulate the full flow
    });

    it('shows keyboard shortcuts on ? press', async () => {
        render(
            <DigitizationToolTab
                analysis={mockAnalysis}
                onUpdate={jest.fn()}
            />
        );

        fireEvent.keyDown(window, { key: '?' });

        expect(screen.getByText('Skróty klawiszowe')).toBeInTheDocument();
    });
});

describe('AnalysisResultsPanel', () => {
    it('renders overall score', () => {
        render(
            <AnalysisResultsPanel
                analysis={mockAnalysis}
            />
        );

        expect(screen.getByText('4.5')).toBeInTheDocument();
        expect(screen.getByText('/7')).toBeInTheDocument();
    });

    it('renders axis breakdown', () => {
        render(
            <AnalysisResultsPanel
                analysis={mockAnalysis}
            />
        );

        expect(screen.getByText('Procesy cyfrowe')).toBeInTheDocument();
    });

    it('renders completion percentage', () => {
        render(
            <AnalysisResultsPanel
                analysis={mockAnalysis}
            />
        );

        expect(screen.getByText('60%')).toBeInTheDocument();
    });

    it('shows top gaps section', () => {
        render(
            <AnalysisResultsPanel
                analysis={{
                    ...mockAnalysis,
                    axisScores: {
                        'digital_processes': {
                            ...mockAnalysis.axisScores['digital_processes'],
                            gap: 2,
                        },
                        'big_data': {
                            axisId: 'big_data',
                            currentScore: 2,
                            targetScore: 5,
                            gap: 3,
                            completedAreas: 2,
                            totalAreas: 4,
                        },
                    },
                }}
            />
        );

        expect(screen.getByText(/największe luki/i)).toBeInTheDocument();
    });
});

describe('RadarChart', () => {
    const mockData = [
        { label: 'Axis 1', current: 3, target: 5 },
        { label: 'Axis 2', current: 4, target: 6 },
        { label: 'Axis 3', current: 2, target: 4 },
    ];

    it('renders SVG chart', () => {
        const { container } = render(
            <RadarChart data={mockData} />
        );

        expect(container.querySelector('svg')).toBeInTheDocument();
    });

    it('renders legend when showLegend is true', () => {
        render(
            <RadarChart data={mockData} showLegend={true} />
        );

        expect(screen.getByText('Aktualny poziom')).toBeInTheDocument();
        expect(screen.getByText('Poziom docelowy')).toBeInTheDocument();
    });

    it('hides legend when showLegend is false', () => {
        render(
            <RadarChart data={mockData} showLegend={false} />
        );

        expect(screen.queryByText('Aktualny poziom')).not.toBeInTheDocument();
    });

    it('renders with custom size', () => {
        const { container } = render(
            <RadarChart data={mockData} size={300} />
        );

        const svg = container.querySelector('svg');
        expect(svg).toHaveAttribute('width', '300');
        expect(svg).toHaveAttribute('height', '300');
    });

    it('renders data labels', () => {
        render(
            <RadarChart data={mockData} />
        );

        expect(screen.getByText('Axis')).toBeInTheDocument();
    });
});

describe('Accessibility', () => {
    it('AnalysisCatalog has accessible elements', async () => {
        (Api.getDigitizationAnalyses as jest.Mock).mockResolvedValue({
            analyses: [mockAnalysis],
            total: 1,
        });
        (Api.getDigitizationStats as jest.Mock).mockResolvedValue({
            total: 1, completed: 0, inProgress: 1, avgScore: 4.5,
        });

        render(
            <AnalysisCatalog
                onSelect={jest.fn()}
                onCreateNew={jest.fn()}
                onImport={jest.fn()}
            />
        );

        await waitFor(() => {
            expect(screen.getByText('Test Analysis')).toBeInTheDocument();
        });

        // Check for accessible search input
        const searchInput = screen.getByPlaceholderText(/szukaj/i);
        expect(searchInput).toHaveAttribute('type', 'text');

        // Check for accessible checkboxes
        const checkboxes = screen.getAllByRole('checkbox');
        expect(checkboxes.length).toBeGreaterThan(0);
    });

    it('DigitizationToolTab has keyboard navigation', async () => {
        render(
            <DigitizationToolTab
                analysis={mockAnalysis}
                onUpdate={jest.fn()}
            />
        );

        // Test arrow key navigation
        fireEvent.keyDown(window, { key: 'ArrowDown' });
        
        // The second axis should now be selected
        // (Implementation-dependent check)
    });
});















