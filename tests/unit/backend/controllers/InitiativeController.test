/**
 * Initiative Controller Tests
 *
 * Tests for initiative management, project planning, and progress tracking.
 */

import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { InitiativeController } from '../../../../server/src/controllers/InitiativeController.js';
import { setupStandardTest } from '../../../helpers/unifiedMockSetup.js';

// Mock services
vi.mock('../../../../server/services/initiativeService.js', () => ({
    getInitiativesForOrganization: vi.fn(),
    getInitiativeById: vi.fn(),
    createInitiative: vi.fn(),
    updateInitiative: vi.fn(),
    updateInitiativeStatus: vi.fn()
}));

const mockInitiativeService = await import('../../../../server/services/initiativeService.js');

describe('InitiativeController', () => {
    let mockReq;
    let mockRes;

    beforeEach(() => {
        // Setup request/response mocks
        mockReq = {
            user: {
                id: 'user-123',
                organizationId: 'org-456'
            },
            params: {},
            query: {},
            body: {}
        };

        mockRes = {
            status: vi.fn().mockReturnThis(),
            json: vi.fn().mockReturnThis(),
            send: vi.fn().mockReturnThis()
        };
    });

    afterEach(() => {
        vi.clearAllMocks();
    });

    describe('getInitiatives()', () => {
        it('should retrieve initiatives for organization', async () => {
            const mockInitiatives = [
                {
                    id: 'init-1',
                    title: 'Digital Transformation',
                    status: 'EXECUTING',
                    progress_percentage: 65,
                    start_date: '2024-01-01',
                    end_date: '2024-06-30'
                },
                {
                    id: 'init-2',
                    title: 'Cost Optimization',
                    status: 'PLANNING',
                    progress_percentage: 10,
                    start_date: '2024-02-01',
                    end_date: '2024-08-31'
                }
            ];

            mockInitiativeService.getInitiativesForOrganization.mockResolvedValue(mockInitiatives);

            await InitiativeController.getInitiatives(mockReq, mockRes);

            expect(mockInitiativeService.getInitiativesForOrganization).toHaveBeenCalledWith('org-456', undefined, undefined);
            expect(mockRes.json).toHaveBeenCalledWith({
                initiatives: mockInitiatives,
                total: 2
            });
        });

        it('should support pagination', async () => {
            mockReq.query.limit = '10';
            mockReq.query.offset = '20';

            mockInitiativeService.getInitiativesForOrganization.mockResolvedValue([]);

            await InitiativeController.getInitiatives(mockReq, mockRes);

            expect(mockInitiativeService.getInitiativesForOrganization).toHaveBeenCalledWith('org-456', 10, 20);
        });

        it('should return 401 when user has no organization', async () => {
            mockReq.user.organizationId = null;

            await InitiativeController.getInitiatives(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(401);
            expect(mockRes.json).toHaveBeenCalledWith({ error: 'Unauthorized' });
            expect(mockInitiativeService.getInitiativesForOrganization).not.toHaveBeenCalled();
        });

        it('should handle service errors', async () => {
            const serviceError = new Error('Database query failed');
            mockInitiativeService.getInitiativesForOrganization.mockRejectedValue(serviceError);

            await InitiativeController.getInitiatives(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(500);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'Failed to retrieve initiatives',
                details: serviceError.message
            });
        });
    });

    describe('getInitiativeById()', () => {
        it('should retrieve specific initiative by ID', async () => {
            mockReq.params.id = 'init-789';
            const mockInitiative = {
                id: 'init-789',
                title: 'Process Automation',
                description: 'Automate manual processes',
                status: 'EXECUTING',
                progress_percentage: 75,
                owner_id: 'user-123',
                start_date: '2024-01-15',
                end_date: '2024-07-15',
                created_at: '2024-01-01T00:00:00Z'
            };

            mockInitiativeService.getInitiativeById.mockResolvedValue(mockInitiative);

            await InitiativeController.getInitiativeById(mockReq, mockRes);

            expect(mockInitiativeService.getInitiativeById).toHaveBeenCalledWith('init-789', 'org-456');
            expect(mockRes.json).toHaveBeenCalledWith({ initiative: mockInitiative });
        });

        it('should return 404 when initiative not found', async () => {
            mockReq.params.id = 'non-existent';

            mockInitiativeService.getInitiativeById.mockResolvedValue(null);

            await InitiativeController.getInitiativeById(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(404);
            expect(mockRes.json).toHaveBeenCalledWith({ error: 'Initiative not found' });
        });

        it('should allow admin to view initiatives from other organizations', async () => {
            mockReq.params.id = 'init-999';
            mockReq.user.organizationId = 'org-admin';

            const mockInitiative = {
                id: 'init-999',
                title: 'Cross-org Initiative',
                organization_id: 'org-different'
            };

            mockInitiativeService.getInitiativeById.mockResolvedValue(mockInitiative);

            await InitiativeController.getInitiativeById(mockReq, mockRes);

            expect(mockInitiativeService.getInitiativeById).toHaveBeenCalledWith('init-999', 'org-admin');
        });

        it('should handle service errors', async () => {
            mockReq.params.id = 'init-123';
            const serviceError = new Error('Initiative retrieval failed');
            mockInitiativeService.getInitiativeById.mockRejectedValue(serviceError);

            await InitiativeController.getInitiativeById(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(500);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'Failed to retrieve initiative',
                details: serviceError.message
            });
        });
    });

    describe('createInitiative()', () => {
        it('should create new initiative', async () => {
            mockReq.body = {
                title: 'New Digital Initiative',
                description: 'Modernize our digital infrastructure',
                project_id: 'proj-123',
                owner_id: 'user-456',
                start_date: '2024-03-01',
                end_date: '2024-09-30',
                cost_capex: 50000,
                summary: 'Digital transformation project'
            };

            const mockCreatedInitiative = {
                id: 'init-new',
                ...mockReq.body,
                status: 'PLANNING',
                progress_percentage: 0,
                created_at: new Date().toISOString()
            };

            mockInitiativeService.createInitiative.mockResolvedValue(mockCreatedInitiative);

            await InitiativeController.createInitiative(mockReq, mockRes);

            expect(mockInitiativeService.createInitiative).toHaveBeenCalledWith({
                organization_id: 'org-456',
                created_by: 'user-123',
                ...mockReq.body
            });
            expect(mockRes.status).toHaveBeenCalledWith(201);
            expect(mockRes.json).toHaveBeenCalledWith(mockCreatedInitiative);
        });

        it('should validate required fields', async () => {
            mockReq.body = {
                description: 'Missing title and dates'
            };

            await InitiativeController.createInitiative(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(400);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'Title, start date, and end date are required'
            });
        });

        it('should validate date logic', async () => {
            mockReq.body = {
                title: 'Invalid Dates',
                start_date: '2024-06-01',
                end_date: '2024-03-01' // End before start
            };

            await InitiativeController.createInitiative(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(400);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'End date must be after start date'
            });
        });

        it('should handle service errors', async () => {
            mockReq.body = {
                title: 'Valid Initiative',
                start_date: '2024-01-01',
                end_date: '2024-12-31'
            };

            const serviceError = new Error('Failed to create initiative');
            mockInitiativeService.createInitiative.mockRejectedValue(serviceError);

            await InitiativeController.createInitiative(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(500);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'Failed to create initiative',
                details: serviceError.message
            });
        });
    });

    describe('updateInitiative()', () => {
        it('should update initiative details', async () => {
            mockReq.params.id = 'init-111';
            mockReq.body = {
                title: 'Updated Initiative Title',
                description: 'Updated description',
                progress_percentage: 85,
                status: 'IN_PROGRESS'
            };

            mockInitiativeService.updateInitiative.mockResolvedValue(true);

            await InitiativeController.updateInitiative(mockReq, mockRes);

            expect(mockInitiativeService.updateInitiative).toHaveBeenCalledWith('init-111', mockReq.body, 'org-456');
            expect(mockRes.json).toHaveBeenCalledWith({
                message: 'Initiative updated successfully'
            });
        });

        it('should return 404 when initiative not found', async () => {
            mockReq.params.id = 'init-999';
            mockReq.body = { title: 'Update' };

            mockInitiativeService.updateInitiative.mockResolvedValue(false);

            await InitiativeController.updateInitiative(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(404);
            expect(mockRes.json).toHaveBeenCalledWith({ error: 'Initiative not found' });
        });

        it('should validate progress percentage range', async () => {
            mockReq.params.id = 'init-123';
            mockReq.body = { progress_percentage: 150 }; // Invalid: > 100

            await InitiativeController.updateInitiative(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(400);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'Progress percentage must be between 0 and 100'
            });
        });

        it('should validate status values', async () => {
            mockReq.params.id = 'init-123';
            mockReq.body = { status: 'INVALID_STATUS' };

            await InitiativeController.updateInitiative(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(400);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'Invalid status value'
            });
        });

        it('should handle service errors', async () => {
            mockReq.params.id = 'init-123';
            mockReq.body = { title: 'Updated Title' };

            const serviceError = new Error('Update failed');
            mockInitiativeService.updateInitiative.mockRejectedValue(serviceError);

            await InitiativeController.updateInitiative(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(500);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'Failed to update initiative',
                details: serviceError.message
            });
        });
    });

    describe('updateInitiativeStatus()', () => {
        it('should update initiative status', async () => {
            mockReq.params.id = 'init-222';
            mockReq.body = { status: 'DONE' };

            mockInitiativeService.updateInitiativeStatus.mockResolvedValue(true);

            await InitiativeController.updateInitiativeStatus(mockReq, mockRes);

            expect(mockInitiativeService.updateInitiativeStatus).toHaveBeenCalledWith('init-222', 'DONE', 'org-456');
            expect(mockRes.json).toHaveBeenCalledWith({
                message: 'Initiative status updated successfully',
                newStatus: 'DONE'
            });
        });

        it('should return 404 when initiative not found', async () => {
            mockReq.params.id = 'init-999';
            mockReq.body = { status: 'CANCELLED' };

            mockInitiativeService.updateInitiativeStatus.mockResolvedValue(false);

            await InitiativeController.updateInitiativeStatus(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(404);
            expect(mockRes.json).toHaveBeenCalledWith({ error: 'Initiative not found' });
        });

        it('should validate status transitions', async () => {
            mockReq.params.id = 'init-123';
            mockReq.body = { status: 'INVALID_TRANSITION' };

            await InitiativeController.updateInitiativeStatus(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(400);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'Invalid status value'
            });
        });

        it('should require status field', async () => {
            mockReq.params.id = 'init-123';
            mockReq.body = {}; // Missing status

            await InitiativeController.updateInitiativeStatus(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(400);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'Status is required'
            });
        });

        it('should handle service errors', async () => {
            mockReq.params.id = 'init-123';
            mockReq.body = { status: 'PLANNING' };

            const serviceError = new Error('Status update failed');
            mockInitiativeService.updateInitiativeStatus.mockRejectedValue(serviceError);

            await InitiativeController.updateInitiativeStatus(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(500);
            expect(mockRes.json).toHaveBeenCalledWith({
                error: 'Failed to update initiative status',
                details: serviceError.message
            });
        });
    });

    describe('Business Logic Validation', () => {
        it('should enforce organization boundaries', async () => {
            mockReq.params.id = 'init-cross-org';
            mockReq.user.organizationId = 'org-different';

            mockInitiativeService.getInitiativeById.mockResolvedValue(null); // Not accessible

            await InitiativeController.getInitiativeById(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(404);
            expect(mockRes.json).toHaveBeenCalledWith({ error: 'Initiative not found' });
        });

        it('should validate business rules for initiative creation', async () => {
            mockReq.body = {
                title: 'Business Rule Test',
                start_date: '2024-01-01',
                end_date: '2024-01-02',
                cost_capex: -1000 // Invalid negative cost
            };

            await InitiativeController.createInitiative(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(400);
            // Should validate business rules like positive costs
        });

        it('should track initiative lifecycle changes', async () => {
            // Status changes should be auditable
            mockReq.params.id = 'init-audit';
            mockReq.body = { status: 'DONE' };

            mockInitiativeService.updateInitiativeStatus.mockResolvedValue(true);

            await InitiativeController.updateInitiativeStatus(mockReq, mockRes);

            expect(mockInitiativeService.updateInitiativeStatus).toHaveBeenCalledWith('init-audit', 'DONE', 'org-456');
            // In real implementation, this should create audit trail
        });
    });

    describe('Performance & Data Integrity', () => {
        it('should handle large initiative datasets', async () => {
            const largeDataset = Array(100).fill().map((_, i) => ({
                id: `init-${i}`,
                title: `Initiative ${i}`,
                status: 'PLANNING',
                progress_percentage: Math.floor(Math.random() * 100)
            }));

            mockInitiativeService.getInitiativesForOrganization.mockResolvedValue(largeDataset);

            const startTime = Date.now();
            await InitiativeController.getInitiatives(mockReq, mockRes);
            const endTime = Date.now();

            expect(endTime - startTime).toBeLessThan(500); // Should process within reasonable time
            expect(mockRes.json).toHaveBeenCalled();
        });

        it('should maintain data consistency across operations', async () => {
            // Create operation
            mockReq.body = {
                title: 'Consistency Test',
                start_date: '2024-01-01',
                end_date: '2024-12-31'
            };

            const createdInitiative = {
                id: 'init-consistent',
                ...mockReq.body,
                organization_id: 'org-456'
            };

            mockInitiativeService.createInitiative.mockResolvedValue(createdInitiative);

            await InitiativeController.createInitiative(mockReq, mockRes);

            expect(mockRes.status).toHaveBeenCalledWith(201);

            // Subsequent read should return consistent data
            mockInitiativeService.getInitiativeById.mockResolvedValue(createdInitiative);

            mockReq.params.id = 'init-consistent';
            await InitiativeController.getInitiativeById(mockReq, mockRes);

            expect(mockRes.json).toHaveBeenCalledWith({ initiative: createdInitiative });
        });

        it('should implement optimistic locking for concurrent updates', async () => {
            // Multiple users updating same initiative
            mockReq.params.id = 'init-concurrent';
            mockReq.body = { progress_percentage: 50 };

            mockInitiativeService.updateInitiative.mockResolvedValue(true);

            // Simulate concurrent operations
            await Promise.all([
                InitiativeController.updateInitiative(mockReq, mockRes),
                InitiativeController.updateInitiative(mockReq, mockRes)
            ]);

            // Should handle concurrency gracefully
            expect(mockInitiativeService.updateInitiative).toHaveBeenCalledTimes(2);
        });
    });
});



