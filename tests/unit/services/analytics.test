/**
 * Analytics Service Tests
 * 
 * Tests for analytics calculation service.
 */

import { describe, it, expect } from 'vitest';
import { calculateAnalytics, generateBurnDownData, generateVelocityData } from '../../../services/analytics';
import { FullInitiative, Task, InitiativeStatus, TaskStatus } from '../../../types';

describe('Analytics Service', () => {
    const mockInitiatives: FullInitiative[] = [
        {
            id: 'init-1',
            title: 'Initiative 1',
            status: InitiativeStatus.DONE,
            capex: 10000,
            firstYearOpex: 5000,
            annualBenefit: 20000,
            roi: 33.33
        } as FullInitiative,
        {
            id: 'init-2',
            title: 'Initiative 2',
            status: InitiativeStatus.EXECUTING,
            capex: 5000,
            firstYearOpex: 2000,
            annualBenefit: 15000,
            roi: 114.29
        } as FullInitiative
    ];

    const mockTasks: Task[] = [
        {
            id: 'task-1',
            title: 'Task 1',
            status: TaskStatus.DONE,
            createdAt: new Date().toISOString()
        } as Task,
        {
            id: 'task-2',
            title: 'Task 2',
            status: TaskStatus.IN_PROGRESS,
            createdAt: new Date().toISOString()
        } as Task,
        {
            id: 'task-3',
            title: 'Task 3',
            status: TaskStatus.TODO,
            createdAt: new Date().toISOString()
        } as Task
    ];

    describe('calculateAnalytics', () => {
        it('should calculate total initiatives', () => {
            const analytics = calculateAnalytics(mockInitiatives, mockTasks);

            expect(analytics.totalInitiatives).toBe(2);
        });

        it('should calculate completed initiatives', () => {
            const analytics = calculateAnalytics(mockInitiatives, mockTasks);

            expect(analytics.completedInitiatives).toBe(1);
        });

        it('should calculate in-progress initiatives', () => {
            const analytics = calculateAnalytics(mockInitiatives, mockTasks);

            expect(analytics.inProgressInitiatives).toBe(1);
        });

        it('should calculate total tasks', () => {
            const analytics = calculateAnalytics(mockInitiatives, mockTasks);

            expect(analytics.totalTasks).toBe(3);
        });

        it('should calculate completed tasks', () => {
            const analytics = calculateAnalytics(mockInitiatives, mockTasks);

            expect(analytics.completedTasks).toBe(1);
        });

        it('should calculate completion rate', () => {
            const analytics = calculateAnalytics(mockInitiatives, mockTasks);

            expect(analytics.completionRate).toBeCloseTo(33.33, 1);
        });

        it('should calculate total cost', () => {
            const analytics = calculateAnalytics(mockInitiatives, mockTasks);

            expect(analytics.totalCost).toBe(22000); // 10000+5000+5000+2000
        });

        it('should calculate total benefit', () => {
            const analytics = calculateAnalytics(mockInitiatives, mockTasks);

            expect(analytics.totalBenefit).toBe(35000); // 20000+15000
        });

        it('should calculate average ROI', () => {
            const analytics = calculateAnalytics(mockInitiatives, mockTasks);

            expect(analytics.averageInitiativeROI).toBeCloseTo(73.81, 1);
        });

        it('should handle empty arrays', () => {
            const analytics = calculateAnalytics([], []);

            expect(analytics.totalInitiatives).toBe(0);
            expect(analytics.totalTasks).toBe(0);
            expect(analytics.completionRate).toBe(0);
            expect(analytics.averageInitiativeROI).toBe(0);
        });
    });

    describe('generateBurnDownData', () => {
        it('should generate burn-down data', () => {
            const startDate = new Date('2024-01-01');
            const endDate = new Date('2024-01-29'); // 4 weeks

            const data = generateBurnDownData(mockTasks, startDate, endDate);

            expect(Array.isArray(data)).toBe(true);
            expect(data.length).toBeGreaterThan(0);
        });

        it('should include week labels', () => {
            const startDate = new Date('2024-01-01');
            const endDate = new Date('2024-01-29');

            const data = generateBurnDownData(mockTasks, startDate, endDate);

            expect(data[0].week).toMatch(/^W\d+$/);
        });

        it('should calculate ideal burn-down', () => {
            const startDate = new Date('2024-01-01');
            const endDate = new Date('2024-01-29');

            const data = generateBurnDownData(mockTasks, startDate, endDate);

            expect(data[0].ideal).toBeGreaterThanOrEqual(0);
            expect(data[data.length - 1].ideal).toBeCloseTo(0, 0);
        });

        it('should calculate actual burn-down', () => {
            const startDate = new Date('2024-01-01');
            const endDate = new Date('2024-01-29');

            const data = generateBurnDownData(mockTasks, startDate, endDate);

            expect(data[0].actual).toBeGreaterThanOrEqual(0);
        });
    });

    describe('generateVelocityData', () => {
        it('should generate velocity data', () => {
            const data = generateVelocityData(mockTasks, 8);

            expect(Array.isArray(data)).toBe(true);
            expect(data.length).toBe(8);
        });

        it('should include week labels', () => {
            const data = generateVelocityData(mockTasks, 4);

            expect(data[0].week).toBeDefined();
        });

        it('should calculate completed tasks per week', () => {
            const data = generateVelocityData(mockTasks, 4);

            expect(data[0].completed).toBeGreaterThanOrEqual(0);
        });

        it('should calculate target tasks per week', () => {
            const data = generateVelocityData(mockTasks, 4);

            expect(data[0].target).toBeGreaterThan(0);
        });
    });
});















