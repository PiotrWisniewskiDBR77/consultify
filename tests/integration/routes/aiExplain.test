// AI Explainability Routes Integration Tests
// Tests AI explanation and evidence ledger services for audit and transparency

const request = require('supertest');
const app = require('../../../server/server');
const { sequelize } = require('../../../server/models');
const { User, Organization, Project } = require('../../../server/models');

describe('AI Explainability Routes Integration Tests', () => {
    let testUser;
    let testOrg;
    let testAdminUser;
    let testProject;
    let authToken;
    let adminAuthToken;

    beforeAll(async () => {
        // Create test data
        testOrg = await Organization.create({
            name: 'Test AI Explain Org',
            domain: 'ai-explain-test.com'
        });

        testUser = await User.create({
            firstName: 'Explain',
            lastName: 'TestUser',
            email: 'explain@test.com',
            organizationId: testOrg.id,
            password: 'hashedpassword',
            role: 'USER'
        });

        testAdminUser = await User.create({
            firstName: 'Admin',
            lastName: 'ExplainUser',
            email: 'admin-explain@test.com',
            organizationId: testOrg.id,
            password: 'hashedpassword',
            role: 'ADMIN'
        });

        testProject = await Project.create({
            name: 'AI Explain Test Project',
            organizationId: testOrg.id,
            ownerId: testUser.id,
            status: 'active'
        });

        // Mock JWT tokens
        authToken = 'mock-jwt-token-for-explain-user';
        adminAuthToken = 'mock-jwt-token-for-explain-admin';
    });

    afterAll(async () => {
        await sequelize.close();
    });

    describe('GET /api/ai/explain/evidences', () => {
        it('should return evidence list for admin users', async () => {
            const response = await request(app)
                .get('/api/ai/explain/evidences')
                .set('Authorization', adminAuthToken);

            expect(response.status).toBe(200);
            expect(Array.isArray(response.body)).toBe(true);
        });

        it('should filter evidences by type', async () => {
            const response = await request(app)
                .get('/api/ai/explain/evidences')
                .set('Authorization', adminAuthToken)
                .query({ type: 'decision' });

            expect(response.status).toBe(200);
            expect(Array.isArray(response.body)).toBe(true);

            // All returned evidences should be of the requested type
            response.body.forEach(evidence => {
                expect(evidence.type).toBe('decision');
            });
        });

        it('should filter evidences by source', async () => {
            const response = await request(app)
                .get('/api/ai/explain/evidences')
                .set('Authorization', adminAuthToken)
                .query({ source: 'ai_recommendation' });

            expect(response.status).toBe(200);
            expect(Array.isArray(response.body)).toBe(true);

            response.body.forEach(evidence => {
                expect(evidence.source).toBe('ai_recommendation');
            });
        });

        it('should limit results when specified', async () => {
            const response = await request(app)
                .get('/api/ai/explain/evidences')
                .set('Authorization', adminAuthToken)
                .query({ limit: 5 });

            expect(response.status).toBe(200);
            expect(Array.isArray(response.body)).toBe(true);
            expect(response.body.length).toBeLessThanOrEqual(5);
        });

        it('should deny access to non-admin users', async () => {
            const response = await request(app)
                .get('/api/ai/explain/evidences')
                .set('Authorization', authToken);

            expect(response.status).toBe(403);
            expect(response.body).toHaveProperty('error');
            expect(response.body.error).toContain('Admin access required');
        });

        it('should return 401 without authentication', async () => {
            const response = await request(app)
                .get('/api/ai/explain/evidences');

            expect(response.status).toBe(401);
        });

        it('should include evidence metadata', async () => {
            const response = await request(app)
                .get('/api/ai/explain/evidences')
                .set('Authorization', adminAuthToken);

            expect(response.status).toBe(200);

            if (response.body.length > 0) {
                const evidence = response.body[0];
                expect(evidence).toHaveProperty('id');
                expect(evidence).toHaveProperty('type');
                expect(evidence).toHaveProperty('source');
                expect(evidence).toHaveProperty('entityId');
                expect(evidence).toHaveProperty('entityType');
                expect(evidence).toHaveProperty('createdAt');
                expect(evidence).toHaveProperty('confidence');
                expect(evidence).toHaveProperty('explanation');
            }
        });
    });

    describe('GET /api/ai/explain/:entityType/:entityId', () => {
        it('should return explanations for valid entity types', async () => {
            const validEntityTypes = ['proposal', 'decision', 'execution', 'run_step', 'playbook_run'];

            for (const entityType of validEntityTypes) {
                const response = await request(app)
                    .get(`/api/ai/explain/${entityType}/test-entity-123`)
                    .set('Authorization', authToken);

                // Should either return data (200) or indicate not found (404)
                expect([200, 404]).toContain(response.status);

                if (response.status === 200) {
                    expect(response.body).toHaveProperty('entityId', 'test-entity-123');
                    expect(response.body).toHaveProperty('entityType', entityType);
                    expect(response.body).toHaveProperty('explanations');
                    expect(Array.isArray(response.body.explanations)).toBe(true);
                }
            }
        });

        it('should reject invalid entity types', async () => {
            const response = await request(app)
                .get('/api/ai/explain/invalid_type/test-entity-123')
                .set('Authorization', authToken);

            expect(response.status).toBe(400);
            expect(response.body).toHaveProperty('error');
            expect(response.body.error).toContain('Invalid entity type');
        });

        it('should return comprehensive explanations', async () => {
            // Create a test scenario that should have explanations
            const response = await request(app)
                .get(`/api/ai/explain/decision/test-decision-123`)
                .set('Authorization', authToken);

            if (response.status === 200) {
                const data = response.body;

                expect(data).toHaveProperty('entityId');
                expect(data).toHaveProperty('entityType');
                expect(data).toHaveProperty('explanations');

                if (data.explanations.length > 0) {
                    const explanation = data.explanations[0];
                    expect(explanation).toHaveProperty('id');
                    expect(explanation).toHaveProperty('type');
                    expect(explanation).toHaveProperty('title');
                    expect(explanation).toHaveProperty('description');
                    expect(explanation).toHaveProperty('confidence');
                    expect(explanation).toHaveProperty('evidence');
                    expect(explanation).toHaveProperty('methodology');
                    expect(explanation).toHaveProperty('createdAt');
                }
            }
        });

        it('should include evidence chains', async () => {
            const response = await request(app)
                .get(`/api/ai/explain/execution/test-execution-123`)
                .set('Authorization', authToken);

            if (response.status === 200) {
                const data = response.body;

                if (data.explanations && data.explanations.length > 0) {
                    const explanation = data.explanations[0];

                    if (explanation.evidence) {
                        expect(Array.isArray(explanation.evidence)).toBe(true);

                        explanation.evidence.forEach(evidence => {
                            expect(evidence).toHaveProperty('type');
                            expect(evidence).toHaveProperty('description');
                            expect(evidence).toHaveProperty('weight');
                            expect(evidence).toHaveProperty('source');
                        });
                    }
                }
            }
        });

        it('should return 404 for non-existent entities', async () => {
            const response = await request(app)
                .get('/api/ai/explain/decision/non-existent-entity')
                .set('Authorization', authToken);

            expect(response.status).toBe(404);
            expect(response.body).toHaveProperty('error', 'Entity not found');
        });

        it('should enforce access control based on entity ownership', async () => {
            // This would require setting up entities in different organizations
            // For now, just verify the endpoint exists and handles auth
            const response = await request(app)
                .get('/api/ai/explain/proposal/test-proposal-123')
                .set('Authorization', authToken);

            expect([200, 404]).toContain(response.status);
        });
    });

    describe('GET /api/ai/explain/:entityType/:entityId/evidence', () => {
        it('should return detailed evidence for entity', async () => {
            const response = await request(app)
                .get('/api/ai/explain/decision/test-decision-123/evidence')
                .set('Authorization', authToken);

            expect([200, 404]).toContain(response.status);

            if (response.status === 200) {
                expect(response.body).toHaveProperty('entityId', 'test-decision-123');
                expect(response.body).toHaveProperty('entityType', 'decision');
                expect(response.body).toHaveProperty('evidenceChain');
                expect(Array.isArray(response.body.evidenceChain)).toBe(true);
            }
        });

        it('should include complete evidence metadata', async () => {
            const response = await request(app)
                .get('/api/ai/explain/execution/test-execution-123/evidence')
                .set('Authorization', authToken);

            if (response.status === 200) {
                const evidenceChain = response.body.evidenceChain;

                evidenceChain.forEach(evidence => {
                    expect(evidence).toHaveProperty('id');
                    expect(evidence).toHaveProperty('type');
                    expect(evidence).toHaveProperty('source');
                    expect(evidence).toHaveProperty('timestamp');
                    expect(evidence).toHaveProperty('data');
                    expect(evidence).toHaveProperty('validationStatus');
                    expect(evidence).toHaveProperty('confidence');
                });
            }
        });

        it('should validate evidence integrity', async () => {
            const response = await request(app)
                .get('/api/ai/explain/playbook_run/test-run-123/evidence')
                .set('Authorization', authToken);

            if (response.status === 200) {
                const evidenceChain = response.body.evidenceChain;

                evidenceChain.forEach(evidence => {
                    // Evidence should have integrity checks
                    expect(evidence).toHaveProperty('hash');
                    expect(evidence).toHaveProperty('signature');
                    expect(evidence.validationStatus).toMatch(/valid|invalid|pending/);
                });
            }
        });
    });

    describe('POST /api/ai/explain/:entityType/:entityId/validate', () => {
        it('should validate AI explanations for audit', async () => {
            const response = await request(app)
                .post('/api/ai/explain/decision/test-decision-123/validate')
                .set('Authorization', authToken)
                .send({
                    auditorId: testUser.id,
                    validationCriteria: ['accuracy', 'completeness', 'bias_check'],
                    notes: 'Audit validation request'
                });

            expect([200, 404]).toContain(response.status);

            if (response.status === 200) {
                expect(response.body).toHaveProperty('validationId');
                expect(response.body).toHaveProperty('status', 'pending');
                expect(response.body).toHaveProperty('requestedBy', testUser.id);
                expect(response.body).toHaveProperty('requestedAt');
            }
        });

        it('should require validation criteria', async () => {
            const response = await request(app)
                .post('/api/ai/explain/decision/test-decision-123/validate')
                .set('Authorization', authToken)
                .send({});

            expect(response.status).toBe(400);
            expect(response.body).toHaveProperty('error');
            expect(response.body.error).toContain('validation criteria');
        });

        it('should support different validation types', async () => {
            const validationTypes = [
                ['accuracy'],
                ['completeness', 'bias_check'],
                ['fairness', 'transparency', 'accountability']
            ];

            for (const criteria of validationTypes) {
                const response = await request(app)
                    .post('/api/ai/explain/decision/test-decision-123/validate')
                    .set('Authorization', authToken)
                    .send({
                        auditorId: testUser.id,
                        validationCriteria: criteria
                    });

                expect([200, 400, 404]).toContain(response.status);
            }
        });
    });

    describe('GET /api/ai/explain/validation/:validationId', () => {
        it('should return validation results', async () => {
            // First create a validation request
            const createResponse = await request(app)
                .post('/api/ai/explain/decision/test-decision-123/validate')
                .set('Authorization', authToken)
                .send({
                    auditorId: testUser.id,
                    validationCriteria: ['accuracy']
                });

            if (createResponse.status === 200) {
                const validationId = createResponse.body.validationId;

                const response = await request(app)
                    .get(`/api/ai/explain/validation/${validationId}`)
                    .set('Authorization', authToken);

                expect(response.status).toBe(200);
                expect(response.body).toHaveProperty('validationId', validationId);
                expect(response.body).toHaveProperty('status');
                expect(response.body).toHaveProperty('results');
            }
        });

        it('should include detailed validation results', async () => {
            const validationId = 'test-validation-123';

            const response = await request(app)
                .get(`/api/ai/explain/validation/${validationId}`)
                .set('Authorization', authToken);

            if (response.status === 200) {
                const results = response.body.results;

                if (results && results.length > 0) {
                    results.forEach(result => {
                        expect(result).toHaveProperty('criteria');
                        expect(result).toHaveProperty('status');
                        expect(result).toHaveProperty('score');
                        expect(result).toHaveProperty('issues');
                        expect(result).toHaveProperty('recommendations');
                    });
                }
            }
        });
    });

    describe('GET /api/ai/explain/export/:entityType/:entityId', () => {
        it('should export explanation evidence pack', async () => {
            const response = await request(app)
                .get('/api/ai/explain/export/decision/test-decision-123')
                .set('Authorization', authToken)
                .query({ format: 'pdf' });

            expect([200, 404]).toContain(response.status);

            if (response.status === 200) {
                expect(response.headers['content-type']).toContain('application/pdf');
                expect(response.headers['content-disposition']).toContain('attachment');
                expect(response.headers['content-disposition']).toContain('evidence-pack');
            }
        });

        it('should support multiple export formats', async () => {
            const formats = ['pdf', 'json', 'xml'];

            for (const format of formats) {
                const response = await request(app)
                    .get('/api/ai/explain/export/proposal/test-proposal-123')
                    .set('Authorization', authToken)
                    .query({ format });

                expect([200, 404]).toContain(response.status);

                if (response.status === 200) {
                    if (format === 'pdf') {
                        expect(response.headers['content-type']).toContain('application/pdf');
                    } else if (format === 'json') {
                        expect(response.headers['content-type']).toContain('application/json');
                    } else if (format === 'xml') {
                        expect(response.headers['content-type']).toContain('application/xml');
                    }
                }
            }
        });

        it('should include all required evidence for audit', async () => {
            const response = await request(app)
                .get('/api/ai/explain/export/execution/test-execution-123')
                .set('Authorization', authToken)
                .query({ format: 'json' });

            if (response.status === 200) {
                const exportData = response.body;

                expect(exportData).toHaveProperty('entityId');
                expect(exportData).toHaveProperty('entityType');
                expect(exportData).toHaveProperty('exportTimestamp');
                expect(exportData).toHaveProperty('evidencePack');
                expect(exportData).toHaveProperty('validationResults');
                expect(exportData).toHaveProperty('auditTrail');
            }
        });
    });

    describe('Evidence Ledger Integrity', () => {
        it('should maintain evidence chain integrity', async () => {
            const response = await request(app)
                .get('/api/ai/explain/decision/test-decision-123/evidence')
                .set('Authorization', authToken);

            if (response.status === 200) {
                const evidenceChain = response.body.evidenceChain;

                // Check chain continuity
                for (let i = 1; i < evidenceChain.length; i++) {
                    const current = evidenceChain[i];
                    const previous = evidenceChain[i - 1];

                    // Each evidence should reference the previous one
                    expect(current.previousEvidenceId).toBe(previous.id);
                }
            }
        });

        it('should detect evidence tampering', async () => {
            // This would require sophisticated mocking of evidence tampering
            // For now, verify that validation mechanisms exist
            const response = await request(app)
                .get('/api/ai/explain/evidences')
                .set('Authorization', adminAuthToken);

            expect(response.status).toBe(200);

            if (response.body.length > 0) {
                response.body.forEach(evidence => {
                    expect(evidence).toHaveProperty('integrityStatus');
                    expect(['valid', 'compromised', 'unknown']).toContain(evidence.integrityStatus);
                });
            }
        });

        it('should provide tamper-proof audit trail', async () => {
            const response = await request(app)
                .get('/api/ai/explain/export/playbook_run/test-run-123')
                .set('Authorization', authToken)
                .query({ format: 'json' });

            if (response.status === 200) {
                const exportData = response.body;

                expect(exportData).toHaveProperty('auditTrail');
                expect(Array.isArray(exportData.auditTrail)).toBe(true);

                exportData.auditTrail.forEach(entry => {
                    expect(entry).toHaveProperty('timestamp');
                    expect(entry).toHaveProperty('action');
                    expect(entry).toHaveProperty('actor');
                    expect(entry).toHaveProperty('evidenceHash');
                });
            }
        });
    });

    describe('Performance and Scalability', () => {
        it('should handle large evidence sets efficiently', async () => {
            const startTime = Date.now();

            const response = await request(app)
                .get('/api/ai/explain/evidences')
                .set('Authorization', adminAuthToken)
                .query({ limit: 1000 });

            const endTime = Date.now();
            const duration = endTime - startTime;

            expect(response.status).toBe(200);
            // Should respond within reasonable time even for large datasets
            expect(duration).toBeLessThan(5000);
        });

        it('should cache frequently accessed explanations', async () => {
            const entityId = 'cached-entity-123';

            // First request
            const response1 = await request(app)
                .get(`/api/ai/explain/decision/${entityId}`)
                .set('Authorization', authToken);

            // Second request (should be cached)
            const startTime = Date.now();
            const response2 = await request(app)
                .get(`/api/ai/explain/decision/${entityId}`)
                .set('Authorization', authToken);
            const endTime = Date.now();

            expect(response1.status).toBe(response2.status);

            if (response1.status === 200 && response2.status === 200) {
                // Second request should be faster
                expect(endTime - startTime).toBeLessThan(100);
            }
        });
    });

    describe('Compliance and Standards', () => {
        it('should meet AI explainability standards', async () => {
            const response = await request(app)
                .get('/api/ai/explain/decision/test-decision-123')
                .set('Authorization', authToken);

            if (response.status === 200) {
                const explanation = response.body;

                // Should include required explainability elements
                expect(explanation).toHaveProperty('modelInfo');
                expect(explanation).toHaveProperty('featureImportance');
                expect(explanation).toHaveProperty('decisionPath');
                expect(explanation).toHaveProperty('uncertaintyMetrics');

                // Should comply with GDPR Article 22
                expect(explanation).toHaveProperty('automatedDecisionFlag');
                expect(explanation).toHaveProperty('humanInterventionPossible');
            }
        });

        it('should provide bias detection information', async () => {
            const response = await request(app)
                .get('/api/ai/explain/decision/test-decision-123/evidence')
                .set('Authorization', authToken);

            if (response.status === 200) {
                const evidence = response.body;

                if (evidence.biasAnalysis) {
                    expect(evidence.biasAnalysis).toHaveProperty('detectedBiases');
                    expect(evidence.biasAnalysis).toHaveProperty('fairnessMetrics');
                    expect(evidence.biasAnalysis).toHaveProperty('disparateImpact');
                }
            }
        });

        it('should include model governance information', async () => {
            const response = await request(app)
                .get('/api/ai/explain/evidences')
                .set('Authorization', adminAuthToken);

            expect(response.status).toBe(200);

            if (response.body.length > 0) {
                response.body.forEach(evidence => {
                    expect(evidence).toHaveProperty('modelVersion');
                    expect(evidence).toHaveProperty('trainingDataInfo');
                    expect(evidence).toHaveProperty('lastValidated');
                });
            }
        });
    });
});














