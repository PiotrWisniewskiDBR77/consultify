/**
 * Test Fixtures Helper
 * 
 * Provides utilities for creating complete test data fixtures with all dependencies.
 * Ensures FOREIGN KEY constraints are satisfied.
 */

import { v4 as uuidv4 } from 'uuid';

/**
 * Create a complete test fixture with all required dependencies
 * @param {Object} db - Database instance
 * @param {Object} options - Fixture options
 * @returns {Promise<Object>} Fixture data with orgId, userId, projectId, etc.
 */
export async function createFullTestFixture(db, options = {}) {
    const orgId = options.orgId || `test-org-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
    const userId = options.userId || `test-user-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
    const projectId = options.projectId || `test-proj-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
    
    // Helper to run DB operations
    const dbRun = (sql, params) => {
        return new Promise((resolve, reject) => {
            db.run(sql, params, function(err) {
                if (err && !err.message.includes('UNIQUE constraint')) {
                    reject(err);
                } else {
                    resolve({ lastID: this.lastID, changes: this.changes });
                }
            });
        });
    };
    
    // Create organization
    await dbRun(
        'INSERT OR IGNORE INTO organizations (id, name, plan, status) VALUES (?, ?, ?, ?)',
        [orgId, options.orgName || 'Test Org', options.plan || 'free', options.status || 'active']
    );
    
    // Create user
    await dbRun(
        'INSERT OR IGNORE INTO users (id, organization_id, email, first_name, last_name, role) VALUES (?, ?, ?, ?, ?, ?)',
        [
            userId,
            orgId,
            options.email || `test-${Date.now()}@test.com`,
            options.firstName || 'Test',
            options.lastName || 'User',
            options.role || 'USER'
        ]
    );
    
    // Create project if requested
    if (options.createProject !== false) {
        await dbRun(
            'INSERT OR IGNORE INTO projects (id, organization_id, name, status) VALUES (?, ?, ?, ?)',
            [projectId, orgId, options.projectName || 'Test Project', 'active']
        );
    }
    
    // Create task if requested
    let taskId = null;
    if (options.createTask) {
        taskId = options.taskId || `test-task-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
        await dbRun(
            'INSERT OR IGNORE INTO tasks (id, project_id, organization_id, name, status, assigned_to) VALUES (?, ?, ?, ?, ?, ?)',
            [taskId, projectId, orgId, options.taskName || 'Test Task', 'TODO', userId]
        );
    }
    
    // Create decision if requested
    let decisionId = null;
    if (options.createDecision) {
        decisionId = options.decisionId || `test-dec-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
        await dbRun(
            'INSERT OR IGNORE INTO decisions (id, project_id, organization_id, title, status, decision_owner_id) VALUES (?, ?, ?, ?, ?, ?)',
            [decisionId, projectId, orgId, options.decisionTitle || 'Test Decision', 'PENDING', userId]
        );
    }
    
    // Create initiative if requested
    let initiativeId = null;
    if (options.createInitiative) {
        initiativeId = options.initiativeId || `test-init-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
        await dbRun(
            'INSERT OR IGNORE INTO initiatives (id, project_id, organization_id, name, status) VALUES (?, ?, ?, ?, ?)',
            [initiativeId, projectId, orgId, options.initiativeName || 'Test Initiative', 'PLANNING']
        );
    }
    
    return {
        orgId,
        userId,
        projectId,
        taskId,
        decisionId,
        initiativeId
    };
}

/**
 * Clean up test fixtures
 * @param {Object} db - Database instance
 * @param {Object} fixture - Fixture data to clean
 */
export async function cleanupTestFixture(db, fixture) {
    const dbRun = (sql, params) => {
        return new Promise((resolve, reject) => {
            db.run(sql, params, (err) => {
                if (err && !err.message.includes('no such table')) {
                    reject(err);
                } else {
                    resolve();
                }
            });
        });
    };
    
    // Disable foreign keys for cleanup
    await dbRun('PRAGMA foreign_keys = OFF', []);
    
    try {
        if (fixture.taskId) await dbRun('DELETE FROM tasks WHERE id = ?', [fixture.taskId]);
        if (fixture.decisionId) await dbRun('DELETE FROM decisions WHERE id = ?', [fixture.decisionId]);
        if (fixture.initiativeId) await dbRun('DELETE FROM initiatives WHERE id = ?', [fixture.initiativeId]);
        if (fixture.projectId) await dbRun('DELETE FROM projects WHERE id = ?', [fixture.projectId]);
        if (fixture.userId) await dbRun('DELETE FROM users WHERE id = ?', [fixture.userId]);
        if (fixture.orgId) await dbRun('DELETE FROM organizations WHERE id = ?', [fixture.orgId]);
    } finally {
        await dbRun('PRAGMA foreign_keys = ON', []);
    }
}

export default {
    createFullTestFixture,
    cleanupTestFixture
};










