import React from 'react';
import { screen, waitFor, fireEvent } from '@testing-library/react';
import { renderWithProviders } from '../../../test-utils';
import userEvent from '@testing-library/user-event';
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { BulkUserImport } from '../../../../components/admin/team/BulkUserImport';

// Mock dependencies
vi.mock('../../../../services/api', () => ({
    Api: {
        bulkImportUsers: vi.fn().mockResolvedValue({
            success: 12,
            failed: 2,
            errors: [
                { row: 5, error: 'Invalid email' },
                { row: 8, error: 'Duplicate user' },
            ],
        }),
        validateBulkImport: vi.fn().mockResolvedValue({ valid: true }),
    },
}));

vi.mock('react-hot-toast', () => ({
    default: {
        success: vi.fn(),
        error: vi.fn(),
        loading: vi.fn(),
    },
}));

/**
 * BulkUserImport Component Tests
 * Tests for bulk user import with CSV/Excel support and preview
 * CRITICAL FOR ENTERPRISE USER ONBOARDING
 */
describe('BulkUserImport', () => {
    const defaultProps = {
        organizationId: 'org-1',
        onComplete: vi.fn(),
    };

    beforeEach(() => {
        vi.clearAllMocks();
    });

    afterEach(() => {
        vi.restoreAllMocks();
    });

    describe('Rendering', () => {
        it('should render upload area', () => {
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            expect(screen.getByText(/upload/i)).toBeInTheDocument();
            expect(screen.getByText(/csv|excel/i)).toBeInTheDocument();
        });

        it('should show drag and drop zone', () => {
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            expect(screen.getByTestId('drop-zone')).toBeInTheDocument();
        });

        it('should display template download link', () => {
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            expect(screen.getByText(/download template/i)).toBeInTheDocument();
        });

        it('should show supported formats', () => {
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            expect(screen.getByText(/\.csv/i)).toBeInTheDocument();
            expect(screen.getByText(/\.xlsx/i)).toBeInTheDocument();
        });
    });

    describe('File Upload', () => {
        it('should accept CSV files', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const file = new File(['email,name\ntest@example.com,Test User'], 'users.csv', {
                type: 'text/csv',
            });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            await waitFor(() => {
                expect(screen.getByText('users.csv')).toBeInTheDocument();
            });
        });

        it('should accept Excel files', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const file = new File([''], 'users.xlsx', {
                type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
            });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            await waitFor(() => {
                expect(screen.getByText('users.xlsx')).toBeInTheDocument();
            });
        });

        it('should reject invalid file types', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const file = new File([''], 'users.pdf', { type: 'application/pdf' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            await waitFor(() => {
                expect(screen.getByText(/invalid file type/i)).toBeInTheDocument();
            });
        });

        it('should handle drag and drop', async () => {
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const dropZone = screen.getByTestId('drop-zone');
            const file = new File(['email,name\ntest@example.com,Test'], 'users.csv', {
                type: 'text/csv',
            });

            fireEvent.dragOver(dropZone);
            expect(dropZone).toHaveClass('dragging');

            fireEvent.drop(dropZone, {
                dataTransfer: { files: [file] },
            });

            await waitFor(() => {
                expect(screen.getByText('users.csv')).toBeInTheDocument();
            });
        });
    });

    describe('Preview', () => {
        it('should show preview of parsed data', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'email,firstName,lastName,role\ntest@example.com,Test,User,USER';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            await waitFor(() => {
                expect(screen.getByText('test@example.com')).toBeInTheDocument();
                expect(screen.getByText('Test')).toBeInTheDocument();
                expect(screen.getByText('User')).toBeInTheDocument();
            });
        });

        it('should show row count', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'email,name\na@test.com,A\nb@test.com,B\nc@test.com,C';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            await waitFor(() => {
                expect(screen.getByText(/3 users/i)).toBeInTheDocument();
            });
        });

        it('should highlight validation errors in preview', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'email,name\ninvalid-email,Test\ntest@example.com,';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            await waitFor(() => {
                const errorRow = screen.getByText('invalid-email').closest('tr');
                expect(errorRow).toHaveClass('error');
            });
        });
    });

    describe('Column Mapping', () => {
        it('should auto-detect common column names', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'Email Address,First Name,Last Name,User Role\ntest@test.com,John,Doe,Admin';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            await waitFor(() => {
                expect(screen.getByText(/email.*mapped/i)).toBeInTheDocument();
            });
        });

        it('should allow manual column mapping', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'col1,col2\ntest@test.com,John';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            await waitFor(() => {
                expect(screen.getByText(/map columns/i)).toBeInTheDocument();
            });

            const col1Select = screen.getByTestId('column-map-col1');
            await user.selectOptions(col1Select, 'email');

            expect(col1Select).toHaveValue('email');
        });
    });

    describe('Import Process', () => {
        it('should start import on confirmation', async () => {
            const user = userEvent.setup();
            const { Api } = await import('../../../../services/api');

            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'email,name\ntest@example.com,Test User';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            const importButton = await screen.findByRole('button', { name: /import/i });
            await user.click(importButton);

            await waitFor(() => {
                expect(Api.bulkImportUsers).toHaveBeenCalled();
            });
        });

        it('should show progress during import', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'email,name\ntest@example.com,Test User';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            const importButton = await screen.findByRole('button', { name: /import/i });
            await user.click(importButton);

            expect(screen.getByRole('progressbar')).toBeInTheDocument();
        });

        it('should show results summary after import', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'email,name\ntest@example.com,Test User';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            const importButton = await screen.findByRole('button', { name: /import/i });
            await user.click(importButton);

            await waitFor(() => {
                expect(screen.getByText(/12 users imported/i)).toBeInTheDocument();
                expect(screen.getByText(/2 failed/i)).toBeInTheDocument();
            });
        });

        it('should show error details for failed imports', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'email,name\ntest@example.com,Test User';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            const importButton = await screen.findByRole('button', { name: /import/i });
            await user.click(importButton);

            await waitFor(() => {
                expect(screen.getByText(/row 5.*invalid email/i)).toBeInTheDocument();
                expect(screen.getByText(/row 8.*duplicate/i)).toBeInTheDocument();
            });
        });
    });

    describe('Template Download', () => {
        it('should download CSV template', async () => {
            const user = userEvent.setup();
            const mockDownload = vi.fn();
            global.URL.createObjectURL = vi.fn();

            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const templateLink = screen.getByText(/download template/i);
            await user.click(templateLink);

            expect(global.URL.createObjectURL).toHaveBeenCalled();
        });

        it('should include all required columns in template', async () => {
            const user = userEvent.setup();
            let downloadedContent = '';
            global.URL.createObjectURL = vi.fn().mockImplementation((blob) => {
                blob.text().then((content: string) => {
                    downloadedContent = content;
                });
                return 'blob:url';
            });

            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const templateLink = screen.getByText(/download template/i);
            await user.click(templateLink);

            await waitFor(() => {
                expect(downloadedContent).toContain('email');
                expect(downloadedContent).toContain('firstName');
                expect(downloadedContent).toContain('lastName');
            });
        });
    });

    describe('Validation', () => {
        it('should validate email format', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'email,name\nnot-an-email,Test';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            await waitFor(() => {
                expect(screen.getByText(/invalid email/i)).toBeInTheDocument();
            });
        });

        it('should check for required fields', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'name\nTest User';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            await waitFor(() => {
                expect(screen.getByText(/email.*required/i)).toBeInTheDocument();
            });
        });

        it('should disable import button when validation fails', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'email,name\nnot-valid-email,Test';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            const importButton = await screen.findByRole('button', { name: /import/i });
            expect(importButton).toBeDisabled();
        });
    });

    describe('Accessibility', () => {
        it('should have proper ARIA labels', () => {
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const uploadArea = screen.getByLabelText(/upload/i);
            expect(uploadArea).toHaveAccessibleName();
        });

        it('should announce import progress', async () => {
            const user = userEvent.setup();
            renderWithProviders(<BulkUserImport {...defaultProps} />);

            const csvContent = 'email,name\ntest@example.com,Test';
            const file = new File([csvContent], 'users.csv', { type: 'text/csv' });

            const input = screen.getByLabelText(/upload/i);
            await user.upload(input, file);

            const importButton = await screen.findByRole('button', { name: /import/i });
            await user.click(importButton);

            const liveRegion = screen.getByRole('status');
            expect(liveRegion).toHaveTextContent(/importing/i);
        });
    });
});




