import React from 'react';
import { screen, waitFor, within } from '@testing-library/react';
import { renderWithProviders } from '../../../test-utils';
import userEvent from '@testing-library/user-event';
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { ManagerSelector } from '../../../../components/admin/team/ManagerSelector';

// Mock dependencies
vi.mock('../../../../services/api', () => ({
    Api: {
        getUsers: vi.fn().mockResolvedValue([
            { id: 'user-1', firstName: 'John', lastName: 'Doe', email: 'john@example.com', role: 'ADMIN' },
            { id: 'user-2', firstName: 'Jane', lastName: 'Smith', email: 'jane@example.com', role: 'MANAGER' },
            { id: 'user-3', firstName: 'Bob', lastName: 'Wilson', email: 'bob@example.com', role: 'USER' },
        ]),
        updateUserManager: vi.fn().mockResolvedValue({ success: true }),
        getOrganizationHierarchy: vi.fn().mockResolvedValue({
            root: { id: 'user-1', name: 'John Doe', reports: [
                { id: 'user-2', name: 'Jane Smith', reports: [
                    { id: 'user-3', name: 'Bob Wilson', reports: [] }
                ]}
            ]}
        }),
    },
}));

vi.mock('react-hot-toast', () => ({
    default: {
        success: vi.fn(),
        error: vi.fn(),
    },
}));

/**
 * ManagerSelector Component Tests
 * Tests for manager assignment and organization hierarchy visualization
 * CRITICAL FOR ENTERPRISE ORG STRUCTURE
 */
describe('ManagerSelector', () => {
    const defaultProps = {
        userId: 'user-3',
        currentManagerId: 'user-2',
        onManagerChange: vi.fn(),
    };

    beforeEach(() => {
        vi.clearAllMocks();
    });

    afterEach(() => {
        vi.restoreAllMocks();
    });

    describe('Rendering', () => {
        it('should render manager dropdown', () => {
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            expect(screen.getByLabelText(/manager/i)).toBeInTheDocument();
        });

        it('should display current manager', async () => {
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/jane smith/i)).toBeInTheDocument();
            });
        });

        it('should show organization hierarchy preview', async () => {
            renderWithProviders(<ManagerSelector {...defaultProps} showHierarchy />);

            await waitFor(() => {
                expect(screen.getByTestId('org-hierarchy')).toBeInTheDocument();
            });
        });

        it('should show "No Manager" option', async () => {
            const user = userEvent.setup();
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            await waitFor(() => {
                expect(screen.getByText(/no manager/i)).toBeInTheDocument();
            });
        });
    });

    describe('Manager Selection', () => {
        it('should show available managers', async () => {
            const user = userEvent.setup();
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            await waitFor(() => {
                expect(screen.getByText(/john doe/i)).toBeInTheDocument();
                expect(screen.getByText(/jane smith/i)).toBeInTheDocument();
            });
        });

        it('should not show current user as option', async () => {
            const user = userEvent.setup();
            renderWithProviders(<ManagerSelector {...defaultProps} userId="user-3" />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            await waitFor(() => {
                const dropdown = screen.getByRole('listbox');
                expect(within(dropdown).queryByText(/bob wilson/i)).toBeNull();
            });
        });

        it('should prevent circular hierarchy', async () => {
            const user = userEvent.setup();
            // If user-2 reports to user-3, user-3 shouldn't be able to report to user-2
            renderWithProviders(
                <ManagerSelector {...defaultProps} userId="user-1" currentManagerId={undefined} />
            );

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            await waitFor(() => {
                // Jane reports to John, so John shouldn't see Jane's reports as valid managers
                const dropdown = screen.getByRole('listbox');
                const bobOption = within(dropdown).queryByText(/bob wilson/i);
                if (bobOption) {
                    expect(bobOption.closest('[data-disabled]')).toHaveAttribute('data-disabled', 'true');
                }
            });
        });

        it('should change manager when selected', async () => {
            const user = userEvent.setup();
            const onManagerChange = vi.fn();

            renderWithProviders(
                <ManagerSelector {...defaultProps} onManagerChange={onManagerChange} />
            );

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            const johnOption = await screen.findByText(/john doe/i);
            await user.click(johnOption);

            expect(onManagerChange).toHaveBeenCalledWith('user-1');
        });
    });

    describe('Search', () => {
        it('should filter managers by search term', async () => {
            const user = userEvent.setup();
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            const searchInput = screen.getByPlaceholderText(/search/i);
            await user.type(searchInput, 'john');

            await waitFor(() => {
                expect(screen.getByText(/john doe/i)).toBeInTheDocument();
                expect(screen.queryByText(/jane smith/i)).not.toBeInTheDocument();
            });
        });

        it('should search by email', async () => {
            const user = userEvent.setup();
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            const searchInput = screen.getByPlaceholderText(/search/i);
            await user.type(searchInput, 'jane@');

            await waitFor(() => {
                expect(screen.getByText(/jane smith/i)).toBeInTheDocument();
            });
        });
    });

    describe('Hierarchy Visualization', () => {
        it('should show reporting structure', async () => {
            renderWithProviders(<ManagerSelector {...defaultProps} showHierarchy />);

            await waitFor(() => {
                const hierarchy = screen.getByTestId('org-hierarchy');
                expect(within(hierarchy).getByText(/john doe/i)).toBeInTheDocument();
                expect(within(hierarchy).getByText(/jane smith/i)).toBeInTheDocument();
                expect(within(hierarchy).getByText(/bob wilson/i)).toBeInTheDocument();
            });
        });

        it('should highlight current user in hierarchy', async () => {
            renderWithProviders(<ManagerSelector {...defaultProps} showHierarchy />);

            await waitFor(() => {
                const currentUser = screen.getByTestId('hierarchy-node-user-3');
                expect(currentUser).toHaveClass('highlighted');
            });
        });

        it('should show reporting lines', async () => {
            renderWithProviders(<ManagerSelector {...defaultProps} showHierarchy />);

            await waitFor(() => {
                const lines = screen.getAllByTestId(/hierarchy-line/);
                expect(lines.length).toBeGreaterThan(0);
            });
        });

        it('should expand/collapse hierarchy nodes', async () => {
            const user = userEvent.setup();
            renderWithProviders(<ManagerSelector {...defaultProps} showHierarchy />);

            await waitFor(() => {
                expect(screen.getByTestId('hierarchy-node-user-1')).toBeInTheDocument();
            });

            const johnNode = screen.getByTestId('hierarchy-node-user-1');
            const expandButton = within(johnNode).getByRole('button', { name: /expand|collapse/i });
            await user.click(expandButton);

            // Children should be hidden
            expect(screen.queryByTestId('hierarchy-node-user-2')).not.toBeVisible();
        });
    });

    describe('Direct Reports Preview', () => {
        it('should show direct reports count', async () => {
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            await userEvent.click(select);

            await waitFor(() => {
                const johnOption = screen.getByText(/john doe/i).closest('[role="option"]');
                expect(within(johnOption!).getByText(/1 direct report/i)).toBeInTheDocument();
            });
        });

        it('should show direct reports on hover', async () => {
            const user = userEvent.setup();
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            const johnOption = await screen.findByText(/john doe/i);
            await user.hover(johnOption);

            await waitFor(() => {
                expect(screen.getByText(/jane smith/i)).toBeInTheDocument();
            });
        });
    });

    describe('Save Operation', () => {
        it('should call API on manager change', async () => {
            const user = userEvent.setup();
            const { Api } = await import('../../../../services/api');

            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            const johnOption = await screen.findByText(/john doe/i);
            await user.click(johnOption);

            const saveButton = screen.getByRole('button', { name: /save/i });
            await user.click(saveButton);

            await waitFor(() => {
                expect(Api.updateUserManager).toHaveBeenCalledWith('user-3', 'user-1');
            });
        });

        it('should show success toast on save', async () => {
            const user = userEvent.setup();
            const toast = await import('react-hot-toast');

            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            const johnOption = await screen.findByText(/john doe/i);
            await user.click(johnOption);

            const saveButton = screen.getByRole('button', { name: /save/i });
            await user.click(saveButton);

            await waitFor(() => {
                expect(toast.default.success).toHaveBeenCalled();
            });
        });

        it('should show confirmation for manager change', async () => {
            const user = userEvent.setup();

            renderWithProviders(<ManagerSelector {...defaultProps} requireConfirmation />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            const johnOption = await screen.findByText(/john doe/i);
            await user.click(johnOption);

            const saveButton = screen.getByRole('button', { name: /save/i });
            await user.click(saveButton);

            await waitFor(() => {
                expect(screen.getByText(/confirm.*change/i)).toBeInTheDocument();
            });
        });
    });

    describe('Accessibility', () => {
        it('should have proper ARIA labels', () => {
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            expect(select).toHaveAccessibleName();
        });

        it('should announce selection to screen readers', async () => {
            const user = userEvent.setup();
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);

            const johnOption = await screen.findByText(/john doe/i);
            await user.click(johnOption);

            const liveRegion = screen.getByRole('status');
            expect(liveRegion).toHaveTextContent(/selected.*john doe/i);
        });

        it('should support keyboard navigation', async () => {
            const user = userEvent.setup();
            renderWithProviders(<ManagerSelector {...defaultProps} />);

            const select = screen.getByLabelText(/manager/i);
            await user.click(select);
            await user.keyboard('{ArrowDown}');
            await user.keyboard('{Enter}');

            // First option should be selected
            expect(select).toHaveTextContent(/john doe/i);
        });
    });
});




