import React from 'react';
import { screen, waitFor, within } from '@testing-library/react';
import { renderWithProviders } from '../../../test-utils';
import userEvent from '@testing-library/user-event';
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { GDPRComplianceDashboard } from '../../../../components/admin/compliance/GDPRComplianceDashboard';

// Mock dependencies
vi.mock('../../../../services/api', () => ({
    Api: {
        getGDPRStatus: vi.fn().mockResolvedValue({
            consentRecords: 1250,
            dataRequests: { pending: 3, completed: 45 },
            lastAudit: '2024-12-15',
            complianceScore: 92,
            dataRetentionPolicies: [
                { type: 'user_data', retention: '3 years', status: 'active' },
                { type: 'logs', retention: '1 year', status: 'active' },
            ],
        }),
        updateGDPRSettings: vi.fn().mockResolvedValue({ success: true }),
        exportGDPRReport: vi.fn().mockResolvedValue({ downloadUrl: '/reports/gdpr.pdf' }),
    },
}));

vi.mock('react-hot-toast', () => ({
    default: {
        success: vi.fn(),
        error: vi.fn(),
    },
}));

/**
 * GDPRComplianceDashboard Component Tests
 * Tests for GDPR compliance monitoring and management
 * CRITICAL FOR ENTERPRISE LEGAL COMPLIANCE
 */
describe('GDPRComplianceDashboard', () => {
    const defaultProps = {
        organizationId: 'org-1',
    };

    beforeEach(() => {
        vi.clearAllMocks();
    });

    afterEach(() => {
        vi.restoreAllMocks();
    });

    describe('Rendering', () => {
        it('should render compliance overview', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/gdpr compliance/i)).toBeInTheDocument();
            });
        });

        it('should display compliance score', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText('92%')).toBeInTheDocument();
            });
        });

        it('should show data request stats', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/3.*pending/i)).toBeInTheDocument();
                expect(screen.getByText(/45.*completed/i)).toBeInTheDocument();
            });
        });

        it('should display consent records count', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/1,?250/)).toBeInTheDocument();
            });
        });

        it('should show last audit date', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/2024-12-15|December 15/i)).toBeInTheDocument();
            });
        });
    });

    describe('Data Retention Policies', () => {
        it('should display retention policies', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/user.?data/i)).toBeInTheDocument();
                expect(screen.getByText(/3 years/i)).toBeInTheDocument();
                expect(screen.getByText(/logs/i)).toBeInTheDocument();
                expect(screen.getByText(/1 year/i)).toBeInTheDocument();
            });
        });

        it('should show policy status badges', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                const activeBadges = screen.getAllByText(/active/i);
                expect(activeBadges.length).toBeGreaterThan(0);
            });
        });

        it('should allow editing retention policies', async () => {
            const user = userEvent.setup();
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/user.?data/i)).toBeInTheDocument();
            });

            const editButton = screen.getAllByRole('button', { name: /edit/i })[0];
            await user.click(editButton);

            expect(screen.getByLabelText(/retention period/i)).toBeInTheDocument();
        });
    });

    describe('Data Subject Requests', () => {
        it('should show pending requests section', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/pending requests/i)).toBeInTheDocument();
            });
        });

        it('should navigate to request details', async () => {
            const user = userEvent.setup();
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/pending requests/i)).toBeInTheDocument();
            });

            const viewButton = screen.getByRole('button', { name: /view requests/i });
            await user.click(viewButton);

            expect(screen.getByTestId('data-requests-panel')).toBeInTheDocument();
        });
    });

    describe('Consent Management', () => {
        it('should show consent overview', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/consent.*records/i)).toBeInTheDocument();
            });
        });

        it('should show consent breakdown', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/marketing/i)).toBeInTheDocument();
                expect(screen.getByText(/analytics/i)).toBeInTheDocument();
            });
        });
    });

    describe('Export Functionality', () => {
        it('should export GDPR compliance report', async () => {
            const user = userEvent.setup();
            const { Api } = await import('../../../../services/api');

            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/gdpr compliance/i)).toBeInTheDocument();
            });

            const exportButton = screen.getByRole('button', { name: /export report/i });
            await user.click(exportButton);

            expect(Api.exportGDPRReport).toHaveBeenCalled();
        });

        it('should show export format options', async () => {
            const user = userEvent.setup();
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/gdpr compliance/i)).toBeInTheDocument();
            });

            const exportButton = screen.getByRole('button', { name: /export report/i });
            await user.click(exportButton);

            expect(screen.getByText(/pdf/i)).toBeInTheDocument();
            expect(screen.getByText(/csv/i)).toBeInTheDocument();
        });
    });

    describe('Compliance Alerts', () => {
        it('should show compliance warnings', async () => {
            const { Api } = await import('../../../../services/api');
            Api.getGDPRStatus.mockResolvedValueOnce({
                ...await Api.getGDPRStatus(),
                warnings: [
                    { type: 'retention', message: 'Data retention policy expiring soon' },
                ],
            });

            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/retention.*expiring/i)).toBeInTheDocument();
            });
        });

        it('should highlight low compliance score', async () => {
            const { Api } = await import('../../../../services/api');
            Api.getGDPRStatus.mockResolvedValueOnce({
                complianceScore: 45,
                consentRecords: 100,
                dataRequests: { pending: 10, completed: 5 },
            });

            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                const scoreElement = screen.getByText('45%');
                expect(scoreElement).toHaveClass('text-red');
            });
        });
    });

    describe('Audit Trail', () => {
        it('should show recent audit activities', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/audit.*trail/i)).toBeInTheDocument();
            });
        });

        it('should allow scheduling new audit', async () => {
            const user = userEvent.setup();
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByText(/gdpr compliance/i)).toBeInTheDocument();
            });

            const scheduleButton = screen.getByRole('button', { name: /schedule audit/i });
            await user.click(scheduleButton);

            expect(screen.getByText(/schedule.*audit/i)).toBeInTheDocument();
        });
    });

    describe('Accessibility', () => {
        it('should have proper heading structure', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                expect(screen.getByRole('heading', { level: 1 })).toBeInTheDocument();
            });
        });

        it('should announce compliance score to screen readers', async () => {
            renderWithProviders(<GDPRComplianceDashboard {...defaultProps} />);

            await waitFor(() => {
                const scoreElement = screen.getByText('92%');
                expect(scoreElement).toHaveAccessibleName(/compliance score.*92/i);
            });
        });
    });
});




