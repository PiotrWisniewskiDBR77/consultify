/**
 * @vitest-environment jsdom
 * 
 * AIPerformanceDashboard Tests
 * Tests for the AI performance monitoring dashboard component.
 */
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import { AIPerformanceDashboard } from '../../components/Admin/AIPerformanceDashboard';

// Mock dependencies
vi.mock('react-i18next', () => ({
    useTranslation: () => ({
        t: (key: string) => key,
        i18n: { language: 'en' }
    })
}));

vi.mock('react-hot-toast', () => ({
    default: {
        success: vi.fn(),
        error: vi.fn()
    }
}));

vi.mock('../../../services/api', () => ({
    default: {
        get: vi.fn().mockResolvedValue({
            data: {
                success: true,
                metrics: {
                    avgResponseTime: 1.5,
                    p50ResponseTime: 1.0,
                    p95ResponseTime: 3.0,
                    p99ResponseTime: 5.0,
                    totalRequests: 5000,
                    successRate: 95.5,
                    errorRate: 2.5,
                    avgTokensPerRequest: 850,
                    totalTokensUsed: 2500000,
                    cacheHitRate: 28.5,
                    totalCostUsd: 175.50
                },
                capabilities: [
                    { capability: 'chat', requests: 3500, avgResponseTime: 0.9, avgTokens: 650, totalCost: 45.20, successRate: 98.2 },
                    { capability: 'report', requests: 850, avgResponseTime: 3.2, avgTokens: 2100, totalCost: 62.50, successRate: 95.1 }
                ],
                models: [
                    { model: 'gpt-4o', requests: 2800, avgResponseTime: 1.8, avgQuality: 0.92, totalCost: 85.40, successRate: 97.5 },
                    { model: 'gpt-4o-mini', requests: 3200, avgResponseTime: 0.6, avgQuality: 0.85, totalCost: 12.80, successRate: 98.2 }
                ],
                responseTimeTrend: Array.from({ length: 24 }, (_, i) => ({
                    timestamp: new Date(Date.now() - (24 - i) * 3600000).toISOString(),
                    value: 0.8 + Math.random() * 1.5
                }))
            }
        })
    }
}));

describe('AIPerformanceDashboard', () => {
    beforeEach(() => {
        vi.clearAllMocks();
    });

    it('should render dashboard title', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('AI Performance Dashboard')).toBeInTheDocument();
        });
    });

    it('should render subtitle with description', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('Real-time performance metrics and analytics')).toBeInTheDocument();
        });
    });

    it('should display time range selector', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('1h')).toBeInTheDocument();
            expect(screen.getByText('24h')).toBeInTheDocument();
            expect(screen.getByText('7d')).toBeInTheDocument();
            expect(screen.getByText('30d')).toBeInTheDocument();
        });
    });

    it('should switch time range when clicked', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            const btn7d = screen.getByText('7d');
            fireEvent.click(btn7d);
            expect(btn7d.className).toContain('bg-purple-600');
        });
    });

    it('should display metric cards', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('Avg Response')).toBeInTheDocument();
            expect(screen.getByText('Success Rate')).toBeInTheDocument();
            expect(screen.getByText('Cache Hit Rate')).toBeInTheDocument();
            expect(screen.getByText('Total Requests')).toBeInTheDocument();
            expect(screen.getByText('Avg Tokens')).toBeInTheDocument();
            expect(screen.getByText('Total Cost')).toBeInTheDocument();
        });
    });

    it('should display response time percentiles section', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('Response Time Percentiles')).toBeInTheDocument();
            expect(screen.getByText('p50')).toBeInTheDocument();
            expect(screen.getByText('p95')).toBeInTheDocument();
            expect(screen.getByText('p99')).toBeInTheDocument();
        });
    });

    it('should display response time trend chart section', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('Response Time Trend')).toBeInTheDocument();
        });
    });

    it('should display capability metrics section', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('Performance by Capability')).toBeInTheDocument();
        });
    });

    it('should display model metrics section', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('Performance by Model')).toBeInTheDocument();
        });
    });

    it('should display system health section', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('System Health')).toBeInTheDocument();
            expect(screen.getByText('API Response')).toBeInTheDocument();
            expect(screen.getByText('Error Rate')).toBeInTheDocument();
            expect(screen.getByText('Cache Efficiency')).toBeInTheDocument();
        });
    });

    it('should have refresh button', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('Refresh')).toBeInTheDocument();
        });
    });

    it('should have export button', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('Export')).toBeInTheDocument();
        });
    });

    it('should have auto-refresh toggle', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            expect(screen.getByText('Auto')).toBeInTheDocument();
        });
    });

    it('should toggle auto-refresh', async () => {
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            const autoBtn = screen.getByText('Auto');
            fireEvent.click(autoBtn);
            expect(screen.getByText('Live')).toBeInTheDocument();
        });
    });

    it('should call refresh on button click', async () => {
        const api = await import('../../../services/api');
        render(<AIPerformanceDashboard />);
        
        await waitFor(() => {
            const refreshBtn = screen.getByText('Refresh');
            fireEvent.click(refreshBtn);
        });
        
        // Should have been called at least twice (initial load + refresh click)
        expect(api.default.get).toHaveBeenCalled();
    });
});















