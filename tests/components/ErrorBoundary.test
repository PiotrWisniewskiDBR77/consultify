import React from 'react';
import { screen, waitFor, fireEvent } from '@testing-library/react';
import { renderWithProviders } from '../../test-utils';
import userEvent from '@testing-library/user-event';
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { ErrorBoundary } from '../../../components/ErrorBoundary';

// Mock console.error to avoid noise in test output
const consoleError = vi.spyOn(console, 'error').mockImplementation(() => {});

// Mock localStorage
const localStorageMock = {
    clear: vi.fn(),
    getItem: vi.fn(),
    setItem: vi.fn(),
    removeItem: vi.fn(),
};
Object.defineProperty(window, 'localStorage', {
    value: localStorageMock,
});

// Mock window.location
const locationMock = { href: '' };
Object.defineProperty(window, 'location', {
    value: locationMock,
    writable: true,
});

/**
 * ErrorBoundary Component Tests
 * Tests comprehensive error handling and recovery
 * CRITICAL FOR ENTERPRISE APPLICATION STABILITY
 */
describe('ErrorBoundary Component', () => {
    const ThrowError = ({ shouldThrow = true }: { shouldThrow?: boolean }) => {
        if (shouldThrow) {
            throw new Error('Test error');
        }
        return <div>No error</div>;
    };

    beforeEach(() => {
        vi.clearAllMocks();
        localStorageMock.clear.mockClear();
        locationMock.href = '';
    });

    afterEach(() => {
        vi.restoreAllMocks();
    });

    describe('Error Catching', () => {
        it('should catch and display errors from child components', () => {
            // Suppress console.error for this test
            consoleError.mockImplementationOnce(() => {});

            expect(() => {
                renderWithProviders(
                    <ErrorBoundary>
                        <ThrowError />
                    </ErrorBoundary>
                );
            }).not.toThrow();

            expect(screen.getByText('Something went wrong')).toBeInTheDocument();
            expect(screen.getByText('Test error')).toBeInTheDocument();
        });

        it('should display error message correctly', () => {
            consoleError.mockImplementationOnce(() => {});

            const customError = new Error('Custom component error');
            const ThrowCustomError = () => {
                throw customError;
            };

            renderWithProviders(
                <ErrorBoundary>
                    <ThrowCustomError />
                </ErrorBoundary>
            );

            expect(screen.getByText('Something went wrong')).toBeInTheDocument();
            expect(screen.getByText('Custom component error')).toBeInTheDocument();
        });

        it('should not display error UI when no error occurs', () => {
            renderWithProviders(
                <ErrorBoundary>
                    <ThrowError shouldThrow={false} />
                </ErrorBoundary>
            );

            expect(screen.getByText('No error')).toBeInTheDocument();
            expect(screen.queryByText('Something went wrong')).not.toBeInTheDocument();
        });
    });

    describe('Error Recovery', () => {
        it('should reset application data when reset button is clicked', async () => {
            const user = userEvent.setup();
            consoleError.mockImplementationOnce(() => {});

            renderWithProviders(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            const resetButton = screen.getByRole('button', { name: /reset.*application.*data/i });
            await user.click(resetButton);

            expect(localStorageMock.clear).toHaveBeenCalled();
            expect(locationMock.href).toBe('/');
        });

        it('should handle multiple errors gracefully', () => {
            consoleError.mockImplementation(() => {});

            const MultipleErrors = () => {
                throw new Error('First error');
            };

            const { rerender } = renderWithProviders(
                <ErrorBoundary>
                    <MultipleErrors />
                </ErrorBoundary>
            );

            expect(screen.getByText('First error')).toBeInTheDocument();

            // Simulate another error after recovery attempt
            rerender(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            expect(screen.getByText('Test error')).toBeInTheDocument();
        });
    });

    describe('Error Logging', () => {
        it('should log errors to console with error info', () => {
            const error = new Error('Logged error');
            const errorInfo = { componentStack: 'TestComponent' };

            // Mock componentDidCatch to verify logging
            const mockComponentDidCatch = vi.spyOn(ErrorBoundary.prototype, 'componentDidCatch');

            renderWithProviders(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            expect(mockComponentDidCatch).toHaveBeenCalledWith(error, errorInfo);
        });

        it('should handle error logging failures gracefully', () => {
            // Mock console.error to throw
            consoleError.mockImplementationOnce(() => {
                throw new Error('Console error failed');
            });

            expect(() => {
                renderWithProviders(
                    <ErrorBoundary>
                        <ThrowError />
                    </ErrorBoundary>
                );
            }).not.toThrow();

            // Should still display error UI despite logging failure
            expect(screen.getByText('Something went wrong')).toBeInTheDocument();
        });
    });

    describe('UI States', () => {
        it('should display user-friendly error message', () => {
            consoleError.mockImplementationOnce(() => {});

            renderWithProviders(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            expect(screen.getByText('Something went wrong')).toBeInTheDocument();
            expect(screen.getByText(/corrupted local data.*temporary glitch/i)).toBeInTheDocument();
        });

        it('should provide clear recovery instructions', () => {
            consoleError.mockImplementationOnce(() => {});

            renderWithProviders(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            expect(screen.getByRole('button', { name: /reset.*application.*data.*fix/i })).toBeInTheDocument();
        });

        it('should have proper styling for error state', () => {
            consoleError.mockImplementationOnce(() => {});

            renderWithProviders(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            const errorContainer = screen.getByText('Something went wrong').closest('div');
            expect(errorContainer).toHaveClass('min-h-screen', 'flex', 'items-center', 'justify-center');

            const errorCard = screen.getByText('Something went wrong').closest('[class*="bg-slate-800"]');
            expect(errorCard).toHaveClass('max-w-md', 'w-full', 'bg-slate-800');
        });
    });

    describe('Accessibility', () => {
        it('should have proper ARIA labels and roles', () => {
            consoleError.mockImplementationOnce(() => {});

            renderWithProviders(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            const errorContainer = screen.getByText('Something went wrong').closest('div');
            expect(errorContainer).toHaveAttribute('role', 'alert');
        });

        it('should support keyboard navigation', async () => {
            const user = userEvent.setup();
            consoleError.mockImplementationOnce(() => {});

            renderWithProviders(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            // Tab to reset button
            await user.keyboard('{Tab}');
            const resetButton = screen.getByRole('button', { name: /reset.*application.*data/i });
            expect(resetButton).toHaveFocus();
        });

        it('should announce error to screen readers', () => {
            consoleError.mockImplementationOnce(() => {});

            renderWithProviders(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            const alertElement = screen.getByRole('alert');
            expect(alertElement).toHaveTextContent('Something went wrong');
        });
    });

    describe('Error Types', () => {
        it('should handle network errors', () => {
            consoleError.mockImplementationOnce(() => {});

            const NetworkError = () => {
                throw new Error('Network request failed: 500 Internal Server Error');
            };

            renderWithProviders(
                <ErrorBoundary>
                    <NetworkError />
                </ErrorBoundary>
            );

            expect(screen.getByText('Network request failed: 500 Internal Server Error')).toBeInTheDocument();
        });

        it('should handle authentication errors', () => {
            consoleError.mockImplementationOnce(() => {});

            const AuthError = () => {
                throw new Error('Authentication failed: Invalid token');
            };

            renderWithProviders(
                <ErrorBoundary>
                    <AuthError />
                </ErrorBoundary>
            );

            expect(screen.getByText('Authentication failed: Invalid token')).toBeInTheDocument();
        });

        it('should handle validation errors', () => {
            consoleError.mockImplementationOnce(() => {});

            const ValidationError = () => {
                throw new Error('Validation failed: Required field missing');
            };

            renderWithProviders(
                <ErrorBoundary>
                    <ValidationError />
                </ErrorBoundary>
            );

            expect(screen.getByText('Validation failed: Required field missing')).toBeInTheDocument();
        });

        it('should handle permission errors', () => {
            consoleError.mockImplementationOnce(() => {});

            const PermissionError = () => {
                throw new Error('Access denied: Insufficient permissions');
            };

            renderWithProviders(
                <ErrorBoundary>
                    <PermissionError />
                </ErrorBoundary>
            );

            expect(screen.getByText('Access denied: Insufficient permissions')).toBeInTheDocument();
        });
    });

    describe('Nested Error Boundaries', () => {
        it('should handle nested error boundaries correctly', () => {
            consoleError.mockImplementation(() => {});

            const NestedError = () => (
                <ErrorBoundary>
                    <ErrorBoundary>
                        <ThrowError />
                    </ErrorBoundary>
                    <div>Outer content</div>
                </ErrorBoundary>
            );

            renderWithProviders(<NestedError />);

            // Inner error boundary should catch the error
            expect(screen.getByText('Something went wrong')).toBeInTheDocument();
            // Outer content should still be visible if outer boundary doesn't catch
            expect(screen.queryByText('Outer content')).not.toBeInTheDocument();
        });

        it('should isolate errors to specific sections', () => {
            consoleError.mockImplementationOnce(() => {});

            const SectionedApp = () => (
                <div>
                    <ErrorBoundary>
                        <ThrowError />
                    </ErrorBoundary>
                    <ErrorBoundary>
                        <div>Safe section</div>
                    </ErrorBoundary>
                </div>
            );

            renderWithProviders(<SectionedApp />);

            // Error section should show error UI
            expect(screen.getByText('Something went wrong')).toBeInTheDocument();
            // Safe section should still work
            expect(screen.getByText('Safe section')).toBeInTheDocument();
        });
    });

    describe('Performance', () => {
        it('should render error UI quickly', () => {
            consoleError.mockImplementationOnce(() => {});

            const startTime = performance.now();

            renderWithProviders(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            const endTime = performance.now();
            const renderTime = endTime - startTime;

            // Error UI should render within 100ms
            expect(renderTime).toBeLessThan(100);
        });

        it('should not cause memory leaks', () => {
            consoleError.mockImplementation(() => {});

            const { unmount } = renderWithProviders(
                <ErrorBoundary>
                    <ThrowError />
                </ErrorBoundary>
            );

            // Should not throw during unmount
            expect(() => unmount()).not.toThrow();
        });
    });

    describe('Recovery Scenarios', () => {
        it('should allow manual error recovery', () => {
            consoleError.mockImplementationOnce(() => {});

            const RecoverableComponent = () => {
                const [hasError, setHasError] = React.useState(false);

                if (hasError) {
                    throw new Error('Recoverable error');
                }

                return (
                    <div>
                        <button onClick={() => setHasError(true)}>Trigger Error</button>
                        <button onClick={() => setHasError(false)}>Recover</button>
                        <ErrorBoundary>
                            {hasError ? <ThrowError /> : <div>Normal content</div>}
                        </ErrorBoundary>
                    </div>
                );
            };

            renderWithProviders(<RecoverableComponent />);

            // Initially normal
            expect(screen.getByText('Normal content')).toBeInTheDocument();

            // Trigger error
            fireEvent.click(screen.getByText('Trigger Error'));
            expect(screen.getByText('Something went wrong')).toBeInTheDocument();

            // Note: In real implementation, recovery would require ErrorBoundary reset
            // This test demonstrates the concept
        });
    });
});