/**
 * @vitest-environment jsdom
 */
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { render, screen, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { AIFeedbackButton } from '../../components/AIFeedbackButton';
import { Api } from '../../../services/api';

vi.mock('../../../services/api', () => ({
    Api: {
        aiDetailFeedback: vi.fn()
    }
}));

vi.mock('react-hot-toast', () => ({
    toast: {
        success: vi.fn(),
        error: vi.fn()
    }
}));

describe('AIFeedbackButton Component', () => {
    const user = userEvent.setup();

    beforeEach(() => {
        vi.clearAllMocks();
        (Api.aiDetailFeedback as any).mockResolvedValue({});
    });

    it('renders thumbs up and thumbs down buttons', () => {
        render(<AIFeedbackButton context="diagnosis" />);

        const buttons = screen.getAllByRole('button');
        expect(buttons.length).toBeGreaterThanOrEqual(2);
    });

    it('opens modal when thumbs up clicked', async () => {
        render(<AIFeedbackButton context="diagnosis" />);

        const thumbsUp = screen.getByTitle(/Helpful/i);
        await user.click(thumbsUp);

        await waitFor(() => {
            expect(screen.getByText(/Provide Feedback/i)).toBeInTheDocument();
        });
    });

    it('opens modal when thumbs down clicked', async () => {
        render(<AIFeedbackButton context="diagnosis" />);

        const thumbsDown = screen.getByTitle(/Not Helpful/i);
        await user.click(thumbsDown);

        await waitFor(() => {
            expect(screen.getByText(/Provide Feedback/i)).toBeInTheDocument();
        });
    });

    it('allows selecting positive rating in modal', async () => {
        render(<AIFeedbackButton context="diagnosis" />);

        const thumbsUp = screen.getByTitle(/Helpful/i);
        await user.click(thumbsUp);

        await waitFor(() => {
            expect(screen.getByText(/Provide Feedback/i)).toBeInTheDocument();
        });

        const positiveButton = screen.getAllByRole('button').find(btn => 
            btn.querySelector('svg') && btn.className.includes('green')
        );
        
        if (positiveButton) {
            await user.click(positiveButton);
            expect(positiveButton.className).toContain('green');
        }
    });

    it('allows entering comment', async () => {
        render(<AIFeedbackButton context="diagnosis" />);

        const thumbsUp = screen.getByTitle(/Helpful/i);
        await user.click(thumbsUp);

        await waitFor(() => {
            expect(screen.getByPlaceholderText(/Tell us more/i)).toBeInTheDocument();
        });

        const textarea = screen.getByPlaceholderText(/Tell us more/i);
        await user.type(textarea, 'Very helpful!');

        expect(textarea).toHaveValue('Very helpful!');
    });

    it('submits feedback with rating', async () => {
        const onFeedbackSubmit = vi.fn();
        render(<AIFeedbackButton context="diagnosis" onFeedbackSubmit={onFeedbackSubmit} />);

        const thumbsUp = screen.getByTitle(/Helpful/i);
        await user.click(thumbsUp);

        await waitFor(() => {
            expect(screen.getByText(/Send Feedback/i)).toBeInTheDocument();
        });

        const submitButton = screen.getByText(/Send Feedback/i);
        await user.click(submitButton);

        await waitFor(() => {
            expect(Api.aiDetailFeedback).toHaveBeenCalledWith(
                expect.objectContaining({
                    action: 'diagnosis',
                    rating: 1
                })
            );
        });
    });

    it('submits feedback with comment only', async () => {
        render(<AIFeedbackButton context="recommendation" />);

        const thumbsUp = screen.getByTitle(/Helpful/i);
        await user.click(thumbsUp);

        await waitFor(() => {
            const textarea = screen.getByPlaceholderText(/Tell us more/i);
            expect(textarea).toBeInTheDocument();
        });

        const textarea = screen.getByPlaceholderText(/Tell us more/i);
        await user.type(textarea, 'Good recommendation');

        const submitButton = screen.getByText(/Send Feedback/i);
        await user.click(submitButton);

        await waitFor(() => {
            expect(Api.aiDetailFeedback).toHaveBeenCalled();
        });
    });

    it('closes modal when X clicked', async () => {
        render(<AIFeedbackButton context="diagnosis" />);

        const thumbsUp = screen.getByTitle(/Helpful/i);
        await user.click(thumbsUp);

        await waitFor(() => {
            expect(screen.getByText(/Provide Feedback/i)).toBeInTheDocument();
        });

        const closeButton = screen.getAllByRole('button').find(btn => 
            btn.querySelector('svg') && btn.className.includes('X')
        );

        if (closeButton) {
            await user.click(closeButton);
            await waitFor(() => {
                expect(screen.queryByText(/Provide Feedback/i)).not.toBeInTheDocument();
            });
        }
    });

    it('disables submit when no rating or comment', async () => {
        render(<AIFeedbackButton context="diagnosis" />);

        const thumbsUp = screen.getByTitle(/Helpful/i);
        await user.click(thumbsUp);

        await waitFor(() => {
            const submitButton = screen.getByText(/Send Feedback/i);
            expect(submitButton).toBeDisabled();
        });
    });

    it('shows loading state while submitting', async () => {
        (Api.aiDetailFeedback as any).mockImplementation(() => new Promise(() => {}));

        render(<AIFeedbackButton context="diagnosis" />);

        const thumbsUp = screen.getByTitle(/Helpful/i);
        await user.click(thumbsUp);

        await waitFor(() => {
            const submitButton = screen.getByText(/Send Feedback/i);
            expect(submitButton).toBeInTheDocument();
        });

        const submitButton = screen.getByText(/Send Feedback/i);
        await user.click(submitButton);

        await waitFor(() => {
            expect(screen.getByText(/Sending/i)).toBeInTheDocument();
        });
    });

    it('calls onFeedbackSubmit callback after successful submission', async () => {
        const onFeedbackSubmit = vi.fn();
        render(<AIFeedbackButton context="diagnosis" onFeedbackSubmit={onFeedbackSubmit} />);

        const thumbsUp = screen.getByTitle(/Helpful/i);
        await user.click(thumbsUp);

        await waitFor(() => {
            const submitButton = screen.getByText(/Send Feedback/i);
            expect(submitButton).toBeInTheDocument();
        });

        const submitButton = screen.getByText(/Send Feedback/i);
        await user.click(submitButton);

        await waitFor(() => {
            expect(onFeedbackSubmit).toHaveBeenCalled();
        });
    });
});















