/**
 * @vitest-environment jsdom
 */
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { render, screen, waitFor } from '@testing-library/react';
import { CapacityView } from '../../components/Implementation/CapacityView';
import { Api } from '@/services/api';

vi.mock('@/services/api', () => ({
    Api: {
        get: vi.fn()
    }
}));

const mockCapacitySummary = {
    projectId: 'proj-1',
    totalUsersAnalyzed: 5,
    overloadedUsers: [
        {
            userId: 'user-1',
            userName: 'John Doe',
            overloadedWeeks: [
                { weekStart: '2024-01-01', allocatedHours: 50, utilizationPercent: 125 }
            ],
            sustainedOverload: false
        }
    ],
    hasOverloads: true,
    sustainedOverloads: 0
};

describe('CapacityView Component', () => {
    beforeEach(() => {
        vi.clearAllMocks();
        (Api.get as any).mockResolvedValue(mockCapacitySummary);
    });

    it('renders capacity view heading', async () => {
        render(<CapacityView projectId="proj-1" />);

        await waitFor(() => {
            expect(screen.getByText(/Capacity/i) || screen.getByText(/Resource/i)).toBeInTheDocument();
        });
    });

    it('loads capacity data for project', async () => {
        render(<CapacityView projectId="proj-1" />);

        await waitFor(() => {
            expect(Api.get).toHaveBeenCalledWith('/capacity/project/proj-1/overloads');
        });
    });

    it('displays overloaded users', async () => {
        render(<CapacityView projectId="proj-1" />);

        await waitFor(() => {
            expect(screen.getByText('John Doe')).toBeInTheDocument();
        });
    });

    it('shows overload warnings', async () => {
        render(<CapacityView projectId="proj-1" />);

        await waitFor(() => {
            expect(screen.getByText(/overload/i) || screen.getByText(/125%/i)).toBeInTheDocument();
        });
    });

    it('shows loading state', () => {
        (Api.get as any).mockImplementation(() => new Promise(() => {}));

        render(<CapacityView projectId="proj-1" />);

        expect(screen.getByRole('status')).toBeInTheDocument();
    });
});















