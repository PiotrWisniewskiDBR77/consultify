/**
 * @vitest-environment jsdom
 */
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { render, screen, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { AICharterPreview } from '../../components/assessment/AICharterPreview';
import type { AIGeneratedCharter } from '../../../types';

const mockCharter: AIGeneratedCharter = {
    name: 'Digital Transformation Initiative',
    summary: 'A comprehensive initiative to modernize business processes',
    applicantOneLiner: 'Transforming operations through digital innovation',
    strategicIntent: 'Build Capability',
    timeline: '6 months',
    priority: 2,
    generationConfidence: 'HIGH',
    problemStructured: {
        symptom: 'Manual processes causing delays',
        rootCause: 'Lack of automation in key workflows',
        costOfInaction: 'Competitive disadvantage and increased costs'
    },
    targetState: {
        process: ['Automated workflows', 'Real-time reporting'],
        behavior: ['Data-driven decision making', 'Proactive monitoring'],
        capability: ['Digital skills', 'Process automation']
    },
    killCriteria: [
        'No executive sponsorship after 2 weeks',
        'Budget exceeds 150% of estimate'
    ],
    keyRisks: [
        { risk: 'Change resistance', metric: 'High', mitigation: 'Change management program' },
        { risk: 'Technical complexity', metric: 'Medium', mitigation: 'Phased implementation' }
    ],
    suggestedTasks: [
        { id: 't1', title: 'Discovery workshop', taskType: 'ANALYSIS', description: 'Gather requirements', estimatedHours: 16 },
        { id: 't2', title: 'Technology assessment', taskType: 'RESEARCH', description: 'Evaluate tools', estimatedHours: 24 }
    ],
    suggestedTeam: [
        { id: 'm1', role: 'LEAD', allocation: 80, title: 'Project Manager' },
        { id: 'm2', role: 'CONTRIBUTOR', allocation: 50, title: 'Business Analyst' }
    ],
    capex: 50000,
    firstYearOpex: 20000,
    estimatedROI: 2.5,
    annualBenefit: 100000
};

describe('AICharterPreview Component', () => {
    const user = userEvent.setup();
    const mockOnUpdate = vi.fn();
    const mockOnRegenerateSection = vi.fn();

    const defaultProps = {
        charter: mockCharter,
        isGenerating: false,
        onUpdate: mockOnUpdate,
        onRegenerateSection: mockOnRegenerateSection
    };

    beforeEach(() => {
        vi.clearAllMocks();
        mockOnRegenerateSection.mockResolvedValue(undefined);
    });

    describe('Header Display', () => {
        it('renders AI Generated Charter header', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('AI Generated Charter')).toBeInTheDocument();
        });

        it('shows confidence badge', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('HIGH Confidence')).toBeInTheDocument();
        });

        it('applies correct color for HIGH confidence', () => {
            render(<AICharterPreview {...defaultProps} />);

            const badge = screen.getByText('HIGH Confidence');
            expect(badge).toHaveClass('text-green-500');
        });

        it('applies correct color for MEDIUM confidence', () => {
            render(<AICharterPreview {...defaultProps} charter={{ ...mockCharter, generationConfidence: 'MEDIUM' }} />);

            const badge = screen.getByText('MEDIUM Confidence');
            expect(badge).toHaveClass('text-amber-500');
        });

        it('applies correct color for LOW confidence', () => {
            render(<AICharterPreview {...defaultProps} charter={{ ...mockCharter, generationConfidence: 'LOW' }} />);

            const badge = screen.getByText('LOW Confidence');
            expect(badge).toHaveClass('text-red-500');
        });
    });

    describe('Section Headers', () => {
        it('renders all section titles', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('Basic Information')).toBeInTheDocument();
            expect(screen.getByText('Problem Statement')).toBeInTheDocument();
            expect(screen.getByText('Target State')).toBeInTheDocument();
            expect(screen.getByText('Kill Criteria')).toBeInTheDocument();
            expect(screen.getByText('Key Risks')).toBeInTheDocument();
            expect(screen.getByText('Suggested Tasks')).toBeInTheDocument();
            expect(screen.getByText('Team Composition')).toBeInTheDocument();
            expect(screen.getByText('Financials')).toBeInTheDocument();
        });
    });

    describe('Section Expansion', () => {
        it('expands basic, problem, and target by default', () => {
            render(<AICharterPreview {...defaultProps} />);

            // Basic section content should be visible
            expect(screen.getByText('Digital Transformation Initiative')).toBeInTheDocument();
            // Problem section content
            expect(screen.getByText('Manual processes causing delays')).toBeInTheDocument();
        });

        it('toggles section on header click', async () => {
            render(<AICharterPreview {...defaultProps} />);

            // Kill Criteria should be collapsed by default
            expect(screen.queryByText('No executive sponsorship after 2 weeks')).not.toBeInTheDocument();

            // Click to expand
            await user.click(screen.getByText('Kill Criteria'));

            await waitFor(() => {
                expect(screen.getByText('No executive sponsorship after 2 weeks')).toBeInTheDocument();
            });
        });

        it('collapses expanded section on click', async () => {
            render(<AICharterPreview {...defaultProps} />);

            // Basic is expanded by default
            expect(screen.getByText('Digital Transformation Initiative')).toBeInTheDocument();

            // Click to collapse
            await user.click(screen.getByText('Basic Information'));

            await waitFor(() => {
                // Name field should be hidden (or check for ChevronDown)
            });
        });
    });

    describe('Basic Information Section', () => {
        it('displays charter name', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('Digital Transformation Initiative')).toBeInTheDocument();
        });

        it('displays summary', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('A comprehensive initiative to modernize business processes')).toBeInTheDocument();
        });

        it('displays one-liner', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('Transforming operations through digital innovation')).toBeInTheDocument();
        });

        it('displays strategic intent', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('Build Capability')).toBeInTheDocument();
        });

        it('displays timeline', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('6 months')).toBeInTheDocument();
        });
    });

    describe('Problem Statement Section', () => {
        it('displays symptom', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('Manual processes causing delays')).toBeInTheDocument();
        });

        it('displays root cause', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('Lack of automation in key workflows')).toBeInTheDocument();
        });

        it('displays cost of inaction', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('Competitive disadvantage and increased costs')).toBeInTheDocument();
        });
    });

    describe('Target State Section', () => {
        it('displays process targets', async () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('Automated workflows')).toBeInTheDocument();
        });

        it('displays behavior targets', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('Data-driven decision making')).toBeInTheDocument();
        });

        it('displays capability targets', () => {
            render(<AICharterPreview {...defaultProps} />);

            expect(screen.getByText('Digital skills')).toBeInTheDocument();
        });
    });

    describe('Kill Criteria Section', () => {
        it('displays kill criteria after expansion', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Kill Criteria'));

            await waitFor(() => {
                expect(screen.getByText('No executive sponsorship after 2 weeks')).toBeInTheDocument();
                expect(screen.getByText('Budget exceeds 150% of estimate')).toBeInTheDocument();
            });
        });

        it('allows deleting kill criteria', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Kill Criteria'));

            await waitFor(() => {
                expect(screen.getByText('No executive sponsorship after 2 weeks')).toBeInTheDocument();
            });

            // Find and click delete button
            const deleteButtons = screen.getAllByRole('button').filter(btn => 
                btn.querySelector('.lucide-trash-2')
            );

            if (deleteButtons.length > 0) {
                await user.click(deleteButtons[0]);

                expect(mockOnUpdate).toHaveBeenCalledWith({
                    killCriteria: ['Budget exceeds 150% of estimate']
                });
            }
        });
    });

    describe('Key Risks Section', () => {
        it('displays risks after expansion', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Key Risks'));

            await waitFor(() => {
                expect(screen.getByText('Change resistance')).toBeInTheDocument();
                expect(screen.getByText('Technical complexity')).toBeInTheDocument();
            });
        });

        it('shows risk severity badges', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Key Risks'));

            await waitFor(() => {
                expect(screen.getByText('High')).toBeInTheDocument();
                expect(screen.getByText('Medium')).toBeInTheDocument();
            });
        });

        it('displays mitigations', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Key Risks'));

            await waitFor(() => {
                expect(screen.getByText(/Change management program/)).toBeInTheDocument();
            });
        });
    });

    describe('Suggested Tasks Section', () => {
        it('displays tasks after expansion', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Suggested Tasks'));

            await waitFor(() => {
                expect(screen.getByText('Discovery workshop')).toBeInTheDocument();
                expect(screen.getByText('Technology assessment')).toBeInTheDocument();
            });
        });

        it('shows task type badges', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Suggested Tasks'));

            await waitFor(() => {
                expect(screen.getByText('ANALYSIS')).toBeInTheDocument();
                expect(screen.getByText('RESEARCH')).toBeInTheDocument();
            });
        });

        it('shows estimated hours', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Suggested Tasks'));

            await waitFor(() => {
                expect(screen.getByText('16h')).toBeInTheDocument();
                expect(screen.getByText('24h')).toBeInTheDocument();
            });
        });
    });

    describe('Team Section', () => {
        it('displays team members after expansion', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Team Composition'));

            await waitFor(() => {
                expect(screen.getByText('Project Manager')).toBeInTheDocument();
                expect(screen.getByText('Business Analyst')).toBeInTheDocument();
            });
        });

        it('shows role badges', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Team Composition'));

            await waitFor(() => {
                expect(screen.getByText('LEAD')).toBeInTheDocument();
                expect(screen.getByText('CONTRIBUTOR')).toBeInTheDocument();
            });
        });

        it('shows allocation percentages', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Team Composition'));

            await waitFor(() => {
                expect(screen.getByText('80%')).toBeInTheDocument();
                expect(screen.getByText('50%')).toBeInTheDocument();
            });
        });
    });

    describe('Financials Section', () => {
        it('displays financial data after expansion', async () => {
            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Financials'));

            await waitFor(() => {
                expect(screen.getByText('$50k')).toBeInTheDocument(); // CAPEX
                expect(screen.getByText('$20k')).toBeInTheDocument(); // OPEX
                expect(screen.getByText('2.5x')).toBeInTheDocument(); // ROI
                expect(screen.getByText('$100k')).toBeInTheDocument(); // Annual Benefit
            });
        });
    });

    describe('Inline Editing', () => {
        it('shows edit button on hover', async () => {
            render(<AICharterPreview {...defaultProps} />);

            // Hover over name field
            const nameElement = screen.getByText('Digital Transformation Initiative');
            await user.hover(nameElement);

            // Edit button should appear (opacity changes via CSS)
        });

        it('enters edit mode on edit button click', async () => {
            render(<AICharterPreview {...defaultProps} />);

            // Find edit button near name
            const nameGroup = screen.getByText('Digital Transformation Initiative').closest('.group');
            const editButton = nameGroup?.querySelector('button');

            if (editButton) {
                await user.click(editButton);

                await waitFor(() => {
                    expect(screen.getByRole('textbox')).toBeInTheDocument();
                });
            }
        });

        it('saves changes on check button click', async () => {
            render(<AICharterPreview {...defaultProps} />);

            // Enter edit mode
            const nameGroup = screen.getByText('Digital Transformation Initiative').closest('.group');
            const editButton = nameGroup?.querySelector('button');

            if (editButton) {
                await user.click(editButton);

                const input = screen.getByRole('textbox');
                await user.clear(input);
                await user.type(input, 'New Initiative Name');

                // Click save
                const saveButton = screen.getByRole('button', { name: '' });
                // Find button with Check icon
            }
        });

        it('cancels edit on X button click', async () => {
            render(<AICharterPreview {...defaultProps} />);

            const nameGroup = screen.getByText('Digital Transformation Initiative').closest('.group');
            const editButton = nameGroup?.querySelector('button');

            if (editButton) {
                await user.click(editButton);

                // Find cancel button and click
                const buttons = screen.getAllByRole('button');
                const cancelButton = buttons.find(btn => btn.querySelector('.lucide-x'));

                if (cancelButton) {
                    await user.click(cancelButton);

                    await waitFor(() => {
                        expect(screen.getByText('Digital Transformation Initiative')).toBeInTheDocument();
                    });
                }
            }
        });
    });

    describe('Section Regeneration', () => {
        it('shows regenerate button for regeneratable sections', async () => {
            render(<AICharterPreview {...defaultProps} />);

            // Problem section should have regenerate button when expanded
            expect(screen.getByText('Regenerate')).toBeInTheDocument();
        });

        it('calls onRegenerateSection when clicked', async () => {
            render(<AICharterPreview {...defaultProps} />);

            const regenerateButton = screen.getByText('Regenerate');
            await user.click(regenerateButton);

            await waitFor(() => {
                expect(mockOnRegenerateSection).toHaveBeenCalledWith('problem');
            });
        });

        it('shows spinner while regenerating', async () => {
            mockOnRegenerateSection.mockImplementation(() => new Promise(() => {})); // Never resolves

            render(<AICharterPreview {...defaultProps} />);

            await user.click(screen.getByText('Regenerate'));

            await waitFor(() => {
                expect(screen.getByText('Regenerating...')).toBeInTheDocument();
            });
        });

        it('does not show regenerate for non-regeneratable sections', async () => {
            render(<AICharterPreview {...defaultProps} />);

            // Financials should not have regenerate button
            await user.click(screen.getByText('Financials'));

            await waitFor(() => {
                // In Financials section, there should be no Regenerate button
                const financialsSection = screen.getByText('Financials').closest('div');
                // Just verify section is expanded
            });
        });
    });

    describe('Empty States', () => {
        it('shows "Not set" for empty values', () => {
            render(<AICharterPreview {...defaultProps} charter={{ ...mockCharter, summary: '' }} />);

            expect(screen.getByText('Not set')).toBeInTheDocument();
        });
    });
});















