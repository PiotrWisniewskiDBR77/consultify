/**
 * @vitest-environment jsdom
 */
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { render, screen, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { StatusTransitionDropdown } from '../../components/PMO/StatusTransitionDropdown';
import { InitiativeStatus } from '../../../types';

// Mock API
vi.mock('../../../services/api', () => ({
    Api: {
        get: vi.fn(),
        post: vi.fn()
    }
}));

// Mock toast
vi.mock('react-hot-toast', () => ({
    default: {
        success: vi.fn(),
        error: vi.fn()
    }
}));

const mockTransitions = [
    {
        fromStatus: InitiativeStatus.DRAFT,
        toStatus: InitiativeStatus.PLANNING,
        requiresReason: false,
        requiresConfirmation: false,
        crossesModule: false
    },
    {
        fromStatus: InitiativeStatus.DRAFT,
        toStatus: InitiativeStatus.CANCELLED,
        requiresReason: true,
        requiresConfirmation: true,
        crossesModule: false
    }
];

describe('StatusTransitionDropdown Component', () => {
    const user = userEvent.setup();

    beforeEach(() => {
        vi.clearAllMocks();
        global.localStorage = {
            getItem: vi.fn(() => 'mock-token'),
            setItem: vi.fn(),
            removeItem: vi.fn(),
            clear: vi.fn(),
            length: 0,
            key: vi.fn()
        } as any;

        // Mock API response
        vi.mocked(Api.get).mockResolvedValue({
            allowedTransitions: mockTransitions
        });
    });

    afterEach(() => {
        vi.resetAllMocks();
    });

    describe('Initial Rendering', () => {
        it('renders current status', async () => {
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                />
            );

            await waitFor(() => {
                expect(screen.getByText('Draft')).toBeInTheDocument();
            });
        });

        it('shows dropdown arrow', async () => {
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                />
            );

            const dropdownButton = screen.getByRole('button');
            expect(dropdownButton).toBeInTheDocument();
        });

        it('fetches allowed transitions on mount', async () => {
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                />
            );

            await waitFor(() => {
                expect(Api.get).toHaveBeenCalledWith('/initiatives/init-1/transitions');
            });
        });
    });

    describe('Dropdown Interactions', () => {
        it('opens dropdown on click', async () => {
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                />
            );

            await waitFor(() => {
                expect(Api.get).toHaveBeenCalled();
            });

            const dropdownButton = screen.getByRole('button');
            await user.click(dropdownButton);

            expect(screen.getByText('Planning')).toBeInTheDocument();
            expect(screen.getByText('Cancelled')).toBeInTheDocument();
        });

        it('closes dropdown when clicking outside', async () => {
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                />
            );

            await waitFor(() => {
                expect(Api.get).toHaveBeenCalled();
            });

            const dropdownButton = screen.getByRole('button');
            await user.click(dropdownButton);

            expect(screen.getByText('Planning')).toBeInTheDocument();

            // Click outside
            await user.click(document.body);

            expect(screen.queryByText('Planning')).not.toBeInTheDocument();
        });
    });

    describe('Status Transitions', () => {
        it('calls onStatusChange for simple transition', async () => {
            const onStatusChange = vi.fn();
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                    onStatusChange={onStatusChange}
                />
            );

            await waitFor(() => {
                expect(Api.get).toHaveBeenCalled();
            });

            const dropdownButton = screen.getByRole('button');
            await user.click(dropdownButton);

            const planningOption = screen.getByText('Planning');
            await user.click(planningOption);

            expect(onStatusChange).toHaveBeenCalledWith(InitiativeStatus.PLANNING, undefined);
        });

        it('shows confirmation modal for transitions requiring confirmation', async () => {
            const onStatusChange = vi.fn();
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                    onStatusChange={onStatusChange}
                />
            );

            await waitFor(() => {
                expect(Api.get).toHaveBeenCalled();
            });

            const dropdownButton = screen.getByRole('button');
            await user.click(dropdownButton);

            const cancelledOption = screen.getByText('Cancelled');
            await user.click(cancelledOption);

            expect(screen.getByText('Confirm Status Change')).toBeInTheDocument();
        });

        it('shows reason modal for transitions requiring reason', async () => {
            const onStatusChange = vi.fn();
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                    onStatusChange={onStatusChange}
                />
            );

            await waitFor(() => {
                expect(Api.get).toHaveBeenCalled();
            });

            const dropdownButton = screen.getByRole('button');
            await user.click(dropdownButton);

            const cancelledOption = screen.getByText('Cancelled');
            await user.click(cancelledOption);

            // Confirm in modal
            const confirmButton = screen.getByRole('button', { name: /confirm/i });
            await user.click(confirmButton);

            expect(screen.getByText('Reason Required')).toBeInTheDocument();
        });

        it('completes transition after providing reason', async () => {
            const onStatusChange = vi.fn();
            vi.mocked(Api.post).mockResolvedValue({ success: true });

            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                    onStatusChange={onStatusChange}
                />
            );

            await waitFor(() => {
                expect(Api.get).toHaveBeenCalled();
            });

            // Open dropdown and select cancelled
            const dropdownButton = screen.getByRole('button');
            await user.click(dropdownButton);

            const cancelledOption = screen.getByText('Cancelled');
            await user.click(cancelledOption);

            // Confirm
            const confirmButton = screen.getByRole('button', { name: /confirm/i });
            await user.click(confirmButton);

            // Provide reason
            const reasonInput = screen.getByPlaceholderText('Enter reason for status change...');
            await user.type(reasonInput, 'Test reason');

            const submitButton = screen.getByRole('button', { name: /submit/i });
            await user.click(submitButton);

            expect(onStatusChange).toHaveBeenCalledWith(InitiativeStatus.CANCELLED, undefined);
        });
    });

    describe('Disabled State', () => {
        it('disables dropdown when disabled prop is true', async () => {
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                    disabled={true}
                />
            );

            const dropdownButton = screen.getByRole('button');
            expect(dropdownButton).toBeDisabled();
        });
    });

    describe('Size Variants', () => {
        it('applies small size classes', () => {
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                    size="sm"
                />
            );

            const dropdownButton = screen.getByRole('button');
            expect(dropdownButton).toHaveClass('px-2', 'py-1', 'text-sm');
        });

        it('applies large size classes', () => {
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                    size="lg"
                />
            );

            const dropdownButton = screen.getByRole('button');
            expect(dropdownButton).toHaveClass('px-4', 'py-3', 'text-lg');
        });
    });

    describe('Label Display', () => {
        it('shows label by default', async () => {
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                />
            );

            await waitFor(() => {
                expect(screen.getByText('Status:')).toBeInTheDocument();
            });
        });

        it('hides label when showLabel is false', async () => {
            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                    showLabel={false}
                />
            );

            await waitFor(() => {
                expect(screen.queryByText('Status:')).not.toBeInTheDocument();
            });
        });
    });

    describe('Loading State', () => {
        it('shows loading indicator during transition', async () => {
            const onStatusChange = vi.fn(() => new Promise(resolve => setTimeout(resolve, 100)));

            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                    onStatusChange={onStatusChange}
                />
            );

            await waitFor(() => {
                expect(Api.get).toHaveBeenCalled();
            });

            const dropdownButton = screen.getByRole('button');
            await user.click(dropdownButton);

            const planningOption = screen.getByText('Planning');
            await user.click(planningOption);

            expect(screen.getByText('Updating...')).toBeInTheDocument();
        });
    });

    describe('Error Handling', () => {
        it('handles API error gracefully', async () => {
            vi.mocked(Api.get).mockRejectedValue(new Error('API Error'));

            render(
                <StatusTransitionDropdown
                    initiativeId="init-1"
                    currentStatus={InitiativeStatus.DRAFT}
                />
            );

            // Component should still render without crashing
            expect(screen.getByRole('button')).toBeInTheDocument();
        });
    });
});














