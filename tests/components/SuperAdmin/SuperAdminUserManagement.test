/**
 * SuperAdminUserManagement Component Tests
 */

import { describe, it, expect, vi, beforeEach } from 'vitest';
import { render, screen } from '@testing-library/react';
import { SuperAdminUserManagement } from '../../../views/superadmin/SuperAdminUserManagement';

// Mock UserManagementCore
vi.mock('../../../components/shared/UserManagementCore', () => ({
    UserManagementCore: ({ mode, organizations, showInvite, showMove, showImpersonate, showBlock, showRoleManagement, showLicenseManagement }: any) => (
        <div data-testid="user-management-core">
            <div>Mode: {mode}</div>
            <div>Organizations: {organizations.length}</div>
            <div>Show Invite: {showInvite ? 'Yes' : 'No'}</div>
            <div>Show Move: {showMove ? 'Yes' : 'No'}</div>
            <div>Show Impersonate: {showImpersonate ? 'Yes' : 'No'}</div>
            <div>Show Block: {showBlock ? 'Yes' : 'No'}</div>
            <div>Show Role Management: {showRoleManagement ? 'Yes' : 'No'}</div>
            <div>Show License Management: {showLicenseManagement ? 'Yes' : 'No'}</div>
        </div>
    )
}));

describe('SuperAdminUserManagement', () => {
    const mockOrganizations = [
        { id: 'org-1', name: 'Org 1', status: 'active' },
        { id: 'org-2', name: 'Org 2', status: 'active' }
    ];

    beforeEach(() => {
        vi.clearAllMocks();
    });

    it('should render user management view', () => {
        render(<SuperAdminUserManagement organizations={mockOrganizations} />);
        
        expect(screen.getByText('User Management')).toBeInTheDocument();
        expect(screen.getByText('Manage all platform users across organizations')).toBeInTheDocument();
    });

    it('should pass correct props to UserManagementCore', () => {
        render(<SuperAdminUserManagement organizations={mockOrganizations} />);
        
        const core = screen.getByTestId('user-management-core');
        expect(core).toBeInTheDocument();
        expect(screen.getByText('Mode: platform')).toBeInTheDocument();
        expect(screen.getByText('Organizations: 2')).toBeInTheDocument();
        expect(screen.getByText('Show Invite: Yes')).toBeInTheDocument();
        expect(screen.getByText('Show Move: Yes')).toBeInTheDocument();
        expect(screen.getByText('Show Impersonate: Yes')).toBeInTheDocument();
        expect(screen.getByText('Show Block: Yes')).toBeInTheDocument();
        expect(screen.getByText('Show Role Management: Yes')).toBeInTheDocument();
        expect(screen.getByText('Show License Management: Yes')).toBeInTheDocument();
    });

    it('should handle empty organizations array', () => {
        render(<SuperAdminUserManagement organizations={[]} />);
        
        expect(screen.getByText('User Management')).toBeInTheDocument();
        expect(screen.getByText('Organizations: 0')).toBeInTheDocument();
    });

    it('should use default empty array when organizations not provided', () => {
        render(<SuperAdminUserManagement />);
        
        expect(screen.getByText('User Management')).toBeInTheDocument();
        expect(screen.getByText('Organizations: 0')).toBeInTheDocument();
    });
});














