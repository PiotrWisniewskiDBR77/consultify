/**
 * IPAccessRulesPanel Tests
 */

import { describe, it, expect, vi, beforeEach } from 'vitest';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import { IPAccessRulesPanel } from '../../components/SuperAdmin/security/IPAccessRulesPanel';
import { Api } from '@/services/api';

// Mock the Api module
vi.mock('@/services/api', () => ({
    Api: {
        get: vi.fn(),
        post: vi.fn(),
        put: vi.fn(),
        delete: vi.fn(),
        getOrganizations: vi.fn(),
    },
}));

// Mock toast
vi.mock('react-hot-toast', () => ({
    toast: {
        success: vi.fn(),
        error: vi.fn(),
    },
}));

describe('IPAccessRulesPanel', () => {
    const mockOrganizations = [
        { id: 'org-1', name: 'Test Organization' },
        { id: 'org-2', name: 'Another Org' },
    ];

    const mockRules = [
        {
            id: 'rule-1',
            organization_id: 'org-1',
            ip_address: '192.168.1.0/24',
            rule_type: 'allow',
            description: 'Office network',
            is_active: 1,
            created_at: '2025-01-01T10:00:00Z',
            created_by_email: 'admin@test.com',
        },
        {
            id: 'rule-2',
            organization_id: 'org-1',
            ip_address: '10.0.0.1',
            rule_type: 'block',
            description: 'Suspicious IP',
            is_active: 1,
            created_at: '2025-01-01T11:00:00Z',
            expires_at: '2025-02-01T11:00:00Z',
        },
    ];

    beforeEach(() => {
        vi.clearAllMocks();
        (Api.getOrganizations as any).mockResolvedValue(mockOrganizations);
        (Api.get as any).mockImplementation((url: string) => {
            if (url.includes('/ip-rules')) {
                return Promise.resolve({ rules: mockRules });
            }
            return Promise.resolve({});
        });
    });

    it('renders and fetches organizations', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(Api.getOrganizations).toHaveBeenCalled();
        });
    });

    it('shows organization select dropdown', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('Test Organization')).toBeTruthy();
        });
    });

    it('fetches IP rules when organization is selected', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(Api.get).toHaveBeenCalledWith('/security-policies/org-1/ip-rules');
        });
    });

    it('displays allowlist and blocklist sections', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('Blocklist')).toBeTruthy();
            expect(screen.getByText('Allowlist')).toBeTruthy();
        });
    });

    it('displays IP rules with descriptions', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('192.168.1.0/24')).toBeTruthy();
            expect(screen.getByText('Office network')).toBeTruthy();
            expect(screen.getByText('10.0.0.1')).toBeTruthy();
            expect(screen.getByText('Suspicious IP')).toBeTruthy();
        });
    });

    it('shows rule counts for each list type', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('1 blocked IPs')).toBeTruthy();
            expect(screen.getByText('1 allowed IPs')).toBeTruthy();
        });
    });

    it('shows Add Rule button', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('Add Rule')).toBeTruthy();
        });
    });

    it('opens add rule modal when Add Rule is clicked', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('Add Rule')).toBeTruthy();
        });

        fireEvent.click(screen.getByText('Add Rule'));

        await waitFor(() => {
            expect(screen.getByText('Add IP Rule')).toBeTruthy();
            expect(screen.getByPlaceholderText('192.168.1.1 or 192.168.0.0/24')).toBeTruthy();
        });
    });

    it('allows selecting rule type in add modal', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            fireEvent.click(screen.getByText('Add Rule'));
        });

        await waitFor(() => {
            // Both Allow and Block buttons should be visible
            expect(screen.getByRole('button', { name: 'Allow' })).toBeTruthy();
            expect(screen.getByRole('button', { name: 'Block' })).toBeTruthy();
        });
    });

    it('creates new IP rule when form is submitted', async () => {
        (Api.post as any).mockResolvedValue({ success: true });
        
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            fireEvent.click(screen.getByText('Add Rule'));
        });

        await waitFor(() => {
            expect(screen.getByPlaceholderText('192.168.1.1 or 192.168.0.0/24')).toBeTruthy();
        });

        // Fill in the form
        fireEvent.change(screen.getByPlaceholderText('192.168.1.1 or 192.168.0.0/24'), {
            target: { value: '172.16.0.0/16' }
        });

        // Click the Add Rule button in the modal
        const addButtons = screen.getAllByText('Add Rule');
        fireEvent.click(addButtons[addButtons.length - 1]);

        await waitFor(() => {
            expect(Api.post).toHaveBeenCalledWith('/security-policies/org-1/ip-rules', expect.objectContaining({
                ipAddress: '172.16.0.0/16',
                ruleType: 'block',
            }));
        });
    });

    it('deletes rule when delete button is clicked', async () => {
        (Api.delete as any).mockResolvedValue({ success: true });
        
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('192.168.1.0/24')).toBeTruthy();
        });

        // Find and click delete button
        const deleteButtons = screen.getAllByTitle('Delete');
        fireEvent.click(deleteButtons[0]);

        await waitFor(() => {
            expect(Api.delete).toHaveBeenCalledWith('/security-policies/org-1/ip-rules/rule-1');
        });
    });

    it('toggles rule status when toggle button is clicked', async () => {
        (Api.put as any).mockResolvedValue({ success: true });
        
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('192.168.1.0/24')).toBeTruthy();
        });

        // Find and click disable button
        const toggleButtons = screen.getAllByTitle('Disable');
        fireEvent.click(toggleButtons[0]);

        await waitFor(() => {
            expect(Api.put).toHaveBeenCalledWith('/security-policies/org-1/ip-rules/rule-1', { isActive: false });
        });
    });

    it('shows info banner about how IP rules work', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('How IP rules work:')).toBeTruthy();
        });
    });

    it('displays expiration date for rules with expiry', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText(/Expires/)).toBeTruthy();
        });
    });

    it('shows creator email when available', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('admin@test.com')).toBeTruthy();
        });
    });

    it('refreshes rules when refresh button is clicked', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            expect(screen.getByText('192.168.1.0/24')).toBeTruthy();
        });

        vi.clearAllMocks();
        
        const refreshButton = screen.getByTitle('Refresh');
        fireEvent.click(refreshButton);

        await waitFor(() => {
            expect(Api.get).toHaveBeenCalledWith('/security-policies/org-1/ip-rules');
        });
    });

    it('closes modal when cancel is clicked', async () => {
        render(<IPAccessRulesPanel />);
        
        await waitFor(() => {
            fireEvent.click(screen.getByText('Add Rule'));
        });

        await waitFor(() => {
            expect(screen.getByText('Add IP Rule')).toBeTruthy();
        });

        fireEvent.click(screen.getByText('Cancel'));

        await waitFor(() => {
            expect(screen.queryByText('Add IP Rule')).toBeFalsy();
        });
    });
});













