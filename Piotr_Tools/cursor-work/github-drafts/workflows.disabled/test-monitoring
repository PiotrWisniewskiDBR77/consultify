# Test Monitoring and Reporting Workflow
# Runs daily to track test performance and coverage trends

name: Test Monitoring

on:
  schedule:
    # Run daily at 2 AM UTC
    - cron: '0 2 * * *'
  workflow_dispatch: # Allow manual trigger

env:
  NODE_VERSION: '20'

jobs:
  test-monitoring:
    name: Test Performance Monitoring
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Run All Tests with Coverage
        run: |
          npm run test:all -- --coverage --reporter=verbose --reporter=junit --outputFile=junit-all.xml
        env:
          NODE_ENV: test
          MOCK_DB: 'true'
          MOCK_REDIS: 'true'
          DB_TYPE: 'sqlite'

      - name: Generate Coverage Report
        run: |
          echo "## Coverage Report" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          if [ -f coverage/coverage-summary.json ]; then
            echo "Coverage data available in coverage/coverage-summary.json" >> $GITHUB_STEP_SUMMARY
          fi

      - name: Upload Coverage to Codecov
        uses: codecov/codecov-action@v4
        with:
          files: ./coverage/coverage-final.json
          flags: monitoring
          fail_ci_if_error: false
          token: ${{ secrets.CODECOV_TOKEN }}

      - name: Upload Test Results
        uses: actions/upload-artifact@v4
        with:
          name: test-monitoring-results
          path: |
            junit-all.xml
            coverage/
          retention-days: 90

      - name: Test Performance Analysis
        run: |
          echo "## Test Performance Analysis" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "Test execution completed. Results saved for trend analysis." >> $GITHUB_STEP_SUMMARY










