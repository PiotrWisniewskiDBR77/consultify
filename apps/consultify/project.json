{
  "name": "consultify",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:app", "type:consultify"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "npm run build -w apps/consultify/backend",
          "npm run build -w apps/consultify/frontend"
        ],
        "parallel": true
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "npm run dev -w apps/consultify/backend",
          "npm run dev -w apps/consultify/frontend"
        ],
        "parallel": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm run test -w apps/consultify/backend",
          "npm run test -w apps/consultify/frontend"
        ],
        "parallel": true
      }
    }
  }
}



