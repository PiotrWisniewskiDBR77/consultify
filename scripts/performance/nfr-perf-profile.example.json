{
  "schemaVersion": 1,
  "productSha": "0000000000000000000000000000000000000000",
  "baseUrl": "http://127.0.0.1:3001",
  "shaProbe": { "method": "GET", "path": "/api/health", "expectedStatus": 200, "shaJsonPointer": "/gitSha" },
  "variables": { "CASE_ID": "replace-primary-case-id", "PRIMARY_ORG_ID": "replace-primary-org-id", "PRIMARY_INITIATIVE_ID": "replace-primary-initiative-id", "PRIMARY_ROI_CASE_ID": "replace-primary-roi-case-id", "TARGET_SETTINGS_USER_ID": "replace-primary-settings-user-id", "PRIMARY_SETTINGS_MARKER": "replace-primary-settings-marker" },
  "modules": [
    {
      "name": "case",
      "read": { "method": "GET", "path": "/api/v8/case-workspace/cases/{{CASE_ID}}", "expectedStatus": 200 },
      "write": { "method": "POST", "path": "/api/v8/case-workspace/cases/{{CASE_ID}}/governance-tier", "expectedStatus": 200, "body": { "tier": "STANDARD", "reason": "NFR {{REQUEST_ID}}" }, "fixedIdVariable": "CASE_ID", "reconcile": { "method": "GET", "path": "/api/v8/case-workspace/cases/{{ID}}", "expectedStatus": 200, "idJsonPointer": "/data/caseId" } },
      "crossTenantRead": { "method": "GET", "path": "/api/v8/case-workspace/cases/{{CASE_ID}}", "expectedStatus": 200 }
    },
    {
      "name": "my-work",
      "read": { "method": "GET", "path": "/api/my-work/personal-tasks", "expectedStatus": 200 },
      "write": { "method": "POST", "path": "/api/my-work/personal-tasks", "expectedStatus": 201, "expectedReplayStatuses": [200, 201], "body": { "title": "NFR {{REQUEST_ID}}", "idempotencyKey": "{{REQUEST_ID}}" }, "idJsonPointer": "/id", "reconcile": { "method": "GET", "path": "/api/my-work/personal-tasks/{{ID}}", "expectedStatus": 200, "idJsonPointer": "/id" } },
      "crossTenantRead": { "method": "GET", "path": "/api/my-work/personal-tasks/{{PRIMARY_TASK_ID}}", "expectedStatus": 200 }
    },
    {
      "name": "settings",
      "read": { "method": "GET", "path": "/api/settings/preferences/notifications", "expectedStatus": 200 },
      "write": { "method": "PUT", "path": "/api/settings/preferences/notifications", "expectedStatus": 200, "body": { "preferences": { "email": true, "push": true, "inApp": true, "digest": "daily", "nfrMarker": "{{REQUEST_ID}}" } }, "fixedIdVariable": "AUTH_USER_ID", "reconcile": { "method": "GET", "path": "/api/settings/preferences/notifications", "expectedStatus": 200, "valueJsonPointer": "/preferences/nfrMarker", "expectedValueVariable": "REQUEST_ID" } },
      "crossTenantRead": { "method": "GET", "path": "/api/settings/preferences/notifications?userId={{TARGET_SETTINGS_USER_ID}}", "expectedStatus": 200, "targetValueJsonPointer": "/preferences/nfrMarker", "expectedTargetVariable": "PRIMARY_SETTINGS_MARKER" }
    },
    {
      "name": "initiative",
      "read": { "method": "GET", "path": "/api/initiatives/{{PRIMARY_INITIATIVE_ID}}", "expectedStatus": 200 },
      "write": { "method": "PUT", "path": "/api/initiatives/{{PRIMARY_INITIATIVE_ID}}", "expectedStatus": 200, "body": { "description": "NFR {{REQUEST_ID}}" }, "fixedIdVariable": "PRIMARY_INITIATIVE_ID", "reconcile": { "method": "GET", "path": "/api/initiatives/{{ID}}", "expectedStatus": 200, "idJsonPointer": "/id" } },
      "crossTenantRead": { "method": "GET", "path": "/api/initiatives/{{PRIMARY_INITIATIVE_ID}}", "expectedStatus": 200 }
    },
    {
      "name": "finance",
      "read": { "method": "GET", "path": "/api/vnext/results/roi/cases/{{PRIMARY_ROI_CASE_ID}}/assumptions", "expectedStatus": 200 },
      "write": { "method": "POST", "path": "/api/vnext/results/roi/cases/{{PRIMARY_ROI_CASE_ID}}/assumptions", "expectedStatus": 201, "expectedReplayStatuses": [200, 201], "body": { "category": "other", "label": "NFR {{REQUEST_ID}}", "idempotencyKey": "{{REQUEST_ID}}" }, "idJsonPointer": "/assumption/assumptionId", "commandIdJsonPointer": "/eventId", "reconcile": { "method": "GET", "path": "/api/vnext/results/roi/cases/{{PRIMARY_ROI_CASE_ID}}/assumptions/{{ID}}", "expectedStatus": 200, "idJsonPointer": "/assumption/assumptionId" } },
      "crossTenantRead": { "method": "GET", "path": "/api/vnext/results/roi/cases/{{PRIMARY_ROI_CASE_ID}}", "expectedStatus": 200, "targetValueJsonPointer": "/case/caseId", "expectedTargetVariable": "PRIMARY_ROI_CASE_ID" }
    }
  ]
}
