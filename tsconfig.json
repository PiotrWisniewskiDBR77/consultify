{
  "compilerOptions": {
    // Build settings
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Module resolution
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "noEmit": true,
    // Path aliases
    "paths": {
      "@/*": ["./src/*"]
    },
    // Type checking - STRICT MODE (Enterprise SaaS Standard)
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": false,
    "alwaysStrict": true,
    // Code quality checks
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": false,
    // Decorators (for DI/ORM if needed)
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    // Performance
    "skipLibCheck": true,
    // Types
    "types": ["node", "vite/client", "@testing-library/jest-dom", "vitest/globals"]
  },
  "include": ["src", "*.ts", "*.tsx"],
  "exclude": [
    "node_modules",
    "node_modules_trash",
    "dist",
    "server",
    "server/**/*",
    // Te CZTERY testy integracyjne mieszkaja w src/, ale importuja
    // server/src/** (Gateway, queryHelpers, OrgMemberSyncService). "exclude"
    // NIE powstrzymuje TypeScriptu przed sledzeniem importow, wiec przez nie
    // caly serwer wchodzil do sprawdzania typow FRONTU — wbrew wykluczeniu
    // "server" dwie linie wyzej.
    //
    // Skutek byl mierzalny: 849 z 877 bledow tego sprawdzenia pochodzilo
    // z serwera, a 844 z nich to TS7030 ("not all code paths return a value")
    // — regula, ktora server/tsconfig.json ustawia na false CELOWO, bo
    // handlery Express nie zwracaja na kazdej sciezce. Serwer sprawdzony
    // WLASNA konfiguracja ma 0 bledow. To byl artefakt sadzenia serwera
    // regulami frontu, nie defekt.
    //
    // Pliki nadal uruchamia vitest — wypada tylko sprawdzanie typow frontowa
    // konfiguracja. Typy serwera pilnuje osobny krok CI (server/tsconfig.json).
    "src/components/MyWork/__tests__/day155.attachmentPersistence.realpg.test.ts",
    "src/components/MyWork/__tests__/day148.objectAttachments.realpg.test.ts",
    "src/components/MyWork/__tests__/CommentPersistence.day140.pg.test.ts",
    "src/components/MyWork/table/__tests__/TablePlatformFrontend.test.tsx",
    "src/components/Initiatives/__tests__/initiativeSections.day136.pg.test.ts",
    "src/method-core-adapters/audits/__tests__/auditsKernelAdapter.test.ts",
    // DOPISANE 2026-09-02 przy scaleniu linii m03 x batch241-269: gałąź batch
    // wniosła DWA nowe testy tej samej rodziny (front w src/, import server/src),
    // przez które serwer wracał do sprawdzania typów frontu — 856 błędów, z tego
    // 848 to TS7030, czyli dokładnie ten sam artefakt, który zawężenie wyżej
    // usunęło dzień wcześniej. Naprawa per-plik odrasta, więc rodzina jest tu
    // wypisana w całości (pomiar: grep za importem server/src w src/).
    "src/components/Audit/method/__tests__/day220-audyty-rejestr.r1.test.tsx",
    "src/components/Initiatives/__tests__/initiativeAttachments.persistence.realpg.test.ts",
    "_backup/**",
    "_quarantine/**",
    "Piotr_Tools/**",
    "config/tours/**",
    // Exclude duplicate/copy files like \"file 2.tsx\"
    // NOTE: tsconfig patterns are not full glob/regex (no character classes like [0-9]).
    // Keep explicit excludes for known editor copies that should never be part of the build.
    "src/views/admin/AdminSettingsModule 4.tsx",
    "src/views/admin/AdminSettingsModule 5.tsx",
    "src/views/admin/AdminSettingsModule 6.tsx",
    "src/views/settings/AppearanceModule 4.tsx",
    "**/* copy.*",
    "**/* *.ts",
    "**/* *.tsx",
    "**/* *.d.ts",
    // Extra safety: exclude common "name 2.tsx" editor copies in src/
    "src/components/layout/ChatPanel *.tsx",
    "src/components/layout/NotificationDropdown *.tsx",
    "src/components/layout/SplitLayout *.tsx",
    "src/components/Reports/ReportBuilder/ReportBuilder *.tsx",
    "src/components/Reports/ReportBuilder/ReportPreview *.tsx",
    "src/hooks/discovery/useToolAI *.ts",
    "src/store/slices/authSlice *.ts",
    "src/store/slices/chatSlice *.ts",
    "src/store/slices/uiSlice *.ts",
    "src/types/domain/ai *.ts",
    "src/types/vendor/reactflow.d *.ts",
    "src/views/admin/AdminView (*.tsx)",
    "src/views/admin/AdminView (1).tsx",
    "src/components/DiscoveryTools/tools/RiskUncertainty/AssumptionsStep (*.tsx)",
    "src/components/DiscoveryTools/tools/RiskUncertainty/AssumptionsStep (1).tsx",
    "src/components/DiscoveryTools/tools/RiskUncertainty/ScenariosStep (*.tsx)",
    "src/components/DiscoveryTools/tools/RiskUncertainty/ScenariosStep (1).tsx",
    "**/*.icloud"
  ]
}
