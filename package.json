{
  "name": "consultinity",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*/frontend",
    "apps/*/backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\"",
    "dev:londyn": "bash ./start-londyn.sh",
    "dev:frontend": "vite --port 3000 --strictPort",
    "lint": "eslint . --report-unused-disable-directives",
    "type-check": "tsc --noEmit",
    "dev:backend": "cd server && PORT=3001 DB_TYPE=sqlite SQLITE_PATH=../data/dev/consultinity.db npm run dev",
    "fix:credentials": "./server/scripts/fix-dbr77-credentials.sh",
    "seed:notifications": "./server/scripts/seed-notifications.sh",
    "build:backend": "cd server && npm run build",
    "start": "cd server && npm run build && NODE_ENV=production node dist/index.js",
    "start:dev": "cd server && NODE_ENV=production npx tsx src/index.ts",
    "build": "npm run build:shared && vite build",
    "build:shared": "npm run build -w packages/shared",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:unit": "vitest run tests/unit",
    "test:unit:critical": "vitest run tests/unit/backend/permissionService.test.ts tests/unit/backend/tokenBillingService.test.ts tests/unit/backend/regulatoryModeGuard.test.ts tests/unit/backend/accessPolicyService.test.js tests/unit/backend/services/billingService.test.ts tests/unit/backend/middleware/authMiddleware.test tests/unit/backend/middleware/permissionMiddleware.test.js --reporter=verbose",
    "test:component": "vitest run tests/components",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:backend": "vitest run tests/unit/backend --environment node",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/performance/load-test.js",
    "test:performance": "vitest run --config vitest.perf.config.ts",
    "test:memory-leak": "vitest run tests/performance/memory-leak.test.js --reporter=verbose",
    "test:all": "npm run test:unit && npm run test:component && npm run test:integration",
    "test:security": "npm audit --audit-level=high && vitest run tests/security",
    "test:complete": "npm run test:all && npm run test:e2e && npm run test:performance && npm run test:security",
    "test:cleanup": "node scripts/testing/cleanup-test-artifacts.js",
    "test:audit": "npx tsx scripts/testing/run-audit.ts --quick",
    "test:audit:full": "npx tsx scripts/testing/run-audit.ts --full --report --update-registry",
    "test:coverage": "npm run test:all -- --coverage",
    "test:coverage:check": "npm run test:coverage && node --loader ts-node/esm scripts/check-coverage.ts",
    "test:coverage:lcov": "npm run test:coverage -- --reporter=lcov",
    "test:coverage:html": "npm run test:coverage -- --reporter=html",
    "test:performance:budget": "node scripts/check-performance-budget.js",
    "test:contract:consumer": "vitest run tests/contracts/**/*.consumer.test.js",
    "test:contract:provider": "vitest run tests/contracts/**/*.provider.test.js",
    "test:contract": "npm run test:contract:consumer && npm run test:contract:provider",
    "test:visual": "playwright test tests/visual --headed",
    "test:visual:percy": "percy exec -- playwright test tests/visual",
    "nx": "nx",
    "nx:build": "nx run-many -t build",
    "nx:test": "nx run-many -t test",
    "nx:lint": "nx run-many -t lint",
    "nx:affected": "nx affected",
    "nx:graph": "nx graph",
    "nx:serve:consultinity": "nx serve consultinity",
    "nx:serve:new-app": "nx serve new-app",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:migrate:backfill": "tsx server/scripts/migrate.ts backfill",
    "db:backup": "bash server/scripts/backup-database.sh",
    "db:restore": "bash server/scripts/restore-database.sh",
    "db:rollback": "tsx server/scripts/rollback-migration.ts",
    "db:generate-er": "tsx server/scripts/generate-er-diagram.ts",
    "db:check-integrity": "tsx server/scripts/check-data-integrity.ts",
    "db:test": "tsx server/scripts/test-database-auth.ts",
    "db:health": "curl http://localhost:3005/api/health/database",
    "db:metrics": "curl http://localhost:3005/api/metrics/database",
    "db:slow-queries": "curl http://localhost:3005/api/metrics/slow-queries",
    "test:database": "vitest run tests/database",
    "prepare": "husky",
    "dev:check": "npm run lint && npm run type-check",
    "dev:test": "vitest run tests/unit --watch",
    "dev:full": "npm run dev:check && npm run dev:test",
    "verify": "npm run lint && npm run type-check && npm run test:all && npm run test:security",
    "verify:quick": "npm run lint && npm run type-check && npm run test:unit",
    "pre-push": "npm run lint && npm run type-check && npm run test:unit",
    "security:local": "npm audit --audit-level=high",
    "security:check": "npm run security:local && npm run test:security",
    "deps:check": "npm audit --audit-level=moderate",
    "deps:update": "npm audit fix",
    "deps:security": "npx snyk test && npx snyk monitor || echo 'Snyk not configured, skipping...'",
    "license:check": "npx license-checker --onlyAllow 'MIT;Apache-2.0;BSD-3-Clause;ISC;BSD-2-Clause;0BSD' || echo 'License checker not installed, skipping...'",
    "validate": "npm run lint && npm run type-check && npm run test:unit && npm run test:security",
    "i18n:check": "npx ts-node scripts/i18n/translate-help.ts --check",
    "i18n:translate": "npx ts-node scripts/i18n/translate-help.ts --translate",
    "i18n:validate": "npx ts-node scripts/i18n/translate-help.ts --validate"
  },
  "overrides": {
    "react-is": "^19.0.0"
  },
