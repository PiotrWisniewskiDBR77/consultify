{
  "name": "consultify",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\"",
    "dev:frontend": "vite",
    "lint": "eslint . --report-unused-disable-directives",
    "type-check": "tsc --noEmit",
    "dev:backend": "node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/components",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:backend": "vitest run tests/unit/backend --environment node",
    "test:e2e": "playwright test",
    "test:load": "node tests/performance/load-test.js",
    "test:performance": "vitest run --config vitest.perf.config.ts",
    "test:all": "npm run test:unit && npm run test:component && npm run test:integration",
    "test:coverage": "npm run test:all -- --coverage"
  },
