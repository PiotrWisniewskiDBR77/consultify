ENV VITE_WORKSPACE_BREADCRUMB_RECENTS_ARROW_KEYS=${VITE_WORKSPACE_BREADCRUMB_RECENTS_ARROW_KEYS}
ENV VITE_WORKSPACE_BREADCRUMB_RECENTS_PINNED=${VITE_WORKSPACE_BREADCRUMB_RECENTS_PINNED}
