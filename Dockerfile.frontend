# Consultify Frontend Dockerfile
# Production-optimized build for Railway deployment

# ==========================================
# STAGE 1: Frontend Builder
# ==========================================
FROM node:20-alpine AS frontend-builder
WORKDIR /app

# ---------------------------------------------------------------------------
# BEZPIECZNIK VITE_* (2026-08-28, nawiązanie do awarii "panel never worked
# on staging/demo" z 2026-06-14 — ten sam mechanizm co w Dockerfile.api).
#
# 1) STRONA "działa/nie działa": `vite build` (wywoływane przez `npm run
#    build` niżej) wpala VITE_* do kodu przeglądarki W TRAKCIE BUDOWANIA
#    obrazu, nie przy starcie kontenera. Railway podaje service variables
#    jako build-argi, ale Docker udostępnia je do `RUN`/`vite build` TYLKO
#    jeśli są tu zadeklarowane jako `ARG`. Ten plik miał ZERO takich
#    deklaracji — każda flaga kliencka `VITE_*` ustawiona w Railway dla
#    usługi budowanej z tego Dockerfile była po cichu IGNOROWANA: bez
#    błędu builda, ekran/flaga po prostu się nie pojawiał. KAŻDA nowa
#    flaga kliencka `VITE_*` dodana w kodzie musi dostać tu `ARG X` +
#    `ENV X=${X}`, inaczej zostanie tak samo zignorowana.
#
# 2) STRONA bezpieczeństwa (odwrotna pułapka): `ARG` dla zmiennej `VITE_*`
#    niosącej POŚWIADCZENIE, TOKEN, KLUCZ lub SEKRET wkleja ten sekret
#    WPROST do bundla JS pobieranego przez przeglądarkę każdego widza —
#    Vite wstawia cały obiekt `import.meta.env` w każde miejsce użycia,
#    więc sekret ląduje nawet w chunkach niezwiązanych z logowaniem.
#    Filtr hostowy w runtime NIE chroni (build już się wydarzył).
#    PRZYKŁAD, którego NIGDY nie wolno tu dopisać: `VITE_QUICK_ACCESS_MAP`
#    (mapa PIN → e-mail+hasło kont właściciela/Pawła/superadmina). Ta sama
#    zasada obejmuje każdą przyszłą zmienną `VITE_*` niosącą dane logowania,
#    token, klucz API lub inny sekret — przy wątpliwości NIE dopisuj i
#    zgłoś w code review.
#
# Poniższe ARG-i to flagi FUNKCYJNE (booleany/identyfikatory), bez wartości
# domyślnych — `ARG X` bez `=wartość` oznacza "przekaż dalej, jeśli Railway
# ją ustawił", nigdy "włącz wszędzie".
# ---------------------------------------------------------------------------
