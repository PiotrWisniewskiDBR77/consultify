# Local override to connect your local dev server to STAGING database.
# Copy to `.env.staging.local` and fill in secrets (DO NOT COMMIT `.env.staging.local`).
#
# Usage:
#   npm run dev:staging
#
# Safety:
# - `DB_MANAGED_SCHEMA=off` is set by the npm script to prevent any auto-migrations/DDL.
# - For LOCAL runs, use the Railway Public/External Postgres URL.
# - Do NOT paste `*.railway.internal` here. That host works only inside Railway.
# - If both are present, local tooling will prefer `DATABASE_PUBLIC_URL` over a private Railway `DATABASE_URL`.
# - This file should continue to point only at the shared staging/test database, never production.
#

DB_TYPE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional but recommended when the primary Railway service variable is private:
# DATABASE_PUBLIC_URL=postgresql://USER:PASSWORD@PUBLIC-HOST:PORT/DBNAME

# If staging requires SSL:
# DB_SSL=require
# DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: mark connections in pg_stat_activity
# PGAPPNAME=consultinity-local-dev

# Optional: disable background jobs when using shared staging
DISABLE_SCHEDULER=true

# Optional branded demo tenant override for local demo work against staging.
# DEMO_ORG_ID=atelier
# DEMO_ORG_NAME=Atelier Toys
# ALLOW_NONDEFAULT_DEMO_ORG=1
# ALLOW_BRANDED_DEMO_ORG=1
# ALLOW_ATELIER_AS_DEMO_ORG=1

