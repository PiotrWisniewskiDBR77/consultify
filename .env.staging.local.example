# Local override to connect your local dev server to STAGING database.
# Copy to `.env.staging.local` and fill in secrets (DO NOT COMMIT `.env.staging.local`).
#
# Usage:
#   npm run dev:staging
#
# Safety:
# - `DB_MANAGED_SCHEMA=off` is set by the npm script to prevent any auto-migrations/DDL.
#

DB_TYPE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# If staging requires SSL:
# DB_SSL=require
# DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: mark connections in pg_stat_activity
# PGAPPNAME=consultinity-local-dev

# Optional: disable background jobs when using shared staging
DISABLE_SCHEDULER=true

