{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Keep production emit aligned with the source typecheck. In particular,
    // discriminated result unions only narrow soundly with strict null checks.
    "strict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,

    // Code quality — relaxed for now
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,

    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "inlineSources": false,
    "incremental": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    ".tsbuildinfo",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/**/* *.ts",
    "src/_backup/**",
    "src/scripts/**",
    "**/*.js"
  ],
  "include": ["src/**/*", "types/**/*", "scripts/migrate.postgres.ts", "scripts/release-migration-gate.ts"]
}
