{
  "name": "server",
  "version": "1.0.0",
  "description": "Consultify Backend Server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:ts": "tsx watch src/index.ts",
    "build": "tsc --build",
    "build:clean": "rm -rf dist && tsc --build",
    "build:watch": "tsc --build --watch",
    "build:fast": "tsc --build --incremental",
    "typecheck": "tsc --noEmit",
    "type-check:backend": "tsc --noEmit",
    "test": "vitest run",
    "test:backend": "vitest run tests --environment node",
    "test:backend:watch": "vitest watch tests --environment node",
    "test:backend:coverage": "vitest run tests --coverage --environment node",
    "start": "node dist/index.js",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.1.2",
    "mammoth": "^1.11.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
