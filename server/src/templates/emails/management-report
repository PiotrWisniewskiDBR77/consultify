<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{reportTitle}}</title>
    <style>
        /* Reset */
        body, table, td, p, a, h1, h2, h3, h4 {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }
        
        body {
            background-color: #f1f5f9;
            padding: 20px;
        }
        
        /* Container */
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        
        /* Header */
        .header {
            background: linear-gradient(135deg, #85182F 0%, #6D1427 100%);
            padding: 32px 24px;
            text-align: center;
        }
        
        .header-logo {
            max-height: 40px;
            margin-bottom: 16px;
        }
        
        .header h1 {
            color: #ffffff;
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        
        .header p {
            color: rgba(255, 255, 255, 0.85);
            font-size: 14px;
        }
        
        /* Report Type Badge */
        .report-badge {
            display: inline-block;
            background-color: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            margin-top: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        /* Content */
        .content {
            padding: 32px 24px;
        }
        
        .greeting {
            font-size: 16px;
            color: #334155;
            margin-bottom: 24px;
            line-height: 1.6;
        }
        
        /* Status Summary */
        .status-summary {
            background-color: #f8fafc;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 24px;
        }
        
        .status-summary h3 {
            color: #1e293b;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 16px;
        }
        
        /* RAG Status Grid */
        .rag-grid {
            display: table;
            width: 100%;
            border-collapse: separate;
            border-spacing: 8px;
        }
        
        .rag-item {
            display: table-cell;
            width: 33.33%;
            text-align: center;
            padding: 12px;
            border-radius: 6px;
            background-color: #ffffff;
        }
        
        .rag-indicator {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            margin: 0 auto 8px;
        }
        
        .rag-green { background-color: #22c55e; }
        .rag-amber { background-color: #f59e0b; }
        .rag-red { background-color: #ef4444; }
        .rag-grey { background-color: #94a3b8; }
        
        .rag-label {
            font-size: 11px;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        /* Key Metrics */
        .metrics-row {
            display: table;
            width: 100%;
            margin-bottom: 24px;
        }
        
        .metric-cell {
            display: table-cell;
            width: 25%;
            padding: 12px;
            text-align: center;
            background-color: #f8fafc;
            border-radius: 6px;
        }
        
        .metric-value {
            font-size: 24px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 4px;
        }
        
        .metric-label {
            font-size: 11px;
            color: #64748b;
            text-transform: uppercase;
        }
        
        /* Highlights & Concerns */
        .section {
            margin-bottom: 24px;
        }
        
        .section h4 {
            font-size: 14px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .section-icon {
            width: 18px;
            height: 18px;
        }
        
        .highlight-list, .concern-list {
            list-style: none;
            padding: 0;
        }
        
        .highlight-list li, .concern-list li {
            padding: 8px 12px;
            margin-bottom: 8px;
            border-radius: 6px;
            font-size: 14px;
            line-height: 1.5;
        }
        
        .highlight-list li {
            background-color: #ecfdf5;
            color: #065f46;
            border-left: 3px solid #22c55e;
        }
        
        .concern-list li {
            background-color: #fef3c7;
            color: #92400e;
            border-left: 3px solid #f59e0b;
        }
        
        /* CTA Buttons */
        .cta-section {
            text-align: center;
            padding: 24px;
            background-color: #f8fafc;
            border-radius: 8px;
        }
        
        .btn {
            display: inline-block;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            margin: 0 8px 8px;
        }
        
        .btn-primary {
            background-color: #85182F;
            color: #ffffff;
        }
        
        .btn-secondary {
            background-color: #ffffff;
            color: #1e293b;
            border: 1px solid #e2e8f0;
        }
        
        /* Footer */
        .footer {
            padding: 24px;
            background-color: #1e293b;
            text-align: center;
        }
        
        .footer p {
            color: #94a3b8;
            font-size: 12px;
            margin-bottom: 8px;
        }
        
        .footer a {
            color: #A82D49;
            text-decoration: none;
        }
        
        .powered-by {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid #334155;
        }
        
        /* Responsive */
        @media only screen and (max-width: 600px) {
            .content {
                padding: 24px 16px;
            }
            
            .rag-item, .metric-cell {
                display: block;
                width: 100%;
                margin-bottom: 8px;
            }
            
            .rag-grid, .metrics-row {
                display: block;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Header -->
        <div class="header">
            {{#if branding.logoUrl}}
            <img src="{{branding.logoUrl}}" alt="{{branding.companyName}}" class="header-logo">
            {{/if}}
            <h1>{{reportTitle}}</h1>
            <p>{{periodLabel}}</p>
            <span class="report-badge">{{reportTypeName}}</span>
        </div>
        
        <!-- Content -->
        <div class="content">
            <p class="greeting">
                Hello,<br><br>
                A new {{reportTypeName}} has been generated for your review. Here's a summary of the key findings:
            </p>
            
            <!-- RAG Status (for Steering Committee reports) -->
            {{#if hasRAGStatus}}
            <div class="status-summary">
                <h3>Overall Status</h3>
                <div class="rag-grid">
                    {{#each ragStatus}}
                    <div class="rag-item">
                        <div class="rag-indicator rag-{{toLowerCase this.status}}"></div>
                        <div class="rag-label">{{this.category}}</div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{/if}}
            
            <!-- Key Metrics -->
            {{#if hasMetrics}}
            <div class="metrics-row">
                {{#each metrics}}
                <div class="metric-cell">
                    <div class="metric-value">{{this.value}}{{this.unit}}</div>
                    <div class="metric-label">{{this.label}}</div>
                </div>
                {{/each}}
            </div>
            {{/if}}
            
            <!-- Highlights -->
            {{#if highlights.length}}
            <div class="section">
                <h4>
                    <svg class="section-icon" fill="none" stroke="#22c55e" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Key Highlights
                </h4>
                <ul class="highlight-list">
                    {{#each highlights}}
                    <li>{{this}}</li>
                    {{/each}}
                </ul>
            </div>
            {{/if}}
            
            <!-- Concerns -->
            {{#if concerns.length}}
            <div class="section">
                <h4>
                    <svg class="section-icon" fill="none" stroke="#f59e0b" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                    Areas of Attention
                </h4>
                <ul class="concern-list">
                    {{#each concerns}}
                    <li>{{this}}</li>
                    {{/each}}
                </ul>
            </div>
            {{/if}}
            
            <!-- AI Summary -->
            {{#if aiNarrative}}
            <div class="section">
                <h4>
                    <svg class="section-icon" fill="none" stroke="#85182F" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                    AI Summary
                </h4>
                <p style="font-size: 14px; color: #475569; line-height: 1.6;">
                    {{aiNarrative}}
                </p>
            </div>
            {{/if}}
            
            <!-- CTA -->
            <div class="cta-section">
                <p style="font-size: 14px; color: #64748b; margin-bottom: 16px;">
                    View the full report for complete details and analysis.
                </p>
                <a href="{{viewReportUrl}}" class="btn btn-primary">View Full Report</a>
                {{#if pdfUrl}}
                <a href="{{pdfUrl}}" class="btn btn-secondary">Download PDF</a>
                {{/if}}
            </div>
        </div>
        
        <!-- Footer -->
        <div class="footer">
            <p>This report was automatically generated on {{generatedDate}}</p>
            <p>Questions? <a href="mailto:{{supportEmail}}">Contact Support</a></p>
            
            {{#unless branding.hidePoweredBy}}
            <div class="powered-by">
                <p>Powered by <a href="https://consultify.ai">Consultify</a> - Enterprise PMO Platform</p>
            </div>
            {{/unless}}
        </div>
    </div>
</body>
</html>















