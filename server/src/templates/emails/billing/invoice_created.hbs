<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Invoice Available</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #0F172A; margin: 0; padding: 0; background-color: #f5f5f7; }
        .container { max-width: 600px; margin: 0 auto; background: #ffffff; }
        .header { background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); padding: 40px 30px; text-align: center; }
        .header h1 { color: #ffffff; margin: 0; font-size: 24px; font-weight: 600; }
        .header .logo { margin-bottom: 20px; }
        .content { padding: 40px 30px; }
        .invoice-box { background: #f8f9fa; border-radius: 12px; padding: 24px; margin: 20px 0; border-left: 4px solid #85182F; }
        .invoice-number { font-size: 14px; color: #6b7280; margin-bottom: 8px; }
        .invoice-amount { font-size: 32px; font-weight: 700; color: #0F172A; }
        .invoice-currency { font-size: 16px; color: #6b7280; }
        .details-table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        .details-table td { padding: 12px 0; border-bottom: 1px solid #e5e7eb; }
        .details-table td:first-child { color: #6b7280; }
        .details-table td:last-child { text-align: right; font-weight: 500; }
        .btn { display: inline-block; background: #85182F; color: #ffffff !important; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-weight: 600; margin: 20px 0; }
        .btn:hover { background: #6D1427; }
        .footer { background: #f8f9fa; padding: 30px; text-align: center; font-size: 13px; color: #6b7280; }
        .footer a { color: #85182F; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">
                <img src="{{logoUrl}}" alt="{{companyName}}" height="40" style="max-height: 40px;">
            </div>
            <h1>New Invoice Available</h1>
        </div>
        
        <div class="content">
            <p>Hello {{recipientName}},</p>
            
            <p>A new invoice has been generated for your account. Here are the details:</p>
            
            <div class="invoice-box">
                <div class="invoice-number">Invoice #{{invoiceNumber}}</div>
                <div class="invoice-amount">
                    <span class="invoice-currency">{{currency}}</span> {{amount}}
                </div>
            </div>
            
            <table class="details-table">
                <tr>
                    <td>Invoice Date</td>
                    <td>{{invoiceDate}}</td>
                </tr>
                <tr>
                    <td>Due Date</td>
                    <td>{{dueDate}}</td>
                </tr>
                <tr>
                    <td>Billing Period</td>
                    <td>{{billingPeriod}}</td>
                </tr>
                {{#if planName}}
                <tr>
                    <td>Plan</td>
                    <td>{{planName}}</td>
                </tr>
                {{/if}}
            </table>
            
            <p style="text-align: center;">
                <a href="{{invoiceUrl}}" class="btn">View Invoice</a>
            </p>
            
            {{#if autoPayEnabled}}
            <p style="color: #059669; font-size: 14px;">
                ✓ Auto-pay is enabled. This invoice will be automatically charged to your default payment method.
            </p>
            {{else}}
            <p style="color: #dc2626; font-size: 14px;">
                Please ensure payment is made by the due date to avoid service interruption.
            </p>
            {{/if}}
            
            <p>If you have any questions about this invoice, please don't hesitate to contact our support team.</p>
            
            <p>Best regards,<br>The {{companyName}} Team</p>
        </div>
        
        <div class="footer">
            <p>{{companyName}} • {{companyAddress}}</p>
            <p>
                <a href="{{billingPortalUrl}}">Billing Portal</a> • 
                <a href="{{supportUrl}}">Support</a> • 
                <a href="{{unsubscribeUrl}}">Email Preferences</a>
            </p>
        </div>
    </div>
</body>
</html>

