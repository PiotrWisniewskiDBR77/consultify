<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Confirmation</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #0F172A; margin: 0; padding: 0; background-color: #f5f5f7; }
        .container { max-width: 600px; margin: 0 auto; background: #ffffff; }
        .header { background: linear-gradient(135deg, #059669 0%, #047857 100%); padding: 40px 30px; text-align: center; }
        .header h1 { color: #ffffff; margin: 0; font-size: 24px; font-weight: 600; }
        .header .checkmark { font-size: 48px; margin-bottom: 16px; }
        .content { padding: 40px 30px; }
        .payment-box { background: #ecfdf5; border-radius: 12px; padding: 24px; margin: 20px 0; border: 1px solid #a7f3d0; text-align: center; }
        .payment-amount { font-size: 36px; font-weight: 700; color: #059669; }
        .payment-status { font-size: 14px; color: #047857; margin-top: 8px; font-weight: 600; }
        .receipt-table { width: 100%; border-collapse: collapse; margin: 20px 0; background: #f8f9fa; border-radius: 8px; overflow: hidden; }
        .receipt-table td { padding: 14px 16px; border-bottom: 1px solid #e5e7eb; }
        .receipt-table tr:last-child td { border-bottom: none; }
        .receipt-table td:first-child { color: #6b7280; }
        .receipt-table td:last-child { text-align: right; font-weight: 500; }
        .btn { display: inline-block; background: #85182F; color: #ffffff !important; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-weight: 600; margin: 10px 5px; }
        .btn-secondary { background: #ffffff; color: #85182F !important; border: 2px solid #85182F; }
        .footer { background: #f8f9fa; padding: 30px; text-align: center; font-size: 13px; color: #6b7280; }
        .footer a { color: #85182F; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="checkmark">✓</div>
            <h1>Payment Successful</h1>
        </div>
        
        <div class="content">
            <p>Hello {{recipientName}},</p>
            
            <p>Thank you for your payment! We've successfully processed your transaction.</p>
            
            <div class="payment-box">
                <div class="payment-amount">{{currency}} {{amount}}</div>
                <div class="payment-status">PAID</div>
            </div>
            
            <table class="receipt-table">
                <tr>
                    <td>Invoice Number</td>
                    <td>#{{invoiceNumber}}</td>
                </tr>
                <tr>
                    <td>Payment Date</td>
                    <td>{{paymentDate}}</td>
                </tr>
                <tr>
                    <td>Payment Method</td>
                    <td>{{paymentMethod}}</td>
                </tr>
                {{#if transactionId}}
                <tr>
                    <td>Transaction ID</td>
                    <td>{{transactionId}}</td>
                </tr>
                {{/if}}
                {{#if planName}}
                <tr>
                    <td>Plan</td>
                    <td>{{planName}}</td>
                </tr>
                {{/if}}
                {{#if nextBillingDate}}
                <tr>
                    <td>Next Billing Date</td>
                    <td>{{nextBillingDate}}</td>
                </tr>
                {{/if}}
            </table>
            
            <p style="text-align: center;">
                <a href="{{receiptUrl}}" class="btn">Download Receipt</a>
                <a href="{{billingPortalUrl}}" class="btn btn-secondary">Billing Portal</a>
            </p>
            
            <p>Your subscription is active and all features are available. If you have any questions, our support team is here to help.</p>
            
            <p>Thank you for being a valued customer!</p>
            
            <p>Best regards,<br>The {{companyName}} Team</p>
        </div>
        
        <div class="footer">
            <p>{{companyName}} • {{companyAddress}}</p>
            <p>
                <a href="{{billingPortalUrl}}">Billing Portal</a> • 
                <a href="{{supportUrl}}">Support</a> • 
                <a href="{{unsubscribeUrl}}">Email Preferences</a>
            </p>
        </div>
    </div>
</body>
</html>

