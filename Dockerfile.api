ENV VITE_TRUST_BADGE_CITATION_DOMAIN=${VITE_TRUST_BADGE_CITATION_DOMAIN}
ENV VITE_TRUST_BADGE_CITATION_LINKS=${VITE_TRUST_BADGE_CITATION_LINKS}
