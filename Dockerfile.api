ENV VITE_VF1_INSIGHT_CARD_CONTRACT=${VITE_VF1_INSIGHT_CARD_CONTRACT}
ENV VITE_VF1_INSIGHT_SPECA=${VITE_VF1_INSIGHT_SPECA}
