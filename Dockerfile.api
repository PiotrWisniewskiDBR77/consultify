# Consultify Combined Backend + Frontend Dockerfile
# Production-optimized build for Railway deployment (single service)

# ==========================================
# STAGE 1: Dependencies
# ==========================================
FROM node:20-alpine AS deps
WORKDIR /app

# Install security updates
RUN apk update && apk upgrade --no-cache

# Copy package files
COPY package.json package-lock.json ./
COPY server/package.json server/package-lock.json ./server/

# Install dependencies (ignore scripts as they're not needed in Docker builds)
# Use npm ci for deterministic builds, fallback to npm install if lock file is out of sync
RUN npm ci --omit=dev --ignore-scripts || (echo "Lock file out of sync, updating..." && npm install --omit=dev --ignore-scripts)
RUN cd server && npm ci --omit=dev --ignore-scripts || (echo "Server lock file out of sync, updating..." && cd server && npm install --omit=dev --ignore-scripts)

# ==========================================
# STAGE 2: Frontend Builder
# ==========================================
FROM node:20-alpine AS frontend-builder
WORKDIR /app

# Copy package files and workspace structure for npm workspaces
COPY package.json package-lock.json ./
COPY packages/ ./packages/
# Use npm ci for deterministic builds, fallback to npm install if lock file is out of sync
# Ignore scripts (like husky) as they're not needed in Docker builds
RUN npm ci --ignore-scripts || (echo "Lock file out of sync, updating..." && npm install --ignore-scripts)

# Copy remaining source and build
COPY . .
RUN npm run build

# ==========================================
# STAGE 3: Backend Builder
# ==========================================
FROM node:20-alpine AS backend-builder
WORKDIR /app

# Copy root package files first (server dependencies are in root package.json due to monorepo/workspace setup)
COPY package.json package-lock.json ./
# Copy server package.json - some dependencies like cookie-parser are only in server/package.json
COPY server/package.json ./server-package.json
# Install dependencies from root package.json (includes most server runtime dependencies)
# Install devDependencies too since we need TypeScript and type definitions for the build
# Use npm ci for deterministic builds, fallback to npm install if lock file is out of sync
# Ignore scripts (like husky) as they're not needed in Docker builds
RUN npm ci --ignore-scripts || (echo "Lock file out of sync, updating..." && npm install --ignore-scripts)
# Install server-specific dependencies that aren't in root package.json (e.g., cookie-parser)
# Install them at root level so TypeScript can find them during compilation
RUN npm install --save --ignore-scripts cookie-parser@^1.4.7 @types/cookie-parser@^1.4.10 || true

# Copy TypeScript config files explicitly (needed for build)
COPY server/tsconfig.json ./
# Copy all server files first (tsconfig.build.json should be included)
COPY server/ .
# Create tsconfig.build.json if it doesn't exist (fallback for git-untracked files)
RUN if [ ! -f tsconfig.build.json ]; then \
      echo '{"extends":"./tsconfig.json","compilerOptions":{"noUnusedLocals":false,"noUnusedParameters":false,"noImplicitReturns":false,"noImplicitAny":false,"strictNullChecks":false,"strictFunctionTypes":false,"strictBindCallApply":false,"strictPropertyInitialization":false,"noImplicitThis":false,"skipLibCheck":true}}' > tsconfig.build.json; \
    fi
# Verify tsconfig.build.json exists before building
RUN test -f tsconfig.build.json || (echo "ERROR: tsconfig.build.json not found!" && ls -la tsconfig*.json && exit 1)
# Build TypeScript - use --build flag with tsconfig.build.json to ensure proper compilation
# Use node_modules/.bin/tsc to ensure we use the locally installed TypeScript
RUN ./node_modules/.bin/tsc --build tsconfig.build.json || (echo "TypeScript build failed!" && exit 1)
# Verify dist directory was created
RUN test -d dist || (echo "ERROR: dist directory not created after build!" && ls -la && exit 1)

# ==========================================
# STAGE 4: Production (Backend + Frontend)
# ==========================================
FROM node:20-alpine AS api
WORKDIR /app

# Security: Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs

# Install security updates and required tools
RUN apk update && \
    apk upgrade --no-cache && \
    apk add --no-cache dumb-init curl

# Production dependencies will be copied later

# Copy built frontend (at /app/dist)
# Backend code serves from: path.join(__dirname, '../dist')
# Structure: backend at /app/server/index.js, frontend at /app/dist
# So: path.join('/app/server', '../dist') = /app/dist ✓
COPY --from=frontend-builder /app/dist /app/dist

# Copy built backend (server code) to /app/server/
# Backend compiled output goes directly to /app/server/ (not /app/server/dist/)
RUN mkdir -p /app/server
# Copy dist directory contents - copy the directory first, then move contents
# This handles the case where dist might be empty or have subdirectories
COPY --from=backend-builder /app/dist /app/server/dist-temp
RUN if [ -d /app/server/dist-temp ]; then \
      cp -r /app/server/dist-temp/. /app/server/ && \
      rm -rf /app/server/dist-temp; \
    else \
      echo "ERROR: dist directory not found in backend-builder stage!" && exit 1; \
    fi
COPY --from=backend-builder /app/package.json /app/server/
COPY --from=deps /app/server/node_modules /app/server/node_modules

WORKDIR /app/server

# Set ownership
RUN chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

# Environment
ENV NODE_ENV=production
ENV PORT=3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3001/api/health || exit 1

# Expose port
EXPOSE 3001

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]
# Backend is at /app/server/index.js, frontend at /app/dist
# Backend code: path.join(__dirname, '../dist') from /app/server = /app/dist ✓
CMD ["node", "index.js"]
