ENV VITE_TRUST_BADGE_COPY_REASONING=${VITE_TRUST_BADGE_COPY_REASONING}
ENV VITE_TRUST_BADGE_HUMANIZE_MODEL=${VITE_TRUST_BADGE_HUMANIZE_MODEL}
ENV VITE_TRUST_BADGE_REASONING=${VITE_TRUST_BADGE_REASONING}
ENV VITE_UNIFIED_CREATE_LAUNCHER_ENABLED=${VITE_UNIFIED_CREATE_LAUNCHER_ENABLED}
ENV VITE_VF1_CANVAS_SPECA=${VITE_VF1_CANVAS_SPECA}
ENV VITE_VF1_DECISION_CARD_CONTRACT=${VITE_VF1_DECISION_CARD_CONTRACT}
ENV VITE_VF1_DECISION_SPECA=${VITE_VF1_DECISION_SPECA}
ENV VITE_VF1_DECK_SPECA=${VITE_VF1_DECK_SPECA}
ENV VITE_VF1_IDEATABLE_SPECA=${VITE_VF1_IDEATABLE_SPECA}
ENV VITE_VF1_INITIATIVE_CARD_CONTRACT=${VITE_VF1_INITIATIVE_CARD_CONTRACT}
